<!DOCTYPE html>
<html lang="id">
<head>
 <meta charset="UTF-8">
 <meta name="viewport" content="width=device-width, initial-scale=1.0">
 <title>Sign In - RT 04 RW 18 Kota Baru Arjasari</title>
 <link rel="shortcut icon" href="/images/Logo%20aplikasi%20KBA%200418.png" type="image/x-icon">
 
 <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
 <script src="https://cdn.tailwindcss.com"></script>
 <script>
 tailwind.config = {
 theme: {
 extend: {
 colors: {
 brand: {
 50: '#003274ff', 100: '#002a61ff', 200: '#003274ff',
 300: '#93c5fd', 400: '#60a5fa', 500: '#3b82f6',
 600: '#2563eb', 700: '#1d4ed8', 800: '#1e40af', 900: '#1e3a8a',
 }
 },
 fontFamily: {
 sans: ['Inter', 'sans-serif'],
 display: ['Inter', 'sans-serif'],
 }
 }
 }
 }
 </script>
 <script src="https://unpkg.com/lucide@latest"></script>
</head>
<body class="font-sans text-slate-900 bg-slate-50 min-h-screen flex items-center justify-center p-6 relative overflow-hidden">
 
 <!-- Decorative background elements -->
 <div class="absolute top-0 left-0 w-full h-96 bg-brand-600 skew-y-[-6deg] -translate-y-32 z-0"></div>
 <div class="absolute bottom-0 right-0 w-96 h-96 bg-brand-100 rounded-full mix-blend-multiply opacity-50 filter blur-3xl z-0"></div>

 <!-- CENTERED LOGIN CARD CONTAINER -->
 <div class="w-full max-w-md relative z-10">
 <!-- Brand -->
 <div class="flex flex-col items-center justify-center mb-8 text-white">
 <div class="w-16 h-16 bg-white rounded-2xl flex items-center justify-center shadow-lg mb-4 p-1.5 border border-slate-100/10">
 <img src="/images/Logo%20aplikasi%20KBA%200418.png" alt="Logo KBA 0418" class="w-14 h-14 object-contain rounded-xl">
 </div>
 <h1 class="text-brand-50 font-display font-bold text-2xl tracking-tight">RT 04 RW 18</h1>
 <p class="text-brand-100 text-sm font-medium tracking-wide">Kota Baru Arjasari</p>
 </div>

 <!-- CARD -->
 <div class="bg-white rounded-3xl p-8 shadow-xl border border-slate-100">
 
 <!-- HEADER -->
 <div class="text-center mb-8">
 <h2 class="text-2xl font-bold text-slate-900 mb-1">Selamat Datang</h2>
 <p class="text-slate-500 text-sm">Masuk ke Portal Warga RT 04 RW 18</p>
 </div>

 <!-- Flash Messages -->
 <% if (typeof error !== 'undefined' && error && error.length > 0) { %>
 <div class="mb-6 p-4 rounded-xl bg-red-50 border border-red-100 text-red-600 text-sm flex gap-3 items-start">
 <i data-lucide="alert-circle" class="w-5 h-5 flex-shrink-0 mt-0.5"></i>
 <p><%= error %></p>
 </div>
 <% } %>
 
 <% if (typeof success !== 'undefined' && success && success.length > 0) { %>
 <div class="mb-6 p-4 rounded-xl bg-emerald-50 border border-emerald-100 text-emerald-600 text-sm flex gap-3 items-start">
 <i data-lucide="check-circle" class="w-5 h-5 flex-shrink-0 mt-0.5"></i>
 <p><%= success %></p>
 </div>
 <% } %>

 <!-- FORM -->
 <form method="POST" class="space-y-5">
 <% if (typeof csrfToken !== 'undefined') { %>
 <input type="hidden" name="_csrf" value="<%= csrfToken %>">
 <% } %>
 
 <div class="space-y-1.5">
 <label for="phone" class="block text-sm font-semibold text-slate-700">Nomor HP</label>
 <div class="relative">
 <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
 <i data-lucide="phone" class="h-5 w-5 text-slate-400"></i>
 </div>
 <input
 type="text"
 id="phone"
 name="phone"
 required
 autofocus
 placeholder="08123456789"
 class="block w-full pl-10 pr-3 py-2.5 border border-slate-300 rounded-xl focus:ring-2 focus:ring-brand-500 focus:border-brand-500 text-sm transition-shadow"
 />
 </div>
 </div>

 <div class="space-y-1.5">
 <div class="flex items-center justify-between">
 <label for="password" class="block text-sm font-semibold text-slate-700">Password</label>
 </div>
 <div class="relative">
 <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
 <i data-lucide="lock" class="h-5 w-5 text-slate-400"></i>
 </div>
 <input
 type="password"
 id="password"
 name="password"
 required
 placeholder="Masukkan password Anda"
 class="block w-full pl-10 pr-3 py-2.5 border border-slate-300 rounded-xl focus:ring-2 focus:ring-brand-500 focus:border-brand-500 text-sm transition-shadow"
 />
 </div>
 </div>

 <button
 type="submit"
 class="w-full flex justify-center py-2.5 px-4 border border-transparent rounded-xl shadow-sm text-sm font-bold text-white bg-brand-600 hover:bg-brand-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-brand-500 transition-colors"
 >
 Masuk
 </button>
 </form>

 <!-- FOOTER -->
 <div class="mt-8 text-center border-t border-slate-100 pt-6">
 <p class="text-sm text-slate-500">
 Belum punya akun? <br>
 <span class="text-slate-900 font-medium mt-1 inline-block">Hubungi Pengurus RT 04 RW 18 untuk akses</span>
 </p>
 </div>
 </div>
 
 <div class="mt-8 text-center text-sm text-slate-500">
 <a href="/" class="hover:text-brand-600 transition-colors">← Kembali ke Beranda</a>
 </div>

 </div>

 <script>
 lucide.createIcons();
 </script>
</body>
</html>
