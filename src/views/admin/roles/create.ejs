<%- include('../_sidebar.ejs', { currentPage: 'roles' }) %>

 <main class="admin-main flex flex-col">
 <!-- TOP HEADER -->
 <header class="h-20 bg-white border-b border-slate-200 flex items-center justify-between px-6 flex-shrink-0 sticky top-0 z-40">
 <div class="flex items-center gap-4">
 <h2 class="font-display font-bold text-xl"><%= typeof title !== 'undefined' ? title : 'Admin Panel' %></h2>
 </div>

 <div class="flex items-center gap-4">
 <a href="/admin/messages" class="p-2 text-slate-500 hover:bg-slate-100 rounded-full transition-colors relative">
 <i data-lucide="bell" class="w-5 h-5"></i>
 <% if (typeof unreadMessages !== 'undefined' && unreadMessages > 0) { %>
 <span class="absolute top-2 right-2 w-2 h-2 bg-red-500 rounded-full border-2 border-white"></span>
 <% } %>
 </a>
 <div class="h-8 w-px bg-slate-200 mx-1"></div>
 <div class="flex items-center gap-2">
 <% if (typeof user !== 'undefined' && user && user.name) { %>
 <div class="w-8 h-8 rounded-full bg-brand-100 border border-slate-200 flex items-center justify-center text-brand-700 font-bold text-sm">
 <%= user.name.charAt(0).toUpperCase() %>
 </div>
 <span class="text-sm font-semibold hidden lg:block"><%= user.name %></span>
 <% } %>
 </div>
 </div>
 </header>
 <div class="p-6 lg:p-8 flex-1 overflow-y-auto">

 <div class="page-header">
 <h1>+ Create New Role</h1>
 <a href="/admin/roles" class="btn btn-secondary">← Back to Roles</a>
 </div>

 <% if (error) { %>
 <div class="alert alert-error"><%= error %></div>
 <% } %>

 <div style="max-width:480px;">
 <div class="card" style="margin-bottom:1.5rem;">
 <form method="POST" action="/admin/roles" style="display:flex;flex-direction:column;gap:0;">

 <div class="form-group">
 <label for="name">Role Name</label>
 <input
 type="text"
 id="name"
 name="name"
 required
 autofocus
 placeholder="e.g., ketua_rw, bendahara"
 style="font-family:monospace;"
 >
 <p style="font-size:0.8rem;color:var(--gray-600);margin-top:0.375rem;margin-bottom:0;">
 Lowercase letters, numbers, and underscores only. Example: <code>ketua_rw</code>
 </p>
 </div>

 <div class="form-actions" style="margin-top:1.25rem;">
 <button type="submit" class="btn btn-primary" style="flex:1;">Create Role</button>
 <a href="/admin/roles" class="btn btn-secondary" style="flex:1;text-align:center;">Cancel</a>
 </div>
 </form>
 </div>

 <div class="info-box">
 <strong> Note:</strong> Setelah role dibuat, buka halaman detail role untuk men-assign permissions yang dibutuhkan.
 </div>
 </div>

 </div>
 </main>
</div>
</body>
</html>

