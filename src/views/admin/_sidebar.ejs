<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : 'Admin' %> - RT Management System</title>
  <link rel="stylesheet" href="/css/admin.css">
</head>
<body>
<!-- ADMIN LAYOUT WRAPPER -->
<div class="admin-wrapper">

  <!-- SIDEBAR (FIXED LEFT) -->
  <aside class="admin-sidebar">
    <!-- SIDEBAR HEADER -->
    <div class="admin-sidebar-header">
      <h2>RT Management</h2>
      <p>Admin Panel</p>
    </div>

    <!-- SIDEBAR MENU -->
    <nav class="admin-sidebar-nav">
      <!-- DASHBOARD -->
      <a href="/admin" class="<%= currentPage === 'dashboard' ? 'active' : '' %>">
        <span class="nav-icon">📊</span>
        Dashboard
      </a>

      <!-- WARGA -->
      <a href="/admin/users" class="<%= currentPage === 'users' ? 'active' : '' %>">
        <span class="nav-icon">👥</span>
        Warga
      </a>

      <!-- ROLE & PERMISSION -->
      <a href="/admin/roles" class="<%= currentPage === 'roles' ? 'active' : '' %>">
        <span class="nav-icon">🔐</span>
        Role & Permission
      </a>

      <!-- MESSAGES -->
      <a href="/admin/messages" class="<%= currentPage === 'messages' ? 'active' : '' %>">
        <span class="nav-icon">📨</span>
        Messages
      </a>
    </nav>

    <!-- SIDEBAR FOOTER (PORTAL & LOGOUT) -->
    <div style="margin-top:auto;padding:1.5rem;display:flex;flex-direction:column;gap:0.5rem;">
      <a href="/portal" style="display:flex;align-items:center;gap:0.75rem;color:var(--gray-700);text-decoration:none;font-weight:500;padding:0.75rem 1rem;border-radius:6px;transition:background 0.2s;" onmouseover="this.style.background='var(--gray-100)'" onmouseout="this.style.background='transparent'">
        <span class="nav-icon">🏠</span>
        Go to Portal
      </a>
      <a href="/auth/logout" style="display:flex;align-items:center;gap:0.75rem;color:var(--error);text-decoration:none;font-weight:500;padding:0.75rem 1rem;border-radius:6px;transition:background 0.2s;" onmouseover="this.style.background='#FEE2E2'" onmouseout="this.style.background='transparent'">
        <span class="nav-icon">🚪</span>
        Logout
      </a>
    </div>
  </aside>

