<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : 'Admin' %> - RT Management System</title>
  <link rel="stylesheet" href="/css/admin.css">
</head>
<body>
<!-- ADMIN LAYOUT WRAPPER -->
<div class="admin-wrapper">

  <!-- SIDEBAR (FIXED LEFT) -->
  <aside class="admin-sidebar">
    <!-- SIDEBAR HEADER -->
    <div class="admin-sidebar-header">
      <h2>RT Management</h2>
      <p>Admin Panel</p>
    </div>

    <!-- SIDEBAR MENU -->
    <nav class="admin-sidebar-nav">
      <!-- DASHBOARD -->
      <% if (userPermissions && userPermissions.includes('dashboard.view')) { %>
      <a href="/admin" class="<%= currentPage === 'dashboard' ? 'active' : '' %>">
        <span class="nav-icon">📊</span>
        Dashboard
      </a>
      <% } %>

      <!-- WARGA -->
      <% if (userPermissions && userPermissions.includes('warga.read')) { %>
      <a href="/admin/users" class="<%= currentPage === 'users' ? 'active' : '' %>">
        <span class="nav-icon">👥</span>
        Warga
      </a>
      <% } %>

      <!-- ROLE & PERMISSION -->
      <% if (userPermissions && userPermissions.includes('role.manage')) { %>
      <a href="/admin/roles" class="<%= currentPage === 'roles' ? 'active' : '' %>">
        <span class="nav-icon">🔐</span>
        Role & Permission
      </a>
      <% } %>

      <!-- MESSAGES -->
      <% if (userPermissions && userPermissions.includes('message.read')) { %>
      <a href="/admin/messages" class="<%= currentPage === 'messages' ? 'active' : '' %>">
        <span class="nav-icon">📨</span>
        Messages
      </a>
      <% } %>

      <!-- DOCUMENTS -->
      <% if (userPermissions && userPermissions.includes('document.manage')) { %>
      <a href="/admin/documents" class="<%= currentPage === 'documents' ? 'active' : '' %>">
        <span class="nav-icon">📄</span>
        Dokumen
      </a>
      <% } %>

      <!-- FINANCE -->
      <% if (userPermissions && userPermissions.includes('finance.manage')) { %>
      <a href="/admin/finance" class="<%= typeof currentPage !== 'undefined' && currentPage === 'finance' ? 'active' : '' %>">
        <span class="nav-icon">💰</span>
        Keuangan
      </a>
      <% } %>

      <!-- SETTINGS -->
      <% if (userPermissions && userPermissions.includes('setting.manage')) { %>
      <a href="/admin/settings" class="<%= typeof currentPage !== 'undefined' && currentPage === 'settings' ? 'active' : '' %>">
        <span class="nav-icon">⚙️</span>
        Pengaturan
      </a>
      <% } %>
    </nav>

    <!-- SIDEBAR FOOTER (PORTAL & LOGOUT) -->
    <div style="margin-top:auto;padding:1.5rem;display:flex;flex-direction:column;gap:0.5rem;">
      <a href="/portal" style="display:flex;align-items:center;gap:0.75rem;color:var(--gray-700);text-decoration:none;font-weight:500;padding:0.75rem 1rem;border-radius:6px;transition:background 0.2s;" onmouseover="this.style.background='var(--gray-100)'" onmouseout="this.style.background='transparent'">
        <span class="nav-icon">🏠</span>
        Go to Portal
      </a>
      <a href="/auth/logout" style="display:flex;align-items:center;gap:0.75rem;color:var(--error);text-decoration:none;font-weight:500;padding:0.75rem 1rem;border-radius:6px;transition:background 0.2s;" onmouseover="this.style.background='#FEE2E2'" onmouseout="this.style.background='transparent'">
        <span class="nav-icon">🚪</span>
        Logout
      </a>
    </div>
  </aside>

