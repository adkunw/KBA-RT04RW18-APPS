<!DOCTYPE html>
<html lang="id">
<head>
 <meta charset="UTF-8">
 <meta name="viewport" content="width=device-width, initial-scale=1.0">
 <title><%= typeof title !== 'undefined' ? title : 'Admin' %> - RT Management System</title>
 <link rel="shortcut icon" href="/images/Logo%20aplikasi%20KBA%200418.png" type="image/x-icon">
 
 <!-- Fonts -->
 <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
 
 <!-- Tailwind CSS -->
 <script src="https://cdn.tailwindcss.com"></script>
 <script>
 tailwind.config = {
 theme: {
 extend: {
 colors: {
 brand: {
 50: '#eff6ff', 100: '#dbeafe', 200: '#bfdbfe',
 300: '#93c5fd', 400: '#60a5fa', 500: '#3b82f6',
 600: '#2563eb', 700: '#1d4ed8', 800: '#1e40af', 900: '#1e3a8a',
 }
 },
 fontFamily: {
 sans: ['Inter', 'sans-serif'],
 display: ['Inter', 'sans-serif'],
 }
 }
 }
 }
 </script>
 
 <!-- Lucide Icons -->
 <script src="https://unpkg.com/lucide@latest"></script>
 <script>
 document.addEventListener("DOMContentLoaded", function() {
 if (typeof lucide !== 'undefined') {
 lucide.createIcons();
 }
 });
 </script>

 <link rel="stylesheet" href="/css/admin.css">
 <style>
 /* Override old sidebar styles to use Tailwind */
 .admin-wrapper {
 display: flex;
 height: 100vh;
 overflow: hidden;
 background-color: #f8fafc; /* bg-slate-50 */
 }
 .admin-sidebar {
 position: static;
 width: 280px;
 height: 100vh;
 box-shadow: none;
 flex-shrink: 0;
 }
 .admin-main {
 margin-left: 0;
 flex: 1;
 height: 100vh;
 overflow-y: auto;
 padding: 0;
 }
 
 /* Transition for sidebar items */
 .sidebar-link {
 transition: all 0.2s ease;
 }
 .sidebar-link.active {
 background-color: #eff6ff; /* brand-50 */
 color: #2563eb; /* brand-600 */
 font-weight: 600;
 }
 .sidebar-link:not(.active):hover {
 background-color: #f8fafc; /* slate-50 */
 color: #0f172a; /* slate-900 */
 }

 /* Responsive Sidebar Drawer */
 @media (max-width: 1023px) {
  .admin-sidebar {
   position: fixed !important;
   top: 0;
   left: 0;
   bottom: 0;
   z-index: 50;
   transform: translateX(-100%);
   transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
   box-shadow: 10px 0 30px rgba(0, 0, 0, 0.08) !important;
  }
  .admin-sidebar.show {
   transform: translateX(0);
  }
  .admin-backdrop {
   display: none;
   position: fixed;
   inset: 0;
   background-color: rgba(15, 23, 42, 0.4);
   backdrop-filter: blur(4px);
   z-index: 40;
  }
  .admin-backdrop.show {
   display: block;
  }
 }
 </style>
</head>
<body class="font-sans text-slate-900 bg-slate-50">
<!-- ADMIN LAYOUT WRAPPER -->
<div class="admin-wrapper">

 <!-- SIDEBAR (FIXED LEFT) -->
 <aside class="admin-sidebar bg-white border-r border-slate-200 flex flex-col relative z-50 overflow-hidden">
 <!-- SIDEBAR HEADER -->
 <div class="p-6 h-20 flex items-center justify-between gap-3 border-b border-slate-100">
 <div class="flex items-center gap-3">
 <img src="/images/Logo%20aplikasi%20KBA%200418.png" alt="Logo KBA 0418" class="w-10 h-10 object-contain rounded-lg shadow-md border border-slate-100 bg-white flex-shrink-0">
 <div class="overflow-hidden">
 <h1 class="font-display font-bold text-lg whitespace-nowrap leading-tight">RT 04 RW 18</h1>
 <p class="text-[10px] text-slate-400 font-bold tracking-widest uppercase">Arjasari Admin</p>
 </div>
 </div>
 <!-- Mobile Close Button -->
 <button onclick="window.toggleSidebar()" class="lg:hidden p-2 text-slate-400 hover:text-slate-650 hover:bg-slate-100 rounded-xl transition-colors">
 <i data-lucide="x" class="w-5 h-5"></i>
 </button>
 </div>

 <!-- SIDEBAR MENU -->
 <nav class="flex-1 p-4 space-y-1 overflow-y-auto">
 <!-- DASHBOARD -->
 <% if (typeof userPermissions !== 'undefined' && userPermissions.includes('dashboard.view')) { %>
 <a href="/admin" class="sidebar-link w-full flex items-center justify-between p-3 rounded-xl font-medium text-slate-500 <%= currentPage === 'dashboard' ? 'active' : '' %>">
 <div class="flex items-center gap-3">
 <i data-lucide="layout-dashboard" class="w-5 h-5"></i>
 <span class="text-sm">Dashboard</span>
 </div>
 </a>
 <% } %>

 <!-- WARGA -->
 <% if (typeof userPermissions !== 'undefined' && userPermissions.includes('warga.read')) { %>
 <a href="/admin/users" class="sidebar-link w-full flex items-center justify-between p-3 rounded-xl font-medium text-slate-500 <%= currentPage === 'users' ? 'active' : '' %>">
 <div class="flex items-center gap-3">
 <i data-lucide="users" class="w-5 h-5"></i>
 <span class="text-sm">Warga</span>
 </div>
 </a>
 <% } %>

 <!-- ROLE & PERMISSION -->
 <% if (typeof userPermissions !== 'undefined' && userPermissions.includes('role.manage')) { %>
 <a href="/admin/roles" class="sidebar-link w-full flex items-center justify-between p-3 rounded-xl font-medium text-slate-500 <%= currentPage === 'roles' ? 'active' : '' %>">
 <div class="flex items-center gap-3">
 <i data-lucide="shield" class="w-5 h-5"></i>
 <span class="text-sm">Role & Permission</span>
 </div>
 </a>
 <% } %>

 <!-- MESSAGES -->
 <% if (typeof userPermissions !== 'undefined' && userPermissions.includes('message.read')) { %>
 <a href="/admin/messages" class="sidebar-link w-full flex items-center justify-between p-3 rounded-xl font-medium text-slate-500 <%= currentPage === 'messages' ? 'active' : '' %>">
 <div class="flex items-center gap-3">
 <i data-lucide="message-square" class="w-5 h-5"></i>
 <span class="text-sm">Messages</span>
 </div>
 <% if (typeof unreadMessages !== 'undefined' && unreadMessages > 0) { %>
 <span class="bg-brand-600 text-white text-[10px] font-bold px-2 py-0.5 rounded-full"><%= unreadMessages %></span>
 <% } %>
 </a>
 <% } %>

 <!-- DOCUMENTS -->
 <% if (typeof userPermissions !== 'undefined' && userPermissions.includes('document.manage')) { %>
 <a href="/admin/documents" class="sidebar-link w-full flex items-center justify-between p-3 rounded-xl font-medium text-slate-500 <%= currentPage === 'documents' ? 'active' : '' %>">
 <div class="flex items-center gap-3">
 <i data-lucide="file-text" class="w-5 h-5"></i>
 <span class="text-sm">Dokumen</span>
 </div>
 </a>
 <% } %>

 <!-- FINANCE -->
 <% if (typeof userPermissions !== 'undefined' && userPermissions.includes('finance.manage')) { %>
 <a href="/admin/finance" class="sidebar-link w-full flex items-center justify-between p-3 rounded-xl font-medium text-slate-500 <%= typeof currentPage !== 'undefined' && currentPage === 'finance' ? 'active' : '' %>">
 <div class="flex items-center gap-3">
 <i data-lucide="wallet" class="w-5 h-5"></i>
 <span class="text-sm">Keuangan</span>
 </div>
 </a>
 <% } %>

 <!-- SETTINGS -->
 <% if (typeof userPermissions !== 'undefined' && userPermissions.includes('setting.manage')) { %>
 <a href="/admin/settings" class="sidebar-link w-full flex items-center justify-between p-3 rounded-xl font-medium text-slate-500 <%= typeof currentPage !== 'undefined' && currentPage === 'settings' ? 'active' : '' %>">
 <div class="flex items-center gap-3">
 <i data-lucide="settings" class="w-5 h-5"></i>
 <span class="text-sm">Pengaturan</span>
 </div>
 </a>
 <% } %>

 <!-- ERROR LOGS -->
 <% if (typeof userPermissions !== 'undefined' && userPermissions.includes('error_log.read')) { %>
 <a href="/admin/error-logs" class="sidebar-link w-full flex items-center justify-between p-3 rounded-xl font-medium text-slate-500 <%= typeof currentPage !== 'undefined' && currentPage === 'error-logs' ? 'active' : '' %>">
 <div class="flex items-center gap-3">
 <i data-lucide="terminal" class="w-5 h-5"></i>
 <span class="text-sm">Log Error</span>
 </div>
 </a>
 <% } %>
 </nav>

 <!-- SIDEBAR FOOTER (PORTAL & LOGOUT) -->
 <div class="p-4 border-t border-slate-100 space-y-1">
 <a href="/portal" class="sidebar-link w-full flex items-center justify-between p-3 rounded-xl font-medium text-slate-500">
 <div class="flex items-center gap-3">
 <i data-lucide="home" class="w-5 h-5"></i>
 <span class="text-sm">Go to Portal</span>
 </div>
 </a>
 <a href="/auth/logout" class="w-full flex items-center justify-between p-3 rounded-xl font-medium text-rose-500 hover:bg-rose-50 hover:text-rose-600 transition-colors">
 <div class="flex items-center gap-3">
 <i data-lucide="log-out" class="w-5 h-5"></i>
 <span class="text-sm">Logout</span>
 </div>
 </a>
 </div>
 </aside>

 <!-- Responsive Sidebar Drawer Logic -->
 <script>
   document.addEventListener("DOMContentLoaded", function() {
     const sidebar = document.querySelector(".admin-sidebar");
     
     // Create backdrop if it doesn't exist on mobile
     let backdrop = document.querySelector(".admin-backdrop");
     if (!backdrop) {
       backdrop = document.createElement("div");
       backdrop.className = "admin-backdrop";
       document.body.appendChild(backdrop);
     }

     // Toggle Sidebar Function
     window.toggleSidebar = function() {
       if (sidebar) sidebar.classList.toggle("show");
       if (backdrop) backdrop.classList.toggle("show");
     };

     // Close sidebar on backdrop click
     backdrop.addEventListener("click", function() {
       if (sidebar) sidebar.classList.remove("show");
       if (backdrop) backdrop.classList.remove("show");
     });

     // Dynamically prepend hamburger menu to main headers on mobile screens
     const mainHeader = document.querySelector(".admin-main > header");
     if (mainHeader) {
       const leftContainer = mainHeader.querySelector("div.flex.items-center");
       if (leftContainer) {
         // Create Hamburger Button
         const menuBtn = document.createElement("button");
         menuBtn.type = "button";
         menuBtn.className = "lg:hidden p-2 text-slate-500 hover:bg-slate-100 rounded-xl transition-colors mr-2 flex-shrink-0 flex items-center justify-center";
         menuBtn.innerHTML = '<i data-lucide="menu" class="w-6 h-6"></i>';
         menuBtn.addEventListener("click", window.toggleSidebar);
         
         // Prepend before title
         leftContainer.insertBefore(menuBtn, leftContainer.firstChild);
         
         // Refresh lucide icons
         if (typeof lucide !== 'undefined') {
           lucide.createIcons();
         }
       }
     }
   });
 </script>

