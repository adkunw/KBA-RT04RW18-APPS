<%- include('../_sidebar.ejs', { currentPage: 'tutorial' }) %>

<!-- MAIN CONTENT -->
<main class="admin-main flex flex-col">
  <!-- TOP HEADER -->
  <header class="h-20 bg-white border-b border-slate-200 flex items-center justify-between px-6 flex-shrink-0 sticky top-0 z-40">
    <div class="flex items-center gap-4">
      <button onclick="window.toggleSidebar()" class="lg:hidden p-2 text-slate-400 hover:text-slate-600 hover:bg-slate-100 rounded-xl transition-colors">
        <i data-lucide="menu" class="w-5 h-5"></i>
      </button>
      <div>
        <h2 class="font-display font-bold text-xl text-slate-900">Buku Panduan Admin & Pengurus</h2>
        <p class="text-xs text-slate-500 hidden sm:block">Panduan operasional fitur sistem RT Connect berdasarkan hak akses Anda</p>
      </div>
    </div>

    <div class="flex items-center gap-4">
      <a href="/portal" class="inline-flex items-center gap-1.5 text-xs font-semibold text-slate-600 hover:text-brand-600 bg-white border border-slate-200 px-3 py-1.5 rounded-lg transition-colors shadow-sm">
        <i data-lucide="external-link" class="w-3.5 h-3.5"></i>
        <span>Buka Portal Warga</span>
      </a>

      <div class="h-8 w-px bg-slate-200 mx-1"></div>

      <div class="flex items-center gap-2">
        <div class="w-8 h-8 rounded-full bg-brand-100 border border-slate-200 flex items-center justify-center text-brand-700 font-bold text-sm">
          <%= user.name.charAt(0).toUpperCase() %>
        </div>
        <span class="text-sm font-semibold hidden lg:block"><%= user.name %></span>
      </div>
    </div>
  </header>

  <div class="flex-1 overflow-y-auto p-6 lg:p-8">

    <!-- HERO / ACTIVE PERMISSION BANNER -->
    <div class="bg-gradient-to-r from-slate-900 via-indigo-950 to-brand-900 rounded-3xl p-6 sm:p-8 text-white relative overflow-hidden shadow-lg mb-8">
      <div class="relative z-10 max-w-3xl">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/10 text-indigo-200 text-xs font-bold border border-white/10 mb-3">
          <i data-lucide="shield" class="w-3.5 h-3.5 text-indigo-400"></i>
          <span>Akses Role: <%= user.roles && user.roles.length > 0 ? user.roles.join(', ').replace(/_/g, ' ') : 'Pengurus' %></span>
        </div>
        <h1 class="font-display text-2xl sm:text-3xl font-extrabold mb-2 text-white">
          Panduan Khusus Fitur Anda
        </h1>
        <p class="text-slate-300 text-xs sm:text-sm leading-relaxed mb-4">
          Halaman panduan ini menyesuaikan secara otomatis dengan daftar izin (*permission*) yang aktif pada akun Anda. Anda hanya akan melihat panduan untuk modul yang dapat Anda akses.
        </p>

        <!-- Permission Modules Quick Badges -->
        <div class="flex flex-wrap items-center gap-2 pt-2 border-t border-white/10">
          <span class="text-xs text-slate-400 font-semibold">Modul Aktif:</span>
          <% if (userPermissions.includes('dashboard.view')) { %>
            <span class="px-2.5 py-0.5 bg-blue-500/20 text-blue-300 border border-blue-400/30 rounded-full text-[11px] font-bold">Dashboard</span>
          <% } %>
          <% if (userPermissions.includes('warga.read') || userPermissions.includes('warga.read_corridor')) { %>
            <span class="px-2.5 py-0.5 bg-emerald-500/20 text-emerald-300 border border-emerald-400/30 rounded-full text-[11px] font-bold">Data Warga</span>
          <% } %>
          <% if (userPermissions.includes('document.manage')) { %>
            <span class="px-2.5 py-0.5 bg-teal-500/20 text-teal-300 border border-teal-400/30 rounded-full text-[11px] font-bold">Dokumen & Surat</span>
          <% } %>
          <% if (userPermissions.includes('finance.manage') || userPermissions.includes('finance.manage_corridor')) { %>
            <span class="px-2.5 py-0.5 bg-amber-500/20 text-amber-300 border border-amber-400/30 rounded-full text-[11px] font-bold">Keuangan & Kas</span>
          <% } %>
          <% if (userPermissions.includes('message.read') || userPermissions.includes('message.create')) { %>
            <span class="px-2.5 py-0.5 bg-purple-500/20 text-purple-300 border border-purple-400/30 rounded-full text-[11px] font-bold">Pesan & Pengumuman</span>
          <% } %>
          <% if (userPermissions.includes('report.manage') || userPermissions.includes('report.delete_any')) { %>
            <span class="px-2.5 py-0.5 bg-rose-500/20 text-rose-300 border border-rose-400/30 rounded-full text-[11px] font-bold">Lapor RT</span>
          <% } %>
          <% if (userPermissions.includes('role.manage')) { %>
            <span class="px-2.5 py-0.5 bg-indigo-500/20 text-indigo-300 border border-indigo-400/30 rounded-full text-[11px] font-bold">Role & Koridor</span>
          <% } %>
          <% if (userPermissions.includes('setting.manage')) { %>
            <span class="px-2.5 py-0.5 bg-slate-500/20 text-slate-300 border border-slate-400/30 rounded-full text-[11px] font-bold">Pengaturan</span>
          <% } %>
          <% if (userPermissions.includes('error_log.read')) { %>
            <span class="px-2.5 py-0.5 bg-red-500/20 text-red-300 border border-red-400/30 rounded-full text-[11px] font-bold">Log Error</span>
          <% } %>
        </div>
      </div>
      <div class="absolute top-0 right-0 w-80 h-full bg-white/5 skew-x-[-20deg] translate-x-16 pointer-events-none"></div>
    </div>

    <!-- QUICK JUMP PILLS -->
    <div class="mb-8 flex flex-wrap gap-2 sticky top-20 z-30 bg-slate-50/95 py-2 backdrop-blur border-b border-slate-200">
      <% if (userPermissions.includes('dashboard.view')) { %>
        <a href="#modul-dashboard" class="px-3 py-1.5 bg-white border border-slate-200 hover:border-brand-500 rounded-xl text-xs font-bold text-slate-700 hover:text-brand-600 transition-colors shadow-sm">
          📊 Dashboard
        </a>
      <% } %>
      <% if (userPermissions.includes('warga.read') || userPermissions.includes('warga.read_corridor')) { %>
        <a href="#modul-warga" class="px-3 py-1.5 bg-white border border-slate-200 hover:border-emerald-500 rounded-xl text-xs font-bold text-slate-700 hover:text-emerald-600 transition-colors shadow-sm">
          👥 Data Warga
        </a>
      <% } %>
      <% if (userPermissions.includes('document.manage')) { %>
        <a href="#modul-dokumen" class="px-3 py-1.5 bg-white border border-slate-200 hover:border-teal-500 rounded-xl text-xs font-bold text-slate-700 hover:text-teal-600 transition-colors shadow-sm">
          📄 Dokumen & Surat
        </a>
      <% } %>
      <% if (userPermissions.includes('finance.manage') || userPermissions.includes('finance.manage_corridor')) { %>
        <a href="#modul-keuangan" class="px-3 py-1.5 bg-white border border-slate-200 hover:border-amber-500 rounded-xl text-xs font-bold text-slate-700 hover:text-amber-600 transition-colors shadow-sm">
          💰 Keuangan & Kas
        </a>
      <% } %>
      <% if (userPermissions.includes('message.read') || userPermissions.includes('message.create')) { %>
        <a href="#modul-pesan" class="px-3 py-1.5 bg-white border border-slate-200 hover:border-purple-500 rounded-xl text-xs font-bold text-slate-700 hover:text-purple-600 transition-colors shadow-sm">
          📢 Pesan & Pengumuman
        </a>
      <% } %>
      <% if (userPermissions.includes('report.manage') || userPermissions.includes('report.delete_any')) { %>
        <a href="#modul-lapor" class="px-3 py-1.5 bg-white border border-slate-200 hover:border-rose-500 rounded-xl text-xs font-bold text-slate-700 hover:text-rose-600 transition-colors shadow-sm">
          🚨 Lapor RT
        </a>
      <% } %>
      <% if (userPermissions.includes('role.manage')) { %>
        <a href="#modul-rbac" class="px-3 py-1.5 bg-white border border-slate-200 hover:border-indigo-500 rounded-xl text-xs font-bold text-slate-700 hover:text-indigo-600 transition-colors shadow-sm">
          🛡️ Role & Koridor
        </a>
      <% } %>
      <% if (userPermissions.includes('setting.manage')) { %>
        <a href="#modul-pengaturan" class="px-3 py-1.5 bg-white border border-slate-200 hover:border-slate-500 rounded-xl text-xs font-bold text-slate-700 hover:text-slate-900 transition-colors shadow-sm">
          ⚙️ Pengaturan
        </a>
      <% } %>
      <% if (userPermissions.includes('error_log.read')) { %>
        <a href="#modul-log" class="px-3 py-1.5 bg-white border border-slate-200 hover:border-red-500 rounded-xl text-xs font-bold text-slate-700 hover:text-red-600 transition-colors shadow-sm">
          💻 Log Error
        </a>
      <% } %>
    </div>

    <!-- TUTORIAL MODULE CARDS -->
    <div class="space-y-8">

      <!-- MODUL 1: DASHBOARD -->
      <% if (userPermissions.includes('dashboard.view')) { %>
      <div id="modul-dashboard" class="bg-white rounded-3xl border border-slate-200 p-6 sm:p-8 shadow-sm scroll-mt-24">
        <div class="flex items-center gap-3.5 mb-6 pb-4 border-b border-slate-100">
          <div class="w-12 h-12 bg-blue-50 text-blue-600 rounded-2xl flex items-center justify-center flex-shrink-0">
            <i data-lucide="layout-dashboard" class="w-6 h-6"></i>
          </div>
          <div>
            <span class="text-xs font-bold text-blue-600 bg-blue-50 px-2 py-0.5 rounded-md">MODUL DASHBOARD</span>
            <h3 class="text-xl font-bold text-slate-900">Memantau Ringkasan & Statistik Wilayah RT</h3>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 text-sm text-slate-600">
          <div class="bg-slate-50 p-5 rounded-2xl border border-slate-100">
            <h4 class="font-bold text-slate-800 mb-2 flex items-center gap-2">
              <i data-lucide="users" class="w-4 h-4 text-blue-600"></i>
              Statistik Kependudukan
            </h4>
            <p class="text-xs leading-relaxed">
              Melihat total warga terdaftar, jumlah akun berstatus <strong>Active</strong> (sudah membuat password), serta akun <strong>Pending</strong> yang menunggu aktivasi.
            </p>
          </div>

          <div class="bg-slate-50 p-5 rounded-2xl border border-slate-100">
            <h4 class="font-bold text-slate-800 mb-2 flex items-center gap-2">
              <i data-lucide="activity" class="w-4 h-4 text-blue-600"></i>
              Aktivitas Warga Terbaru
            </h4>
            <p class="text-xs leading-relaxed">
              Tabel aktivitas menampilkan warga yang baru terdaftar, perubahan data profil, atau permohonan terkini untuk respon cepat.
            </p>
          </div>

          <div class="bg-slate-50 p-5 rounded-2xl border border-slate-100">
            <h4 class="font-bold text-slate-800 mb-2 flex items-center gap-2">
              <i data-lucide="bell" class="w-4 h-4 text-blue-600"></i>
              Notifikasi & Pintasan Cepat
            </h4>
            <p class="text-xs leading-relaxed">
              Ikon lonceng pada header menampilkan pesan masuk yang belum dibaca. Gunakan menu sidebar untuk berpindah modul secara instan.
            </p>
          </div>
        </div>
      </div>
      <% } %>

      <!-- MODUL 2: DATA WARGA -->
      <% if (userPermissions.includes('warga.read') || userPermissions.includes('warga.read_corridor')) { %>
      <div id="modul-warga" class="bg-white rounded-3xl border border-slate-200 p-6 sm:p-8 shadow-sm scroll-mt-24">
        <div class="flex items-center gap-3.5 mb-6 pb-4 border-b border-slate-100">
          <div class="w-12 h-12 bg-emerald-50 text-emerald-600 rounded-2xl flex items-center justify-center flex-shrink-0">
            <i data-lucide="users" class="w-6 h-6"></i>
          </div>
          <div>
            <span class="text-xs font-bold text-emerald-600 bg-emerald-50 px-2 py-0.5 rounded-md">MODUL WARGA</span>
            <h3 class="text-xl font-bold text-slate-900">Pengelolaan Data & Aktivasi Akun Warga</h3>
          </div>
        </div>

        <div class="space-y-6">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div class="border border-slate-200 rounded-2xl p-5">
              <h4 class="font-bold text-slate-800 mb-2 text-sm flex items-center gap-2">
                <span class="w-2.5 h-2.5 bg-emerald-500 rounded-full"></span>
                Alur Pendaftaran & Aktivasi Akun Warga
              </h4>
              <ol class="text-xs text-slate-600 space-y-2 list-decimal list-inside leading-relaxed">
                <li>Klik tombol <strong>+ Tambah Warga</strong> di halaman Warga.</li>
                <li>Isi Nama Lengkap, Nomor HP/WhatsApp (sebagai ID login), Nomor Rumah, dan pilih Koridor tempat tinggal.</li>
                <li>Setelah disimpan, akun akan berstatus <strong class="text-amber-600">created</strong>.</li>
                <li>Klik tombol <strong>Copy Link Aktivasi</strong> pada rincian warga, lalu kirimkan tautan tersebut ke WhatsApp warga bersangkutan.</li>
                <li>Warga membuka tautan tersebut untuk menentukan kata sandi akunnya sendiri, setelah selesai status menjadi <strong class="text-emerald-600">active</strong>.</li>
              </ol>
            </div>

            <div class="border border-slate-200 rounded-2xl p-5">
              <h4 class="font-bold text-slate-800 mb-2 text-sm flex items-center gap-2">
                <span class="w-2.5 h-2.5 bg-emerald-500 rounded-full"></span>
                Fitur Import Data & Filter Koridor
              </h4>
              <p class="text-xs text-slate-600 leading-relaxed mb-3">
                Untuk memasukkan banyak warga sekaligus, gunakan fitur <strong>Import Excel</strong>. Download template yang disediakan, isi data sesuai kolom, lalu unggah untuk ditinjau (*preview*) sebelum disimpan ke database.
              </p>
              <% if (userPermissions.includes('warga.read_corridor') && !userPermissions.includes('warga.read')) { %>
                <div class="p-3 bg-amber-50 rounded-xl text-[11px] text-amber-800 font-medium">
                  📌 <strong>Hak Akses Koordinator Koridor:</strong> Anda hanya dapat melihat dan mengelola warga yang terdaftar pada koridor binaan Anda.
                </div>
              <% } else { %>
                <div class="p-3 bg-emerald-50 rounded-xl text-[11px] text-emerald-800 font-medium">
                  🌐 <strong>Hak Akses Penuh:</strong> Anda dapat memfilter warga berdasarkan koridor manapun atau melakukan pencarian nama & no hp secara realtime.
                </div>
              <% } %>
            </div>
          </div>
        </div>
      </div>
      <% } %>

      <!-- MODUL 3: DOKUMEN & SURAT -->
      <% if (userPermissions.includes('document.manage')) { %>
      <div id="modul-dokumen" class="bg-white rounded-3xl border border-slate-200 p-6 sm:p-8 shadow-sm scroll-mt-24">
        <div class="flex items-center gap-3.5 mb-6 pb-4 border-b border-slate-100">
          <div class="w-12 h-12 bg-teal-50 text-teal-600 rounded-2xl flex items-center justify-center flex-shrink-0">
            <i data-lucide="file-text" class="w-6 h-6"></i>
          </div>
          <div>
            <span class="text-xs font-bold text-teal-600 bg-teal-50 px-2 py-0.5 rounded-md">MODUL DOKUMEN</span>
            <h3 class="text-xl font-bold text-slate-900">Verifikasi Permohonan Surat Pengantar</h3>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-5 text-xs text-slate-600">
          <div class="bg-slate-50 p-5 rounded-2xl border border-slate-100">
            <h4 class="font-bold text-slate-800 text-sm mb-1.5">1. Periksa Pengajuan</h4>
            <p class="leading-relaxed">
              Buka menu <strong>Dokumen</strong>. Berkas permohonan baru dari warga akan berstatus <strong>Pending</strong>. Klik detail untuk melihat dokumen lampiran yang diunggah warga.
            </p>
          </div>

          <div class="bg-slate-50 p-5 rounded-2xl border border-slate-100">
            <h4 class="font-bold text-slate-800 text-sm mb-1.5">2. Setujui atau Tolak</h4>
            <p class="leading-relaxed">
              Jika berkas lengkap dan sesuai, klik <strong>Setujui (Approve)</strong>. Anda dapat mengunggah file surat pengantar resmi yang sudah ditandatangani. Jika ada yang kurang, klik <strong>Tolak</strong> disertai alasan yang jelas agar warga dapat memperbaiki.
            </p>
          </div>

          <div class="bg-slate-50 p-5 rounded-2xl border border-slate-100">
            <h4 class="font-bold text-slate-800 text-sm mb-1.5">3. Arsip Otomatis</h4>
            <p class="leading-relaxed">
              Semua surat yang diterbitkan akan tersimpan rapi dalam arsip digital RT, memudahkan penelusuran jika warga membutuhkan legalisir ulang.
            </p>
          </div>
        </div>
      </div>
      <% } %>

      <!-- MODUL 4: KEUANGAN & KAS -->
      <% if (userPermissions.includes('finance.manage') || userPermissions.includes('finance.manage_corridor')) { %>
      <div id="modul-keuangan" class="bg-white rounded-3xl border border-slate-200 p-6 sm:p-8 shadow-sm scroll-mt-24">
        <div class="flex items-center gap-3.5 mb-6 pb-4 border-b border-slate-100">
          <div class="w-12 h-12 bg-amber-50 text-amber-600 rounded-2xl flex items-center justify-center flex-shrink-0">
            <i data-lucide="wallet" class="w-6 h-6"></i>
          </div>
          <div>
            <span class="text-xs font-bold text-amber-600 bg-amber-50 px-2 py-0.5 rounded-md">MODUL KEUANGAN</span>
            <h3 class="text-xl font-bold text-slate-900">Verifikasi Iuran, Pengeluaran & Kas RT</h3>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div class="border border-slate-200 rounded-2xl p-5">
            <h4 class="font-bold text-slate-800 mb-2.5 text-sm flex items-center gap-2">
              <i data-lucide="check-circle" class="w-4 h-4 text-emerald-600"></i>
              Verifikasi Pembayaran Iuran Warga
            </h4>
            <ul class="text-xs text-slate-600 space-y-2 list-disc list-inside leading-relaxed">
              <li>Cek tab <strong>Verifikasi Pembayaran</strong> untuk memeriksa konfirmasi transfer yang diunggah warga.</li>
              <li>Cocokkan bukti transfer dengan mutasi rekening bank kas RT.</li>
              <li>Klik <strong>Terima (Approve)</strong> untuk mengubah status tagihan menjadi lunas dan menambah saldo kas secara otomatis.</li>
              <li>Jika warga membayar tunai langsung kepada pengurus, gunakan opsi <strong>Pelunasan Manual</strong> untuk menandai iuran warga lunas tanpa perlu unggah struk.</li>
            </ul>
          </div>

          <div class="border border-slate-200 rounded-2xl p-5">
            <h4 class="font-bold text-slate-800 mb-2.5 text-sm flex items-center gap-2">
              <i data-lucide="dollar-sign" class="w-4 h-4 text-amber-600"></i>
              Pencatatan Pemasukan, Pengeluaran & Handover
            </h4>
            <ul class="text-xs text-slate-600 space-y-2 list-disc list-inside leading-relaxed">
              <li><strong>Catat Pengeluaran:</strong> Rekam setiap biaya operasional (honor satpam, armada sampah, solar genset, perbaikan jalan) dan sertakan foto nota/kwitansi.</li>
              <li><strong>Pemasukan Lainnya:</strong> Catat sumbangan donatur, uang sewa fasilitas, atau bantuan pemerintah.</li>
              <li><strong>Serah Terima Kas (*Handover*):</strong> Catat penyerahan uang kas fisik/rekening antar pengurus saat pergantian periode kepengurusan agar pembukuan selalu transparan.</li>
            </ul>
          </div>
        </div>
      </div>
      <% } %>

      <!-- MODUL 5: PESAN & PENGUMUMAN -->
      <% if (userPermissions.includes('message.read') || userPermissions.includes('message.create') || userPermissions.includes('message.announcement') || userPermissions.includes('message.broadcast')) { %>
      <div id="modul-pesan" class="bg-white rounded-3xl border border-slate-200 p-6 sm:p-8 shadow-sm scroll-mt-24">
        <div class="flex items-center gap-3.5 mb-6 pb-4 border-b border-slate-100">
          <div class="w-12 h-12 bg-purple-50 text-purple-600 rounded-2xl flex items-center justify-center flex-shrink-0">
            <i data-lucide="message-square" class="w-6 h-6"></i>
          </div>
          <div>
            <span class="text-xs font-bold text-purple-600 bg-purple-50 px-2 py-0.5 rounded-md">MODUL PESAN</span>
            <h3 class="text-xl font-bold text-slate-900">Pembuatan Pengumuman, Siaran Broadcast & Pesan Personal</h3>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-5 mb-5">
          <div class="bg-slate-50 p-5 rounded-2xl border border-slate-100">
            <div class="flex items-center gap-2 mb-2 font-bold text-slate-800 text-sm">
              <span class="w-3 h-3 bg-brand-600 rounded-full"></span>
              1. Pengumuman Lingkungan
            </div>
            <p class="text-xs text-slate-600 leading-relaxed">
              Tampil di beranda portal seluruh warga. Dapat ditargetkan untuk <strong>Seluruh RT</strong> atau <strong>Khusus Koridor Tertentu</strong>. Warga dapat membaca pratinjau dan melihat detail isi via modal popup.
            </p>
          </div>

          <div class="bg-slate-50 p-5 rounded-2xl border border-slate-100">
            <div class="flex items-center gap-2 mb-2 font-bold text-slate-800 text-sm">
              <span class="w-3 h-3 bg-purple-600 rounded-full"></span>
              2. Siaran Massal (Broadcast)
            </div>
            <p class="text-xs text-slate-600 leading-relaxed">
              Pesan dikirim langsung ke folder <strong>Pesan Masuk</strong> setiap warga secara serentak (bisa seluruh RT atau per koridor). Cocok untuk surat edaran atau tagihan penting.
            </p>
          </div>

          <div class="bg-slate-50 p-5 rounded-2xl border border-slate-100">
            <div class="flex items-center gap-2 mb-2 font-bold text-slate-800 text-sm">
              <span class="w-3 h-3 bg-emerald-600 rounded-full"></span>
              3. Pesan Personal Khusus
            </div>
            <p class="text-xs text-slate-600 leading-relaxed">
              Pesan ditujukan khusus ke satu atau beberapa warga tertentu. Manfaatkan fitur <strong>Pencarian Live</strong> berdasarkan nama, no telepon, atau nomor rumah untuk memilih penerima dengan cepat.
            </p>
          </div>
        </div>

        <% if (userPermissions.includes('message.announcement_read_all')) { %>
        <div class="bg-purple-50/70 border border-purple-100 rounded-2xl p-4 flex items-start gap-3 text-purple-900">
          <i data-lucide="check-check" class="w-5 h-5 text-purple-600 flex-shrink-0 mt-0.5"></i>
          <div class="text-xs leading-relaxed">
            <strong>Hak Akses Tambahan:</strong> Akun Anda memiliki izin <code>message.announcement_read_all</code>, sehingga Anda dapat membaca seluruh arsip pengumuman dari setiap koridor di lingkungan RT tanpa batasan wilayah.
          </div>
        </div>
        <% } %>
      </div>
      <% } %>

      <!-- MODUL 6: LAPOR RT -->
      <% if (userPermissions.includes('report.manage') || userPermissions.includes('report.delete_any')) { %>
      <div id="modul-lapor" class="bg-white rounded-3xl border border-slate-200 p-6 sm:p-8 shadow-sm scroll-mt-24">
        <div class="flex items-center gap-3.5 mb-6 pb-4 border-b border-slate-100">
          <div class="w-12 h-12 bg-rose-50 text-rose-600 rounded-2xl flex items-center justify-center flex-shrink-0">
            <i data-lucide="alert-circle" class="w-6 h-6"></i>
          </div>
          <div>
            <span class="text-xs font-bold text-rose-600 bg-rose-50 px-2 py-0.5 rounded-md">MODUL LAPOR RT</span>
            <h3 class="text-xl font-bold text-slate-900">Menindaklanjuti Aduan & Aspirasi Warga</h3>
          </div>
        </div>

        <div class="space-y-4 text-xs text-slate-600 leading-relaxed">
          <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
            <div class="p-4 bg-slate-50 rounded-2xl border border-slate-100">
              <span class="font-bold text-slate-800 text-sm block mb-1">Status: Pending</span>
              Laporan baru masuk dari warga. Segera baca rincian kronologi dan telaah foto lampiran lokasi.
            </div>
            <div class="p-4 bg-slate-50 rounded-2xl border border-slate-100">
              <span class="font-bold text-slate-800 text-sm block mb-1">Status: In Progress</span>
              Ubah status ke "Diproses" saat pengurus mulai mengambil tindakan lapangan atau berkoordinasi dengan petugas keamanan/kebersihan.
            </div>
            <div class="p-4 bg-slate-50 rounded-2xl border border-slate-100">
              <span class="font-bold text-slate-800 text-sm block mb-1">Status: Resolved</span>
              Tandai laporan selesai setelah penanganan tuntas dan berikan keterangan penutup pada komentar agar pelapor puas.
            </div>
          </div>
        </div>
      </div>
      <% } %>

      <!-- MODUL 7 & 8: ROLE & PERMISSION (RBAC) & KORIDOR -->
      <% if (userPermissions.includes('role.manage')) { %>
      <div id="modul-rbac" class="bg-white rounded-3xl border border-slate-200 p-6 sm:p-8 shadow-sm scroll-mt-24">
        <div class="flex items-center gap-3.5 mb-6 pb-4 border-b border-slate-100">
          <div class="w-12 h-12 bg-indigo-50 text-indigo-600 rounded-2xl flex items-center justify-center flex-shrink-0">
            <i data-lucide="shield" class="w-6 h-6"></i>
          </div>
          <div>
            <span class="text-xs font-bold text-indigo-600 bg-indigo-50 px-2 py-0.5 rounded-md">MODUL RBAC & WILAYAH</span>
            <h3 class="text-xl font-bold text-slate-900">Manajemen Peran (*Roles*), Izin (*Permissions*), dan Koridor</h3>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 text-xs text-slate-600 leading-relaxed">
          <div class="border border-slate-200 rounded-2xl p-5">
            <h4 class="font-bold text-slate-800 text-sm mb-2 flex items-center gap-2">
              <i data-lucide="key" class="w-4 h-4 text-indigo-600"></i>
              Prinsip Hak Akses Berbasis Permission
            </h4>
            <p class="mb-2">
              Sistem RT Connect menganut prinsip RBAC modular. Setiap tombol dan aksi dibatasi oleh izin spesifik bertipe <code>resource.action</code>:
            </p>
            <ul class="space-y-1 list-disc list-inside">
              <li><code>warga.create</code>, <code>warga.read</code>, <code>warga.delete</code></li>
              <li><code>finance.manage</code>, <code>finance.manage_corridor</code></li>
              <li><code>message.announcement</code>, <code>message.broadcast</code></li>
              <li><code>document.manage</code>, <code>setting.manage</code></li>
            </ul>
            <div class="mt-3 p-2.5 bg-rose-50 border border-rose-100 rounded-xl text-rose-800 text-[11px] font-medium">
              ⚠️ <strong>Perhatian:</strong> Role <code>super_admin</code> dilindungi dan tidak boleh dihapus demi menjaga integritas sistem.
            </div>
          </div>

          <div class="border border-slate-200 rounded-2xl p-5">
            <h4 class="font-bold text-slate-800 text-sm mb-2 flex items-center gap-2">
              <i data-lucide="map" class="w-4 h-4 text-indigo-600"></i>
              Pengaturan Koridor Wilayah
            </h4>
            <p class="mb-3">
              Koridor merepresentasikan blok atau jalan di lingkungan RT 04 RW 18 (misalnya Gang Mawar, Bougenville, Kenanga).
            </p>
            <p>
              Dengan mengelompokkan warga ke dalam koridor, pengurus RT dapat menunjuk <strong>Koordinator Koridor</strong> yang bertugas memantau iuran dan warga di wilayahnya masing-masing.
            </p>
          </div>
        </div>
      </div>
      <% } %>

      <!-- MODUL 9: PENGATURAN -->
      <% if (userPermissions.includes('setting.manage')) { %>
      <div id="modul-pengaturan" class="bg-white rounded-3xl border border-slate-200 p-6 sm:p-8 shadow-sm scroll-mt-24">
        <div class="flex items-center gap-3.5 mb-6 pb-4 border-b border-slate-100">
          <div class="w-12 h-12 bg-slate-100 text-slate-700 rounded-2xl flex items-center justify-center flex-shrink-0">
            <i data-lucide="settings" class="w-6 h-6"></i>
          </div>
          <div>
            <span class="text-xs font-bold text-slate-600 bg-slate-100 px-2 py-0.5 rounded-md">MODUL PENGATURAN</span>
            <h3 class="text-xl font-bold text-slate-900">Konfigurasi Rekening Kas & Parameter Sistem</h3>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-5 text-xs text-slate-600 leading-relaxed">
          <div class="p-4 bg-slate-50 rounded-2xl border border-slate-100">
            <h4 class="font-bold text-slate-800 text-sm mb-1.5">Rekening Bank Kas RT</h4>
            Atur nama bank, nomor rekening, dan nama pemilik rekening resmi. Data ini otomatis tampil saat warga melakukan pembayaran iuran di portal.
          </div>

          <div class="p-4 bg-slate-50 rounded-2xl border border-slate-100">
            <h4 class="font-bold text-slate-800 text-sm mb-1.5">Nominal Tarif Iuran Bulanan</h4>
            Atur besaran tarif iuran kebersihan dan keamanan per bulan yang digunakan sebagai dasar perhitungan tagihan warga.
          </div>

          <div class="p-4 bg-slate-50 rounded-2xl border border-slate-100">
            <h4 class="font-bold text-slate-800 text-sm mb-1.5">Nomor Hotline Kontak Pengurus</h4>
            Atur nomor WhatsApp resmi Ketua RT / Sekretariat agar warga dapat menghubungi langsung jika mengalami kendala darurat.
          </div>
        </div>
      </div>
      <% } %>

      <!-- MODUL 10: LOG ERROR -->
      <% if (userPermissions.includes('error_log.read')) { %>
      <div id="modul-log" class="bg-white rounded-3xl border border-slate-200 p-6 sm:p-8 shadow-sm scroll-mt-24">
        <div class="flex items-center gap-3.5 mb-6 pb-4 border-b border-slate-100">
          <div class="w-12 h-12 bg-red-50 text-red-600 rounded-2xl flex items-center justify-center flex-shrink-0">
            <i data-lucide="terminal" class="w-6 h-6"></i>
          </div>
          <div>
            <span class="text-xs font-bold text-red-600 bg-red-50 px-2 py-0.5 rounded-md">MODUL LOG ERROR</span>
            <h3 class="text-xl font-bold text-slate-900">Pemantauan & Diagnostik Sistem</h3>
          </div>
        </div>

        <p class="text-xs text-slate-600 leading-relaxed">
          Menu ini menyajikan rekaman log aktivitas teknis dan galat (*error trace*) aplikasi secara waktu-nyata (*realtime*). Berguna untuk mendeteksi kegagalan koneksi database, email pengiriman token aktivasi, atau kendala sesi login pengguna.
        </p>
      </div>
      <% } %>

    </div>

    <!-- FOOTER TIPS -->
    <div class="mt-8 bg-indigo-50 border border-indigo-100 rounded-2xl p-5 flex items-start gap-3.5 text-indigo-900">
      <i data-lucide="info" class="w-5 h-5 text-indigo-600 flex-shrink-0 mt-0.5"></i>
      <div class="text-xs leading-relaxed">
        <strong>Ingin menambahkan fitur baru pada akun Anda?</strong> Hubungi Administrator Utama (Super Admin) untuk memperbarui hak akses atau penugasan peran (*role*) sesuai tanggung jawab kepengurusan Anda di RT 04 / RW 18.
      </div>
    </div>

  </div>
</main>
</div>

<!-- Initialize Lucide Icons -->
<script>
  if (typeof lucide !== 'undefined') {
    lucide.createIcons();
  }
</script>
</body>
</html>
