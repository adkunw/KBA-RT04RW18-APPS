<%- include('../_sidebar.ejs', { currentPage: 'documents' }) %>

<!-- MAIN CONTENT -->
<main class="admin-main flex flex-col">
  
  <!-- TOP HEADER -->
  <header class="h-20 bg-white border-b border-slate-200 flex items-center justify-between px-6 flex-shrink-0 sticky top-0 z-40">
    <div class="flex items-center gap-4">
      <h2 class="font-display font-bold text-xl">Review Dokumen</h2>
    </div>

    <!-- Right Side Actions & Avatar -->
    <div class="flex items-center gap-4">
      <a href="/admin/messages" class="p-2 text-slate-500 hover:bg-slate-100 rounded-full transition-colors relative">
        <i data-lucide="bell" class="w-5 h-5"></i>
        <% if (typeof unreadMessages !== 'undefined' && unreadMessages > 0) { %>
          <span class="absolute top-2 right-2 w-2.5 h-2.5 bg-red-500 rounded-full border border-white"></span>
        <% } %>
      </a>
      <div class="h-8 w-px bg-slate-200 mx-1"></div>
      <div class="flex items-center gap-2">
        <% if (typeof user !== 'undefined' && user && user.name) { %>
          <div class="w-8 h-8 rounded-full bg-brand-100 border border-slate-200 flex items-center justify-center text-brand-700 font-bold text-sm">
            <%= user.name.charAt(0).toUpperCase() %>
          </div>
          <span class="text-sm font-semibold hidden lg:block"><%= user.name %></span>
        <% } %>
      </div>
    </div>
  </header>

  <!-- INNER CONTENT -->
  <div class="p-6 lg:p-8 flex-1 overflow-y-auto">
    
    <!-- PAGE HEADER & BREADCRUMB -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-8">
      <div>
        <a href="/admin/documents" class="text-xs font-semibold text-slate-400 hover:text-brand-600 flex items-center gap-1 mb-1 transition-colors">
          <i data-lucide="arrow-left" class="w-3.5 h-3.5"></i> Kembali ke Daftar Dokumen
        </a>
        <h1 class="text-2xl font-bold tracking-tight text-slate-900">Review Pengajuan Dokumen</h1>
      </div>
    </div>

    <!-- FLASH MESSAGES -->
    <% if (typeof error !== 'undefined' && error) { %>
      <div class="mb-6 p-4 rounded-2xl bg-red-50 border border-red-100 text-red-700 text-sm font-medium flex gap-3 items-start">
        <i data-lucide="alert-circle" class="w-5 h-5 flex-shrink-0 mt-0.5 text-red-500"></i>
        <span><%= error %></span>
      </div>
    <% } %>
    <% if (typeof success !== 'undefined' && success) { %>
      <div class="mb-6 p-4 rounded-2xl bg-emerald-50 border border-emerald-100 text-emerald-700 text-sm font-medium flex gap-3 items-start">
        <i data-lucide="check-circle" class="w-5 h-5 flex-shrink-0 mt-0.5 text-emerald-500"></i>
        <span><%= success %></span>
      </div>
    <% } %>

    <!-- TWO-COLUMN WORKSPACE -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 items-start">
      
      <!-- LEFT COLUMN: PREVIEW & DETAILS (2/3 width) -->
      <div class="lg:col-span-2 space-y-6">
        
        <!-- Document Meta Card -->
        <div class="bg-white rounded-3xl p-6 lg:p-8 border border-slate-200 shadow-sm space-y-6">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-slate-100 pb-6">
            <div>
              <h2 class="text-xl font-bold text-slate-900 leading-tight mb-2"><%= document.title %></h2>
              <div class="flex items-center gap-2 flex-wrap">
                <span class="inline-block px-2.5 py-1 rounded-lg text-[10px] font-bold bg-brand-50 text-brand-700 border border-brand-100 uppercase tracking-wider">
                  <%= document.type.replace('_', ' ') %>
                </span>
                <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold <%= document.status === 'pending' ? 'bg-amber-50 text-amber-700 border border-amber-100' : document.status === 'approved' ? 'bg-emerald-50 text-emerald-700 border border-emerald-100' : 'bg-rose-50 text-rose-700 border border-rose-100' %>">
                  <span class="w-1.5 h-1.5 rounded-full <%= document.status === 'pending' ? 'bg-amber-500' : document.status === 'approved' ? 'bg-emerald-500' : 'bg-rose-500' %>"></span>
                  <%= document.status === 'pending' ? 'Menunggu Verifikasi' : document.status === 'approved' ? 'Disetujui' : 'Ditolak' %>
                </span>
              </div>
            </div>
          </div>

          <!-- Metadata Grid -->
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 bg-slate-50 p-6 rounded-2xl border border-slate-150 text-sm">
            <div>
              <div class="text-[10px] font-bold text-slate-400 uppercase tracking-wider mb-1">Pengaju (Warga)</div>
              <div class="font-semibold text-slate-900"><%= document.uploader.name %></div>
              <div class="text-xs text-slate-500 mt-0.5"><%= document.uploader.phone || '-' %></div>
            </div>
            <div>
              <div class="text-[10px] font-bold text-slate-400 uppercase tracking-wider mb-1">Nama File</div>
              <div class="font-medium text-slate-700 break-all"><%= document.fileName %></div>
            </div>
            <div>
              <div class="text-[10px] font-bold text-slate-400 uppercase tracking-wider mb-1">Tanggal Diupload</div>
              <div class="font-medium text-slate-700">
                <%= new Date(document.createdAt).toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' }) %>
              </div>
            </div>
            <% if (document.reviewedAt) { %>
              <div class="sm:col-span-3 pt-4 border-t border-slate-200">
                <div class="text-[10px] font-bold text-slate-400 uppercase tracking-wider mb-1">Ditinjau Oleh</div>
                <div class="font-medium text-slate-700 flex items-center gap-2">
                  <i data-lucide="user-check" class="w-4 h-4 text-emerald-500"></i>
                  <%= document.reviewer ? document.reviewer.name : '-' %> pada <%= new Date(document.reviewedAt).toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' }) %>
                </div>
              </div>
            <% } %>
          </div>

          <!-- Existing Notes block -->
          <% if (document.notes) { %>
            <div class="p-4 rounded-2xl bg-amber-50/50 border border-amber-100 border-l-4 border-l-amber-500">
              <div class="text-xs font-bold text-amber-800 mb-1 flex items-center gap-1.5">
                <i data-lucide="message-square" class="w-4 h-4"></i> Catatan Review Sebelumnya
              </div>
              <p class="text-sm text-slate-600 leading-relaxed"><%= document.notes %></p>
            </div>
          <% } %>

          <!-- FILE PREVIEW -->
          <div class="space-y-3">
            <h3 class="text-xs font-bold text-slate-400 uppercase tracking-wider">Preview File Pengajuan</h3>
            <div class="bg-slate-50 border border-slate-200 rounded-2xl p-6 flex flex-col items-center justify-center min-h-[300px]">
              <% const ext = document.fileName.split('.').pop().toLowerCase(); %>
              <% if (['jpg','jpeg','png'].includes(ext)) { %>
                <img src="<%= document.filePath %>" alt="<%= document.title %>" class="max-w-full max-h-[500px] rounded-xl shadow-lg border border-slate-200/50">
              <% } else { %>
                <div class="w-16 h-16 bg-red-100 rounded-full flex items-center justify-center mb-3">
                  <i data-lucide="file-text" class="w-8 h-8 text-red-600"></i>
                </div>
                <h4 class="font-semibold text-slate-900 mb-1">Berkas Lampiran PDF</h4>
                <p class="text-xs text-slate-500 mb-4">Berkas pengajuan diunggah dalam format dokumen PDF</p>
                <a href="<%= document.filePath %>" target="_blank" rel="noopener" class="inline-flex items-center gap-2 bg-brand-600 hover:bg-brand-700 text-white font-bold py-2.5 px-6 rounded-xl transition-colors shadow-sm text-sm">
                  <i data-lucide="external-link" class="w-4 h-4"></i> Buka File PDF di Tab Baru
                </a>
              <% } %>
            </div>
          </div>
        </div>
      </div>

      <!-- RIGHT COLUMN: ADMIN CONTROLS (1/3 width) -->
      <div class="space-y-6">
        
        <!-- APPROVE CARD -->
        <% if (document.status !== 'approved') { %>
          <div class="bg-white rounded-3xl p-6 border border-slate-200 border-l-4 border-l-emerald-500 shadow-sm space-y-4">
            <h3 class="font-bold text-lg text-emerald-800 flex items-center gap-2">
              <i data-lucide="check-circle" class="w-5 h-5 text-emerald-600"></i> Setujui Pengajuan
            </h3>
            <p class="text-xs text-slate-500 leading-normal">Dengan menyetujui, warga akan menerima pemberitahuan bahwa permohonan surat mereka telah disahkan.</p>
            
            <form action="/admin/documents/<%= document.id %>/approve" method="POST" class="space-y-4">
              <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
              <div class="space-y-1.5">
                <label class="block text-xs font-semibold text-slate-700">Catatan Review (opsional)</label>
                <textarea name="notes" rows="3" placeholder="Contoh: Dokumen disetujui, silakan ambil fisik surat di kantor RT..." class="block w-full p-3 border border-slate-200 rounded-xl text-sm focus:ring-2 focus:ring-brand-500 focus:border-brand-500" maxlength="500"></textarea>
              </div>
              <button type="submit" class="w-full flex justify-center py-2.5 px-4 border border-transparent rounded-xl shadow-sm text-sm font-bold text-white bg-emerald-600 hover:bg-emerald-700 transition-colors">
                Setujui & Tandatangani
              </button>
            </form>
          </div>
        <% } %>

        <!-- REJECT CARD -->
        <% if (document.status !== 'rejected') { %>
          <div class="bg-white rounded-3xl p-6 border border-slate-200 border-l-4 border-l-rose-500 shadow-sm space-y-4">
            <h3 class="font-bold text-lg text-rose-800 flex items-center gap-2">
              <i data-lucide="x-circle" class="w-5 h-5 text-rose-600"></i> Tolak Pengajuan
            </h3>
            <p class="text-xs text-slate-500 leading-normal">Gunakan ini jika berkas buram, data tidak lengkap, atau tidak sesuai syarat RT.</p>
            
            <form action="/admin/documents/<%= document.id %>/reject" method="POST" class="space-y-4">
              <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
              <div class="space-y-1.5">
                <label class="block text-xs font-semibold text-slate-700">Alasan Penolakan (wajib)</label>
                <textarea name="notes" rows="3" required placeholder="Contoh: Lampiran buram, mohon foto ulang KTP Anda dengan jelas..." class="block w-full p-3 border border-slate-200 rounded-xl text-sm focus:ring-2 focus:ring-brand-500 focus:border-brand-500" maxlength="500"></textarea>
              </div>
              <button type="submit" class="w-full flex justify-center py-2.5 px-4 border border-transparent rounded-xl shadow-sm text-sm font-bold text-white bg-rose-600 hover:bg-rose-700 transition-colors">
                Tolak Pengajuan
              </button>
            </form>
          </div>
        <% } %>

        <!-- DELETE CARD -->
        <div class="bg-white rounded-3xl p-6 border border-slate-200 shadow-sm space-y-4">
          <h3 class="font-bold text-sm text-slate-900 flex items-center gap-2">
            <i data-lucide="trash-2" class="w-4 h-4 text-slate-500"></i> Tindakan Lainnya
          </h3>
          <p class="text-xs text-slate-500 leading-normal">Menghapus pengajuan secara permanen termasuk file yang diunggah. Tindakan ini tidak dapat dibatalkan.</p>
          
          <form action="/admin/documents/<%= document.id %>/delete" method="POST" onsubmit="return confirm('Apakah Anda yakin ingin menghapus dokumen ini secara permanen dari server?')">
            <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
            <button type="submit" class="w-full flex justify-center py-2 px-4 border border-rose-200 rounded-xl text-xs font-bold text-rose-600 bg-white hover:bg-rose-50 transition-colors">
              Hapus Permanen
            </button>
          </form>
        </div>
      </div>
    </div>
  </div>
</main>
</div>
</body>
</html>
