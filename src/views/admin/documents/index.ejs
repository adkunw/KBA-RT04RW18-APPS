<%- include('../_sidebar.ejs', { currentPage: 'documents' }) %>

<!-- MAIN CONTENT -->
<main class="admin-main flex flex-col">
  
  <!-- TOP HEADER -->
  <header class="h-20 bg-white border-b border-slate-200 flex items-center justify-between px-6 flex-shrink-0 sticky top-0 z-40">
    <div class="flex items-center gap-4">
      <h2 class="font-display font-bold text-xl">Manajemen Dokumen</h2>
    </div>

    <!-- Right Side Actions & Avatar -->
    <div class="flex items-center gap-4">
      <a href="/admin/messages" class="p-2 text-slate-500 hover:bg-slate-100 rounded-full transition-colors relative">
        <i data-lucide="bell" class="w-5 h-5"></i>
        <% if (typeof unreadMessages !== 'undefined' && unreadMessages > 0) { %>
          <span class="absolute top-2 right-2 w-2.5 h-2.5 bg-red-500 rounded-full border border-white"></span>
        <% } %>
      </a>
      <div class="h-8 w-px bg-slate-200 mx-1"></div>
      <div class="flex items-center gap-2">
        <% if (typeof user !== 'undefined' && user && user.name) { %>
          <div class="w-8 h-8 rounded-full bg-brand-100 border border-slate-200 flex items-center justify-center text-brand-700 font-bold text-sm">
            <%= user.name.charAt(0).toUpperCase() %>
          </div>
          <span class="text-sm font-semibold hidden lg:block"><%= user.name %></span>
        <% } %>
      </div>
    </div>
  </header>

  <!-- INNER CONTENT -->
  <div class="p-6 lg:p-8 flex-1 overflow-y-auto">
    
    <!-- PAGE HEADER -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-8">
      <div>
        <h1 class="text-2xl font-bold tracking-tight text-slate-900">Pengajuan Surat & Dokumen</h1>
        <p class="text-sm text-slate-500">Verifikasi dan kelola permohonan surat keterangan serta upload dokumen warga.</p>
      </div>
    </div>

    <!-- FLASH MESSAGES -->
    <% if (typeof error !== 'undefined' && error) { %>
      <div class="mb-6 p-4 rounded-2xl bg-red-50 border border-red-100 text-red-700 text-sm font-medium flex gap-3 items-start">
        <i data-lucide="alert-circle" class="w-5 h-5 flex-shrink-0 mt-0.5 text-red-500"></i>
        <span><%= error %></span>
      </div>
    <% } %>
    <% if (typeof success !== 'undefined' && success) { %>
      <div class="mb-6 p-4 rounded-2xl bg-emerald-50 border border-emerald-100 text-emerald-700 text-sm font-medium flex gap-3 items-start">
        <i data-lucide="check-circle" class="w-5 h-5 flex-shrink-0 mt-0.5 text-emerald-500"></i>
        <span><%= success %></span>
      </div>
    <% } %>

    <!-- STATS ROW - BENTO GRID -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
      <!-- Total -->
      <div class="bg-white p-6 rounded-3xl border border-slate-200 shadow-sm">
        <div class="flex justify-between items-start mb-4">
          <div class="p-3 bg-brand-50 rounded-2xl">
            <i data-lucide="files" class="text-brand-600 w-6 h-6"></i>
          </div>
        </div>
        <p class="text-2xl font-bold tracking-tight text-slate-900"><%= stats.total %></p>
        <p class="text-sm font-semibold text-slate-900 mb-1">Total Pengajuan</p>
        <p class="text-xs text-slate-400 font-medium">Keseluruhan dokumen</p>
      </div>

      <!-- Pending -->
      <div class="bg-white p-6 rounded-3xl border border-slate-200 shadow-sm">
        <div class="flex justify-between items-start mb-4">
          <div class="p-3 bg-amber-50 rounded-2xl">
            <i data-lucide="clock" class="text-amber-500 w-6 h-6"></i>
          </div>
        </div>
        <p class="text-2xl font-bold tracking-tight text-slate-900"><%= stats.pending %></p>
        <p class="text-sm font-semibold text-slate-900 mb-1">Menunggu Review</p>
        <p class="text-xs text-slate-400 font-medium">Perlu segera diverifikasi</p>
      </div>

      <!-- Approved -->
      <div class="bg-white p-6 rounded-3xl border border-slate-200 shadow-sm">
        <div class="flex justify-between items-start mb-4">
          <div class="p-3 bg-emerald-50 rounded-2xl">
            <i data-lucide="check-circle" class="text-emerald-500 w-6 h-6"></i>
          </div>
        </div>
        <p class="text-2xl font-bold tracking-tight text-slate-900"><%= stats.approved %></p>
        <p class="text-sm font-semibold text-slate-900 mb-1">Telah Disetujui</p>
        <p class="text-xs text-slate-400 font-medium">Selesai diproses</p>
      </div>

      <!-- Rejected -->
      <div class="bg-white p-6 rounded-3xl border border-slate-200 shadow-sm">
        <div class="flex justify-between items-start mb-4">
          <div class="p-3 bg-rose-50 rounded-2xl">
            <i data-lucide="x-circle" class="text-rose-500 w-6 h-6"></i>
          </div>
        </div>
        <p class="text-2xl font-bold tracking-tight text-slate-900"><%= stats.rejected %></p>
        <p class="text-sm font-semibold text-slate-900 mb-1">Ditolak</p>
        <p class="text-xs text-slate-400 font-medium">Pengajuan tidak sah</p>
      </div>
    </div>

    <!-- FILTER & SEARCH BAR -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-6">
      <div class="flex items-center gap-2 overflow-x-auto pb-2 md:pb-0">
        <span class="text-sm font-semibold text-slate-500 mr-2 flex-shrink-0">Filter Status:</span>
        <a href="/admin/documents" class="px-4 py-2 rounded-full text-xs font-semibold border transition-all <%= !filterStatus ? 'bg-slate-900 text-white border-slate-900 shadow-sm' : 'bg-white text-slate-600 border-slate-200 hover:bg-slate-50' %>">
          Semua
        </a>
        <a href="/admin/documents?status=pending" class="px-4 py-2 rounded-full text-xs font-semibold border transition-all <%= filterStatus === 'pending' ? 'bg-amber-100 text-amber-800 border-amber-200 shadow-sm' : 'bg-white text-slate-600 border-slate-200 hover:bg-slate-50' %>">
          Menunggu
        </a>
        <a href="/admin/documents?status=approved" class="px-4 py-2 rounded-full text-xs font-semibold border transition-all <%= filterStatus === 'approved' ? 'bg-emerald-100 text-emerald-800 border-emerald-200 shadow-sm' : 'bg-white text-slate-600 border-slate-200 hover:bg-slate-50' %>">
          Disetujui
        </a>
        <a href="/admin/documents?status=rejected" class="px-4 py-2 rounded-full text-xs font-semibold border transition-all <%= filterStatus === 'rejected' ? 'bg-red-100 text-red-800 border-red-200 shadow-sm' : 'bg-white text-slate-600 border-slate-200 hover:bg-slate-50' %>">
          Ditolak
        </a>
      </div>
      
      <!-- Real-Time Search Box -->
      <form action="/admin/documents" method="GET" class="relative w-full md:w-80" style="position:relative;">
        <% if (filterStatus) { %>
          <input type="hidden" name="status" value="<%= filterStatus %>">
        <% } %>
        <span class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-slate-400" style="position:absolute;left:10px;top:50%;transform:translateY(-50%);color:#94a3b8;">
          <i data-lucide="search" style="width:16px;height:16px;"></i>
        </span>
        <input type="text" name="search" id="documentSearchInput" value="<%= typeof search !== 'undefined' && search ? search : '' %>" oninput="applyDocumentSearch()" placeholder="Cari judul, nama pengaju, keperluan..." class="w-full text-sm border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent transition-all" style="padding:0.5rem 1rem 0.5rem 2.2rem;border-radius:10px;border:1px solid var(--gray-300);width:100%;">
      </form>
    </div>

    <!-- TABLE -->
    <div class="bg-white border border-slate-200 rounded-3xl overflow-hidden shadow-sm">
      <% if (documents.length === 0) { %>
        <div class="text-center py-12 text-slate-500">
          <div class="w-16 h-16 bg-slate-100 rounded-full flex items-center justify-center mx-auto mb-4">
            <i data-lucide="folder-open" class="w-8 h-8 text-slate-400"></i>
          </div>
          <h3 class="text-base font-bold text-slate-900 mb-1">Tidak ada dokumen</h3>
          <p class="text-sm text-slate-500 px-4">Belum ada dokumen yang diupload warga<%= filterStatus ? ' dengan status filter ini.' : '.' %></p>
        </div>
      <% } else { %>
        <div class="overflow-x-auto">
          <table class="w-full text-left border-collapse">
            <thead>
              <tr class="bg-slate-50 border-b border-slate-200">
                <th class="px-6 py-4 text-xs font-bold text-slate-500 uppercase tracking-wider">Detail Dokumen</th>
                <th class="px-6 py-4 text-xs font-bold text-slate-500 uppercase tracking-wider">Nama Pengaju (Warga)</th>
                <th class="px-6 py-4 text-xs font-bold text-slate-500 uppercase tracking-wider">Jenis Keperluan</th>
                <th class="px-6 py-4 text-xs font-bold text-slate-500 uppercase tracking-wider">Tanggal Pengajuan</th>
                <th class="px-6 py-4 text-xs font-bold text-slate-500 uppercase tracking-wider">Status</th>
                <th class="px-6 py-4 text-xs font-bold text-slate-500 uppercase tracking-wider text-right">Aksi</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
              <% documents.forEach(doc => { %>
                <tr class="hover:bg-slate-50/50 transition-colors"
                    data-title="<%= doc.title.toLowerCase() %>"
                    data-filename="<%= doc.fileName.toLowerCase() %>"
                    data-uploader="<%= doc.uploader.name.toLowerCase() %>"
                    data-type="<%= doc.type.toLowerCase().replace('_', ' ') %>">
                  <td class="px-6 py-4">
                    <div class="font-semibold text-slate-900 leading-tight mb-1"><%= doc.title %></div>
                    <div class="text-xs text-slate-400 flex items-center gap-1">
                      <i data-lucide="file" class="w-3.5 h-3.5 flex-shrink-0"></i> <%= doc.fileName %>
                    </div>
                  </td>
                  <td class="px-6 py-4">
                    <div class="font-medium text-slate-900"><%= doc.uploader.name %></div>
                    <div class="text-xs text-slate-400 flex items-center gap-1">
                      <i data-lucide="phone" class="w-3 h-3 flex-shrink-0"></i> <%= doc.uploader.phone || '-' %>
                    </div>
                  </td>
                  <td class="px-6 py-4">
                    <span class="inline-block px-2.5 py-1 rounded-lg text-[10px] font-bold bg-brand-50 text-brand-700 border border-brand-100 uppercase tracking-wider">
                      <%= doc.type.replace('_', ' ') %>
                    </span>
                  </td>
                  <td class="px-6 py-4 text-sm text-slate-600">
                    <%= new Date(doc.createdAt).toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric' }) %>
                  </td>
                  <td class="px-6 py-4">
                    <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold <%= doc.status === 'pending' ? 'bg-amber-50 text-amber-700 border border-amber-100' : doc.status === 'approved' ? 'bg-emerald-50 text-emerald-700 border border-emerald-100' : 'bg-rose-50 text-rose-700 border border-rose-100' %>">
                      <span class="w-1.5 h-1.5 rounded-full <%= doc.status === 'pending' ? 'bg-amber-500' : doc.status === 'approved' ? 'bg-emerald-500' : 'bg-rose-500' %>"></span>
                      <%= doc.status === 'pending' ? 'Menunggu' : doc.status === 'approved' ? 'Disetujui' : 'Ditolak' %>
                    </span>
                  </td>
                  <td class="px-6 py-4 text-right">
                    <a href="/admin/documents/<%= doc.id %>" class="inline-flex items-center gap-1 bg-slate-900 hover:bg-slate-800 text-white font-bold text-xs py-1.5 px-3 rounded-lg transition-colors">
                      <i data-lucide="edit-3" class="w-3.5 h-3.5"></i> Review
                    </a>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>
  </div>
</main>

<script>
  function applyDocumentSearch() {
    const query = document.getElementById('documentSearchInput').value.toLowerCase().trim();
    const rows = document.querySelectorAll('tbody tr');
    let visibleCount = 0;
    
    rows.forEach(row => {
      const title = row.getAttribute('data-title') || '';
      const filename = row.getAttribute('data-filename') || '';
      const uploader = row.getAttribute('data-uploader') || '';
      const type = row.getAttribute('data-type') || '';
      
      const isMatch = !query || 
                      title.includes(query) || 
                      filename.includes(query) || 
                      uploader.includes(query) || 
                      type.includes(query);
      
      if (isMatch) {
        row.style.display = '';
        visibleCount++;
      } else {
        row.style.display = 'none';
      }
    });
    
    // Toggle Empty State for search results
    let emptyState = document.getElementById('searchEmptyState');
    const tableElement = document.querySelector('table');
    const wrapper = document.querySelector('.overflow-hidden') || document.querySelector('.bg-white.border');
    
    if (visibleCount === 0) {
      if (tableElement) tableElement.style.display = 'none';
      if (!emptyState) {
        emptyState = document.createElement('div');
        emptyState.id = 'searchEmptyState';
        emptyState.className = 'text-center py-12 text-slate-500';
        emptyState.innerHTML = `
          <div class="w-16 h-16 bg-slate-100 rounded-full flex items-center justify-center mx-auto mb-4">
            <i data-lucide="search" class="w-8 h-8 text-slate-400"></i>
          </div>
          <h3 class="text-base font-bold text-slate-900 mb-1">Hasil tidak ditemukan</h3>
          <p class="text-sm text-slate-500 px-4">Tidak ada dokumen yang cocok dengan pencarian Anda.</p>
        `;
        wrapper.appendChild(emptyState);
        if (typeof lucide !== 'undefined') lucide.createIcons();
      } else {
        emptyState.style.display = '';
      }
    } else {
      if (tableElement) tableElement.style.display = '';
      if (emptyState) emptyState.style.display = 'none';
    }
  }
</script>

</body>
</html>
