<%- include('../_sidebar.ejs', { currentPage: 'users' }) %>
<%
const formatDate = (dateStr) => {
  if (!dateStr) return '-';
  if (dateStr instanceof Date) {
    return dateStr.toLocaleDateString('id-ID', { year: 'numeric', month: 'long', day: 'numeric' });
  }
  if (typeof dateStr !== 'string') {
    dateStr = String(dateStr);
  }
  const parts = dateStr.split('-');
  if (parts.length !== 3) return dateStr;
  const months = ['Januari', 'Februari', 'Maret', 'April', 'Mei', 'Juni', 'Juli', 'Agustus', 'September', 'Oktober', 'November', 'Desember'];
  const day = parseInt(parts[2], 10);
  const month = months[parseInt(parts[1], 10) - 1];
  const year = parts[0];
  return `${day} ${month} ${year}`;
};
%>

 <!-- MAIN CONTENT -->
 <main class="admin-main flex flex-col">
 <!-- TOP HEADER -->
 <header class="h-20 bg-white border-b border-slate-200 flex items-center justify-between px-6 flex-shrink-0 sticky top-0 z-40">
 <div class="flex items-center gap-4">
 <h2 class="font-display font-bold text-xl"><%= typeof title !== 'undefined' ? title : 'Admin Panel' %></h2>
 </div>

 <div class="flex items-center gap-4">
 <a href="/admin/messages" class="p-2 text-slate-500 hover:bg-slate-100 rounded-full transition-colors relative">
 <i data-lucide="bell" class="w-5 h-5"></i>
 <% if (typeof unreadMessages !== 'undefined' && unreadMessages > 0) { %>
 <span class="absolute top-2 right-2 w-2 h-2 bg-red-500 rounded-full border-2 border-white"></span>
 <% } %>
 </a>
 <div class="h-8 w-px bg-slate-200 mx-1"></div>
 <div class="flex items-center gap-2">
 <% if (typeof user !== 'undefined' && user && user.name) { %>
 <div class="w-8 h-8 rounded-full bg-brand-100 border border-slate-200 flex items-center justify-center text-brand-700 font-bold text-sm">
 <%= user.name.charAt(0).toUpperCase() %>
 </div>
 <span class="text-sm font-semibold hidden lg:block"><%= user.name %></span>
 <% } %>
 </div>
 </div>
 </header>
 <div class="p-6 lg:p-8 flex-1 overflow-y-auto">

 <div class="page-header">
 <div style="display:flex; align-items:center; gap:1rem;">
 <h1> <%= viewedUser.name %></h1>
 <a href="/admin/users/<%= viewedUser.id %>/edit" class="btn btn-primary btn-sm"> Edit</a>
 </div>
 <a href="/admin/users" class="btn btn-secondary">← Back to Users</a>
 </div>

  <% 
  const isExpired = viewedUser.status === 'created' && viewedUser.activationTokens && viewedUser.activationTokens.length > 0 && new Date() > new Date(viewedUser.activationTokens[0].expiredAt);
  %>
  <% if (viewedUser.status === 'created' && isExpired) { %>
  <div class="alert alert-error" style="display:flex; justify-content:space-between; align-items:center; background:#FEE2E2; border-left-color:#EF4444; color:#991B1B; margin-bottom: 1.5rem;">
    <div>
      <strong style="display:flex; align-items:center; gap:0.5rem;">⚠️ Kunci Aktivasi Kedaluwarsa (Activation Key Expired)</strong>
      <p style="margin: 0.25rem 0 0 0; font-size: 0.875rem; color: #7F1D1D;">Tautan aktivasi untuk warga ini telah kedaluwarsa. Silakan buat kunci aktivasi baru agar warga dapat mendaftar.</p>
    </div>
    <form action="/admin/users/<%= viewedUser.id %>/recreate-activation" method="POST" class="m-0" style="margin:0;">
      <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
      <button type="submit" class="btn btn-primary btn-sm" style="background:#DC2626; border-color:#DC2626; color:white; font-size:0.875rem; padding: 0.5rem 1rem; border-radius: 6px;">
        Buat Kunci Baru
      </button>
    </form>
  </div>
  <% } else if (viewedUser.status === 'created') { %>
  <div class="alert" style="background:#FEF3C7; border-left-color:var(--warning); color:#92400E; display:flex; justify-content:space-between; align-items:center; margin-bottom: 1.5rem;">
  <div>
  <strong> Pending Activation:</strong> This user hasn't activated their account yet.<br>
  <span style="font-size:0.875rem; font-family:monospace; margin-top:0.5rem; display:inline-block; background:rgba(0,0,0,0.05); padding:0.25rem 0.5rem; border-radius:4px;"><%= activationLink %></span>
  </div>
  <div style="display:flex; gap:0.5rem; align-items:center;">
    <button onclick="navigator.clipboard.writeText('<%= activationLink %>').then(() => alert('Copied to clipboard!'))" class="btn btn-primary btn-sm" style="flex-shrink:0;">
    Copy Link 
    </button>
    <form action="/admin/users/<%= viewedUser.id %>/recreate-activation" method="POST" class="m-0" style="margin:0;">
      <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
      <button type="submit" class="btn btn-secondary btn-sm" style="font-size:0.875rem; color: var(--gray-700);">
        Regenerate Link
      </button>
    </form>
  </div>
  </div>
  <% } %>

 <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; margin-bottom: 1.5rem;">

 <!-- Profile Info Card -->
 <div class="card">
 <h3 style="color:var(--primary); font-size:0.75rem; text-transform:uppercase; letter-spacing:0.06em; margin-bottom:1rem;">Profile Information</h3>
 <table style="width:100%; border-collapse:collapse;">
 <tr style="border-bottom:1px solid var(--gray-100);">
 <td style="padding:0.625rem 0; color:var(--gray-600); font-size:0.875rem; width:40%;">Name</td>
 <td style="padding:0.625rem 0; color:var(--gray-900); font-weight:500;"><%= viewedUser.name %></td>
 </tr>
 <tr style="border-bottom:1px solid var(--gray-100);">
 <td style="padding:0.625rem 0; color:var(--gray-600); font-size:0.875rem;">Phone</td>
 <td style="padding:0.625rem 0; color:var(--gray-900);"><%= viewedUser.phone %></td>
 </tr>
 <tr style="border-bottom:1px solid var(--gray-100);">
 <td style="padding:0.625rem 0; color:var(--gray-600); font-size:0.875rem;">Nomor Rumah</td>
 <td style="padding:0.625rem 0; color:var(--gray-900); font-weight:500;"><%= viewedUser.houseNumber || '-' %></td>
 </tr>

  <tr style="border-bottom:1px solid var(--gray-100);">
  <td style="padding:0.625rem 0; color:var(--gray-600); font-size:0.875rem;">Status</td>
  <td style="padding:0.625rem 0;">
    <% if (viewedUser.status === 'created' && isExpired) { %>
      <span class="badge badge-warning" style="background:#FEE2E2; color:#991B1B; border:1px solid #FCA5A5; font-size:0.75rem; font-weight:700;">Activation Expired</span>
    <% } else if (viewedUser.status === 'created') { %>
      <span class="badge badge-created" style="background:#FEF3C7; color:#92400E; border:1px solid #FCD34D; font-size:0.75rem; font-weight:700;">Pending Activation</span>
    <% } else { %>
      <span class="badge badge-<%= viewedUser.status %>" style="font-size:0.75rem; font-weight:700;"><%= viewedUser.status %></span>
    <% } %>
  </td>
  </tr>
 <tr style="border-bottom:1px solid var(--gray-100);">
 <td style="padding:0.625rem 0; color:var(--gray-600); font-size:0.875rem;">Member Since</td>
 <td style="padding:0.625rem 0; color:var(--gray-900); font-size:0.875rem;">
 <%= new Date(viewedUser.createdAt).toLocaleDateString('id-ID', { year:'numeric', month:'long', day:'numeric' }) %>
 </td>
 </tr>
 <% if (viewedUser.lastLogin) { %>
 <tr>
 <td style="padding:0.625rem 0; color:var(--gray-600); font-size:0.875rem;">Last Login</td>
 <td style="padding:0.625rem 0; color:var(--gray-900); font-size:0.875rem;">
 <%= new Date(viewedUser.lastLogin).toLocaleString('id-ID') %>
 </td>
 </tr>
 <% } %>
 </table>
 </div>

 <!-- Roles Card -->
 <div class="card">
 <h3 style="color:var(--primary); font-size:0.75rem; text-transform:uppercase; letter-spacing:0.06em; margin-bottom:1rem;">Assigned Roles</h3>
 <% if (viewedUser.roles && Array.isArray(viewedUser.roles) && viewedUser.roles.length > 0) { %>
 <ul style="list-style:none; padding:0; margin:0; display:flex; flex-direction:column; gap:0.5rem;">
 <% viewedUser.roles.forEach(ur => { %>
 <li style="padding:0.75rem; background:var(--gray-100); border-radius:6px; border-left:4px solid var(--primary);">
 <strong style="color:var(--gray-900)"><%= ur.role.name %></strong>
 <% if (ur.role.permissions && ur.role.permissions.length > 0) { %>
 <div style="margin-top:0.4rem; font-size:0.8rem; color:var(--gray-600);">
 <% ur.role.permissions.forEach(rp => { %>
 <span style="display:inline-block; background:var(--primary-light); color:var(--primary); padding:1px 6px; border-radius:4px; margin:2px; font-size:0.75rem; font-weight:500;">
 <%= rp.permission.name %>
 </span>
 <% }); %>
 </div>
 <% } %>
 </li>
 <% }); %>
 </ul>
 <% } else { %>
 <p style="color:var(--gray-600); font-style:italic;">No roles assigned</p>
 <% } %>
 </div>

 </div>

  <!-- Family & Demographics Card -->
  <div class="card" style="margin-bottom: 1.5rem;">
    <h3 style="color:var(--primary); font-size:0.75rem; text-transform:uppercase; letter-spacing:0.06em; margin-bottom:1.5rem;">👨‍👩‍👧‍👦 Data Keluarga & Kependudukan</h3>
    
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 1.5rem;">
      
      <!-- User Demographic Details -->
      <div style="background:#f8fafc; border:1px solid var(--gray-200); border-radius:12px; padding:1.25rem;">
        <h4 style="font-size:0.9rem; color:var(--gray-900); margin:0 0 0.75rem 0; font-weight:700; display:flex; align-items:center; gap:0.5rem;">
          👤 Data Diri Warga
        </h4>
        <table style="width:100%; border-collapse:collapse; font-size:0.875rem;">
          <tr style="border-bottom:1px solid var(--gray-100);">
            <td style="padding:0.5rem 0; color:var(--gray-600); width:40%;">NIK</td>
            <td style="padding:0.5rem 0; color:var(--gray-900); font-weight:600;"><%= viewedUser.nik || '-' %></td>
          </tr>
          <tr style="border-bottom:1px solid var(--gray-100);">
            <td style="padding:0.5rem 0; color:var(--gray-600);">No. KK</td>
            <td style="padding:0.5rem 0; color:var(--gray-900); font-weight:600;"><%= viewedUser.kkNumber || '-' %></td>
          </tr>
          <tr>
            <td style="padding:0.5rem 0; color:var(--gray-600);">Tanggal Lahir</td>
            <td style="padding:0.5rem 0; color:var(--gray-900); font-weight:500;">
              <%= formatDate(viewedUser.birthDate) %>
            </td>
          </tr>
        </table>
      </div>

      <!-- Spouse Demographic Details -->
      <div style="background:#f8fafc; border:1px solid var(--gray-200); border-radius:12px; padding:1.25rem;">
        <h4 style="font-size:0.9rem; color:var(--gray-900); margin:0 0 0.75rem 0; font-weight:700; display:flex; align-items:center; gap:0.5rem;">
          👩‍❤️‍👨 Pasangan (Suami / Istri)
        </h4>
        <table style="width:100%; border-collapse:collapse; font-size:0.875rem;">
          <tr style="border-bottom:1px solid var(--gray-100);">
            <td style="padding:0.5rem 0; color:var(--gray-600); width:40%;">Nama</td>
            <td style="padding:0.5rem 0; color:var(--gray-900); font-weight:600;"><%= viewedUser.spouseName || '-' %></td>
          </tr>
          <tr style="border-bottom:1px solid var(--gray-100);">
            <td style="padding:0.5rem 0; color:var(--gray-600);">No. Telp</td>
            <td style="padding:0.5rem 0; color:var(--gray-900); font-weight:500;"><%= viewedUser.spousePhone || '-' %></td>
          </tr>
          <tr style="border-bottom:1px solid var(--gray-100);">
            <td style="padding:0.5rem 0; color:var(--gray-600);">Tanggal Lahir</td>
            <td style="padding:0.5rem 0; color:var(--gray-900);">
              <%= formatDate(viewedUser.spouseBirthDate) %>
            </td>
          </tr>
          <tr>
            <td style="padding:0.5rem 0; color:var(--gray-600);">NIK</td>
            <td style="padding:0.5rem 0; color:var(--gray-900);"><%= viewedUser.spouseNik || '-' %></td>
          </tr>
        </table>
      </div>

      <!-- Child Demographic Details -->
      <div style="background:#f8fafc; border:1px solid var(--gray-200); border-radius:12px; padding:1.25rem;">
        <h4 style="font-size:0.9rem; color:var(--gray-900); margin:0 0 0.75rem 0; font-weight:700; display:flex; align-items:center; gap:0.5rem;">
          👶 Data Anak
        </h4>
        
        <% if (viewedUser.children && Array.isArray(viewedUser.children) && viewedUser.children.length > 0) { %>
          <div style="display:flex; flex-direction:column; gap:1rem;">
            <% viewedUser.children.forEach((child, index) => { %>
              <div style="<%= index > 0 ? 'border-top: 1px solid var(--gray-200); padding-top: 1rem;' : '' %>">
                <div style="font-size:0.75rem; font-weight:700; color:var(--primary); margin-bottom:0.5rem; text-transform:uppercase;">Anak ke-<%= index + 1 %></div>
                <table style="width:100%; border-collapse:collapse; font-size:0.875rem;">
                  <tr style="border-bottom:1px solid var(--gray-100);">
                    <td style="padding:0.35rem 0; color:var(--gray-600); width:40%;">Nama</td>
                    <td style="padding:0.35rem 0; color:var(--gray-900); font-weight:600;"><%= child.name || '-' %></td>
                  </tr>
                  <tr style="border-bottom:1px solid var(--gray-100);">
                    <td style="padding:0.35rem 0; color:var(--gray-600);">Tanggal Lahir</td>
                    <td style="padding:0.35rem 0; color:var(--gray-900);">
                      <%= formatDate(child.birthDate) %>
                    </td>
                  </tr>
                  <tr>
                    <td style="padding:0.35rem 0; color:var(--gray-600);">NIK</td>
                    <td style="padding:0.35rem 0; color:var(--gray-900);"><%= child.nik || '-' %></td>
                  </tr>
                </table>
              </div>
            <% }) %>
          </div>
        <% } else { %>
          <p style="color:var(--gray-500); font-size:0.875rem; font-style:italic; margin:0;">Tidak ada data anak</p>
        <% } %>
      </div>

    </div>
  </div>

 <!-- Approved Documents Card -->
 <div class="card" style="margin-bottom: 1.5rem;">
 <h3 style="color:var(--primary); font-size:0.75rem; text-transform:uppercase; letter-spacing:0.06em; margin-bottom:1rem;"> Dokumen Disetujui</h3>
 <% if (typeof approvedDocuments !== 'undefined' && approvedDocuments.length > 0) { %>
 <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 1rem;">
 <% approvedDocuments.forEach(doc => { %>
 <a href="/admin/documents/<%= doc.id %>" style="display:flex; align-items:center; gap:0.75rem; padding:1rem; border:1px solid var(--gray-200); border-radius:8px; text-decoration:none; color:inherit; transition:all 0.2s ease;" onmouseover="this.style.borderColor='var(--primary)'; this.style.boxShadow='0 2px 8px rgba(37,99,235,0.1)';" onmouseout="this.style.borderColor='var(--gray-200)'; this.style.boxShadow='none';">
 <div style="width:40px; height:40px; border-radius:8px; background:var(--primary-light); color:var(--primary-dark); display:flex; align-items:center; justify-content:center; font-size:1.25rem;">
 <%= doc.type === 'ktp' ? '🪪' : doc.type === 'kk' ? '📄' : doc.type === 'surat_keterangan' ? '📝' : '📎' %>
 </div>
 <div style="flex:1; min-width:0;">
 <div style="font-size:0.875rem; font-weight:600; color:var(--gray-900); white-space:nowrap; overflow:hidden; text-overflow:ellipsis;"><%= doc.title %></div>
 <div style="font-size:0.75rem; color:var(--gray-600); margin-top:0.125rem;">
 <%= doc.type.replace('_', ' ').toUpperCase() %> • <%= new Date(doc.createdAt).toLocaleDateString('id-ID', { day:'numeric', month:'short', year:'numeric' }) %>
 </div>
 </div>
 </a>
 <% }) %>
 </div>
 <% } else { %>
 <p style="color:var(--gray-600); font-size:0.875rem; font-style:italic;">Belum ada dokumen yang disetujui</p>
 <% } %>
 </div>

 <!-- Payment History Card -->
 <div class="card" style="margin-bottom: 1.5rem;">
   <h3 style="color:var(--primary); font-size:0.75rem; text-transform:uppercase; letter-spacing:0.06em; margin-bottom:1rem;"> Riwayat Pembayaran Keuangan</h3>
   
   <% if (typeof paymentHistory !== 'undefined' && paymentHistory && ((paymentHistory.payments && paymentHistory.payments.length > 0) || (paymentHistory.credits && paymentHistory.credits.length > 0))) { %>
     <div style="overflow-x: auto;">
       <table style="width:100%; border-collapse:collapse; font-size:0.875rem; text-align:left;">
         <thead>
           <tr style="border-bottom:2px solid var(--gray-200); color:var(--gray-600);">
             <th style="padding:0.75rem 0.5rem;">Periode / Target</th>
             <th style="padding:0.75rem 0.5rem;">Total (Rp)</th>
             <th style="padding:0.75rem 0.5rem;">Tipe</th>
             <th style="padding:0.75rem 0.5rem;">Status</th>
             <th style="padding:0.75rem 0.5rem;">Tanggal</th>
           </tr>
         </thead>
         <tbody>
           <!-- Tampilkan Payments -->
           <% if (paymentHistory.payments && Array.isArray(paymentHistory.payments)) { %>
           <% paymentHistory.payments.forEach(p => { %>
             <tr style="border-bottom:1px solid var(--gray-100); hover:bg-slate-50;">
               <td style="padding:0.75rem 0.5rem; font-weight:600;"><%= p.period ? p.period.name : '-' %></td>
               <td style="padding:0.75rem 0.5rem; color:var(--primary);"><%= p.totalAmount.toLocaleString('id-ID') %></td>
               <td style="padding:0.75rem 0.5rem;">
                 <% if (p.paymentType === 'multi') { %>
                   <span style="font-size:0.7rem; background:#e0e7ff; color:#4338ca; padding:2px 6px; border-radius:4px; font-weight:bold;">MULTI</span>
                 <% } else { %>
                   <span style="font-size:0.7rem; background:#f1f5f9; color:#475569; padding:2px 6px; border-radius:4px; font-weight:bold;">BULANAN</span>
                 <% } %>
               </td>
               <td style="padding:0.75rem 0.5rem;">
                 <% if (p.status === 'approved') { %>
                   <span style="color:#16a34a; font-weight:600;">✓ Lunas</span>
                 <% } else if (p.status === 'pending') { %>
                   <span style="color:#d97706; font-weight:600;">⏳ Menunggu</span>
                 <% } else { %>
                   <span style="color:#dc2626; font-weight:600;">✕ Ditolak</span>
                 <% } %>
               </td>
               <td style="padding:0.75rem 0.5rem; color:var(--gray-500);"><%= p.createdAt ? new Date(p.createdAt).toLocaleDateString('id-ID') : '-' %></td>
             </tr>
           <% }) %>
           <% } %>

           <!-- Tampilkan Credits (Advance Payment yang belum ada periodenya) -->
           <% if (paymentHistory.credits && Array.isArray(paymentHistory.credits)) { %>
           <% paymentHistory.credits.forEach(c => { %>
             <tr style="border-bottom:1px solid var(--gray-100); background:#f8fafc;">
               <td style="padding:0.75rem 0.5rem; font-weight:600;">Bulan <%= c.targetMonth %> Tahun <%= c.targetYear %></td>
               <td style="padding:0.75rem 0.5rem; color:var(--gray-500);">(Menyesuaikan)</td>
               <td style="padding:0.75rem 0.5rem;">
                 <span style="font-size:0.7rem; background:#e0e7ff; color:#4338ca; padding:2px 6px; border-radius:4px; font-weight:bold;">ADVANCE / MULTI</span>
               </td>
               <td style="padding:0.75rem 0.5rem;">
                 <% if (c.status === 'pending') { %>
                   <span style="color:#2563eb; font-weight:600;">Menunggu Periode Dibuat</span>
                 <% } else { %>
                   <span style="color:#16a34a; font-weight:600;">Sudah Dikonversi</span>
                 <% } %>
               </td>
               <td style="padding:0.75rem 0.5rem; color:var(--gray-500);"><%= new Date(c.createdAt).toLocaleDateString('id-ID') %></td>
             </tr>
           <% }) %>
           <% } %>
         </tbody>
       </table>
     </div>
   <% } else { %>
     <p style="color:var(--gray-600); font-size:0.875rem; font-style:italic;">Belum ada riwayat pembayaran</p>
   <% } %>
 </div>

 <!-- Action Buttons -->
 <div class="form-actions" style="margin-top:2rem;">
 <% if (viewedUser.status === 'active') { %>
 <form action="/admin/users/<%= viewedUser.id %>/reset-password" method="POST" onsubmit="return confirm('Are you sure you want to reset this user\'s password? They will need to set a new one using a new activation link.');">
 <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
 <button type="submit" class="btn btn-secondary" style="color:var(--warning); border-color:var(--warning);">
 Reset Password
 </button>
 </form>
 <% } %>
 </div>

 </div>
 </main>
</div>
</body>
</html>

