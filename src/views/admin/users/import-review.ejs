<%- include('../_sidebar.ejs', { currentPage: 'users' }) %>

  <!-- MAIN CONTENT -->
  <main class="admin-main flex flex-col">
  <!-- TOP HEADER -->
  <header class="h-20 bg-white border-b border-slate-200 flex items-center justify-between px-6 flex-shrink-0 sticky top-0 z-40">
  <div class="flex items-center gap-4">
  <h2 class="font-display font-bold text-xl"><%= typeof title !== 'undefined' ? title : 'Review Bulk Import' %></h2>
  </div>

  <div class="flex items-center gap-4">
  <div class="flex items-center gap-2">
  <% if (typeof user !== 'undefined' && user && user.name) { %>
  <div class="w-8 h-8 rounded-full bg-brand-100 border border-slate-200 flex items-center justify-center text-brand-700 font-bold text-sm">
  <%= user.name.charAt(0).toUpperCase() %>
  </div>
  <span class="text-sm font-semibold hidden lg:block"><%= user.name %></span>
  <% } %>
  </div>
  </div>
  </header>

  <div class="p-6 lg:p-8 flex-1 overflow-y-auto">

  <!-- PAGE HEADER -->
  <div class="page-header mb-6">
  <div>
    <h1 class="text-2xl font-bold text-slate-900">Review Data Import Warga</h1>
    <p class="text-slate-500 text-sm mt-1">Periksa kembali data warga sebelum dimasukkan ke database. Anda dapat memilih baris mana saja yang akan di-import.</p>
  </div>
  <a href="/admin/users" class="btn btn-secondary flex items-center gap-1.5">
    <i data-lucide="arrow-left" class="w-4 h-4"></i> Batal & Kembali
  </a>
  </div>

  <% if (typeof error !== 'undefined' && error) { %>
  <div class="alert alert-error mb-6"><%= error %></div>
  <% } %>
  <% if (typeof success !== 'undefined' && success) { %>
  <div class="alert alert-success mb-6"><%= success %></div>
  <% } %>

  <!-- IMPORT INSTRUCTIONS CARD -->
  <div class="bg-amber-50 border-l-4 border-amber-500 p-4 rounded-r-xl mb-6 shadow-sm">
    <div class="flex gap-3">
      <i data-lucide="alert-triangle" class="text-amber-600 w-5 h-5 flex-shrink-0 mt-0.5"></i>
      <div>
        <h4 class="font-semibold text-sm text-amber-900">Petunjuk Verifikasi Data:</h4>
        <ul class="text-xs text-amber-800 list-disc list-inside space-y-1 mt-2">
          <li><strong>Data Baru (Green Badge)</strong>: Belum ada di database, tercentang secara default untuk langsung dimasukkan.</li>
          <li><strong>Data Sudah Ada (Amber Badge)</strong>: Nomor telepon sudah terdaftar di database. Defaultnya <strong>tidak tercentang</strong> (mempertahankan data database lama).</li>
          <li>Jika Anda <strong>mencentang</strong> data yang sudah ada, sistem akan <strong>menimpa (overwrite)</strong> nama & role warga tersebut di database dengan data yang baru di-upload.</li>
        </ul>
      </div>
    </div>
  </div>

  <form action="/admin/users/import/process" method="POST">
    <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">

    <div class="table-wrapper shadow-lg border border-slate-200 rounded-2xl overflow-hidden mb-6 bg-white">
      <table>
        <thead class="bg-slate-50 border-b border-slate-200">
          <tr>
            <th style="width:50px; text-align:center" class="py-4 px-4">
              <input type="checkbox" id="selectAllCheckbox" onchange="toggleSelectAll(this)" class="w-4 h-4 rounded text-brand-600 border-slate-300 focus:ring-brand-500 cursor-pointer">
            </th>
            <th class="py-4 px-4 text-xs font-bold text-slate-500 uppercase tracking-wider">No</th>
            <th class="py-4 px-4 text-xs font-bold text-slate-500 uppercase tracking-wider">Nama (Upload)</th>
            <th class="py-4 px-4 text-xs font-bold text-slate-500 uppercase tracking-wider">Telepon</th>
            <th class="py-4 px-4 text-xs font-bold text-slate-500 uppercase tracking-wider">No. Rumah (Upload)</th>
            <th class="py-4 px-4 text-xs font-bold text-slate-500 uppercase tracking-wider">Status Database</th>
            <th class="py-4 px-4 text-xs font-bold text-slate-500 uppercase tracking-wider">Data di Database Lama</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          <% reviewList.forEach((row, idx) => { %>
          <tr class="hover:bg-slate-50/80 transition-colors duration-150">
            <td style="text-align:center" class="py-4 px-4">
              <input type="checkbox" name="selectedRows" value="<%= row.index %>" 
                <%= !row.exists ? 'checked' : '' %>
                onchange="updateSelectAllState()"
                class="row-checkbox w-4 h-4 rounded text-brand-600 border-slate-300 focus:ring-brand-500 cursor-pointer">
            </td>
            <td class="py-4 px-4 text-sm text-slate-500"><%= idx + 1 %></td>
            <td class="py-4 px-4 text-sm font-semibold text-slate-900"><%= row.name %></td>
            <td class="py-4 px-4 text-sm text-slate-600 font-mono"><%= row.phone %></td>
            <td class="py-4 px-4 text-sm text-slate-600 font-medium">
              <%= row.houseNumber || '-' %>
            </td>
            <td class="py-4 px-4">
              <% if (!row.exists) { %>
                <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-medium bg-emerald-100 text-emerald-800 border border-emerald-200">
                  <span class="w-1.5 h-1.5 bg-emerald-500 rounded-full"></span>
                  Baru
                </span>
              <% } else { %>
                <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-medium bg-amber-100 text-amber-800 border border-amber-200">
                  <span class="w-1.5 h-1.5 bg-amber-500 rounded-full"></span>
                  Sudah Ada
                </span>
              <% } %>
            </td>
            <td class="py-4 px-4 text-xs text-slate-500">
              <% if (row.exists) { %>
                <div class="flex flex-col gap-0.5 bg-slate-50 p-2 rounded-lg border border-slate-100">
                  <span><strong class="text-slate-700">Nama:</strong> <%= row.dbName %></span>
                  <span><strong class="text-slate-700">No. Rumah:</strong> <%= row.dbHouseNumber || '-' %></span>
                  <span><strong class="text-slate-700">Role:</strong> <span class="capitalize"><%= row.dbRole.replace('_', ' ') %></span></span>
                </div>
              <% } else { %>
                <span class="text-slate-400 italic">-</span>
              <% } %>
            </td>
          </tr>
          <% }); %>
        </tbody>
      </table>
    </div>

    <!-- ACTIONS SECTION -->
    <div class="bg-white border border-slate-200 rounded-2xl p-6 flex flex-col md:flex-row md:items-center md:justify-between gap-4 shadow-sm">
      <div class="text-sm text-slate-500">
        Menampilkan <strong class="text-slate-900"><%= reviewList.length %></strong> baris data. 
        Pilih warga yang ingin di-import dengan mencentang checkbox.
      </div>
      <div class="flex gap-3 justify-end">
        <a href="/admin/users" class="btn btn-secondary">Batal</a>
        <button type="submit" class="btn btn-primary flex items-center gap-1.5 px-6 shadow-md">
          <i data-lucide="check" class="w-4 h-4"></i> Proses Import Warga
        </button>
      </div>
    </div>
  </form>

  </div>
  </main>

  <script>
    // Initial sync of select all checkbox state
    document.addEventListener("DOMContentLoaded", function() {
      updateSelectAllState();
    });

    function toggleSelectAll(master) {
      const checkboxes = document.querySelectorAll(".row-checkbox");
      checkboxes.forEach(cb => {
        cb.checked = master.checked;
      });
    }

    function updateSelectAllState() {
      const master = document.getElementById("selectAllCheckbox");
      const checkboxes = document.querySelectorAll(".row-checkbox");
      const checkedCount = document.querySelectorAll(".row-checkbox:checked").length;
      
      if (checkedCount === 0) {
        master.checked = false;
        master.indeterminate = false;
      } else if (checkedCount === checkboxes.length) {
        master.checked = true;
        master.indeterminate = false;
      } else {
        master.checked = false;
        master.indeterminate = true;
      }
    }
  </script>
