<%- include('../_sidebar.ejs', { currentPage: 'users' }) %>

  <!-- MAIN CONTENT -->
  <main class="admin-main">
    <div class="admin-content">

      <!-- PAGE HEADER -->
      <div class="page-header">
        <h1>👥 User Management</h1>
        <a href="/admin/users/create" class="btn btn-primary">
          + Add User
        </a>
      </div>

      <% if (typeof error !== 'undefined' && error) { %>
        <div class="alert alert-error"><%= error %></div>
      <% } %>
      <% if (typeof success !== 'undefined' && success) { %>
        <div class="alert alert-success"><%= success %></div>
      <% } %>

      <% if (users.length === 0) { %>
        <div class="card empty-state">
          <p>No users found.</p>
          <a href="/admin/users/create" class="btn btn-primary">Create first user</a>
        </div>
      <% } else { %>

        <div class="table-wrapper">
          <table>
            <thead>
              <tr>
                <th>Name</th>
                <th>Phone</th>
                <th>Status</th>
                <th>Roles</th>
                <th>Created</th>
                <th style="text-align:center">Actions</th>
              </tr>
            </thead>
            <tbody>
              <% users.forEach(u => { %>
                <tr>
                  <td style="font-weight:500; color:var(--gray-900)"><%= u.name %></td>
                  <td><%= u.phone %></td>
                  <td>
                    <span class="badge badge-<%= u.status %>">
                      <%= u.status %>
                    </span>
                  </td>
                  <td>
                    <% if (u.roles.length > 0) { %>
                      <%= u.roles.map(ur => ur.role.name).join(', ') %>
                    <% } else { %>
                      <span style="color:var(--gray-600); font-style:italic">No roles</span>
                    <% } %>
                  </td>
                  <td><%= new Date(u.createdAt).toLocaleDateString('id-ID') %></td>
                  <td style="text-align:center">
                    <a href="/admin/users/<%= u.id %>" class="btn btn-secondary btn-sm">
                      View
                    </a>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>

        <!-- Pagination -->
        <% if (totalPages > 1) { %>
          <div class="pagination">
            <% for (let page = 1; page <= totalPages; page++) { %>
              <% if (page === currentPage) { %>
                <span class="current"><%= page %></span>
              <% } else { %>
                <a href="/admin/users?page=<%= page %>"><%= page %></a>
              <% } %>
            <% } %>
          </div>
        <% } %>

      <% } %>

      <div style="margin-top: 2rem;">
        <a href="/admin" class="btn btn-secondary">← Back to Dashboard</a>
      </div>

    </div>
  </main>
</div>
</body>
</html>
