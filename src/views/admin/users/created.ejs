<%- include('../_sidebar.ejs', { currentPage: 'users' }) %>

 <!-- MAIN CONTENT -->
 <main class="admin-main flex flex-col">
 <!-- TOP HEADER -->
 <header class="h-20 bg-white border-b border-slate-200 flex items-center justify-between px-6 flex-shrink-0 sticky top-0 z-40">
 <div class="flex items-center gap-4">
 <h2 class="font-display font-bold text-xl"><%= typeof title !== 'undefined' ? title : 'Admin Panel' %></h2>
 </div>

 <div class="flex items-center gap-4">
 <a href="/admin/messages" class="p-2 text-slate-500 hover:bg-slate-100 rounded-full transition-colors relative">
 <i data-lucide="bell" class="w-5 h-5"></i>
 <% if (typeof unreadMessages !== 'undefined' && unreadMessages > 0) { %>
 <span class="absolute top-2 right-2 w-2 h-2 bg-red-500 rounded-full border-2 border-white"></span>
 <% } %>
 </a>
 <div class="h-8 w-px bg-slate-200 mx-1"></div>
 <div class="flex items-center gap-2">
 <% if (typeof user !== 'undefined' && user && user.name) { %>
 <div class="w-8 h-8 rounded-full bg-brand-100 border border-slate-200 flex items-center justify-center text-brand-700 font-bold text-sm">
 <%= user.name.charAt(0).toUpperCase() %>
 </div>
 <span class="text-sm font-semibold hidden lg:block"><%= user.name %></span>
 <% } %>
 </div>
 </div>
 </header>
 <div class="p-6 lg:p-8 flex-1 overflow-y-auto">

 <div class="page-header">
 <h1> User Created Successfully</h1>
 <a href="/admin/users" class="btn btn-secondary">← User List</a>
 </div>

 <!-- Success Banner -->
 <div class="alert" style="background:#DCFCE7; border-left-color:var(--success); color:#166534; margin-bottom:1.5rem;">
 User <strong><%= user.name %></strong> has been created with phone <strong><%= user.phone %></strong>.
 </div>

 <!-- Activation Link Card -->
 <div class="card" style="margin-bottom:1.5rem;">
 <h2 style="margin-bottom:0.75rem; font-size:1rem;">Activation Link</h2>
 <p>Share this link with the user so they can activate their account and set a password:</p>

 <div style="background:var(--gray-100); border:1px solid var(--gray-300); border-radius:6px; padding:1rem; margin-bottom:1rem; word-break:break-all;">
 <code style="color:var(--gray-900); font-size:0.875rem;"><%= activationLink %></code>
 </div>

 <p style="font-size:0.875rem; margin:0;">
 <strong>Token (first 16 chars):</strong>
 <code style="background:var(--gray-100); color:var(--gray-600);"><%= activationToken.substring(0, 16) %>...</code>
 </p>

 <div class="alert" style="background:#FEF3C7; border-left-color:var(--warning); color:#92400E; margin-top:1rem; margin-bottom:0;">
 <strong> Important:</strong> This link will expire in 24 hours and is one-time use only.
 </div>
 </div>

 <!-- Next Steps Card -->
 <div class="card" style="margin-bottom:1.5rem;">
 <h2 style="margin-bottom:0.75rem; font-size:1rem;">Next Steps</h2>
 <ol style="color:var(--gray-700); line-height:2; padding-left:1.25rem;">
 <li>Send the activation link to the user</li>
 <li>User clicks the link and sets their password</li>
 <li>User's account status automatically changes to <strong>ACTIVE</strong></li>
 <li>User can then log in with their phone and password</li>
 </ol>
 </div>

 <!-- Actions -->
 <div class="form-actions">
 <a href="/admin/users" class="btn btn-primary">Back to User List</a>
 <a href="/admin/users/create" class="btn btn-secondary">Create Another User</a>
 </div>

 </div>
 </main>
</div>
</body>
</html>

