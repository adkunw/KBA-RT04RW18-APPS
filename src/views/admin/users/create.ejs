<%- include('../_sidebar.ejs', { currentPage: 'users' }) %>

 <!-- MAIN CONTENT -->
 <main class="admin-main flex flex-col">
 <!-- TOP HEADER -->
 <header class="h-20 bg-white border-b border-slate-200 flex items-center justify-between px-6 flex-shrink-0 sticky top-0 z-40">
 <div class="flex items-center gap-4">
 <h2 class="font-display font-bold text-xl"><%= typeof title !== 'undefined' ? title : 'Admin Panel' %></h2>
 </div>

 <div class="flex items-center gap-4">
 <a href="/admin/messages" class="p-2 text-slate-500 hover:bg-slate-100 rounded-full transition-colors relative">
 <i data-lucide="bell" class="w-5 h-5"></i>
 <% if (typeof unreadMessages !== 'undefined' && unreadMessages > 0) { %>
 <span class="absolute top-2 right-2 w-2 h-2 bg-red-500 rounded-full border-2 border-white"></span>
 <% } %>
 </a>
 <div class="h-8 w-px bg-slate-200 mx-1"></div>
 <div class="flex items-center gap-2">
 <% if (typeof user !== 'undefined' && user && user.name) { %>
 <div class="w-8 h-8 rounded-full bg-brand-100 border border-slate-200 flex items-center justify-center text-brand-700 font-bold text-sm">
 <%= user.name.charAt(0).toUpperCase() %>
 </div>
 <span class="text-sm font-semibold hidden lg:block"><%= user.name %></span>
 <% } %>
 </div>
 </div>
 </header>
 <div class="p-6 lg:p-8 flex-1 overflow-y-auto">

 <div class="page-header">
 <h1>+ Create New User</h1>
 <a href="/admin/users" class="btn btn-secondary">← Back to Users</a>
 </div>

 <% if (typeof error !== 'undefined' && error) { %>
 <div class="alert alert-error"><%= error %></div>
 <% } %>

 <div style="max-width: 560px;">
 <form method="POST" action="/admin/users" style="display:flex; flex-direction:column; gap:0;">
 <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">

 <div class="card" style="margin-bottom: 1.5rem;">
 <div class="form-group">
 <label for="name">Full Name</label>
 <input type="text" id="name" name="name" required autofocus placeholder="Enter user's full name">
 </div>

 <div class="form-group">
 <label for="phone">Phone Number</label>
 <input type="text" id="phone" name="phone" required placeholder="e.g., 08123456789">
 </div>

 <div class="form-group" style="margin-bottom:0;">
 <label for="roleId">Assign Role</label>
 <select id="roleId" name="roleId" required>
 <option value="">-- Select a role --</option>
 <% roles.forEach(role => { %>
 <option value="<%= role.id %>"><%= role.name %></option>
 <% }); %>
 </select>
 </div>
 </div>

 <div class="info-box" style="margin-bottom: 1.5rem;">
 <strong> Note:</strong> After creating the user, you'll receive an activation link to share with them.
 The user will use this link to set their password and activate their account.
 </div>

 <div class="form-actions">
 <button type="submit" class="btn btn-primary" style="flex:1;">Create User</button>
 <a href="/admin/users" class="btn btn-secondary" style="flex:1; text-align:center;">Cancel</a>
 </div>
 </form>
 </div>

 </div>
 </main>
</div>
</body>
</html>
