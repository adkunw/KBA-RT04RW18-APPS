<%- include('../_sidebar.ejs', { currentPage: 'users' }) %>

 <!-- MAIN CONTENT -->
 <main class="admin-main flex flex-col">
 <!-- TOP HEADER -->
 <header class="h-20 bg-white border-b border-slate-200 flex items-center justify-between px-6 flex-shrink-0 sticky top-0 z-40">
 <div class="flex items-center gap-4">
 <h2 class="font-display font-bold text-xl"><%= typeof title !== 'undefined' ? title : 'Admin Panel' %></h2>
 </div>

 <div class="flex items-center gap-4">
 <a href="/admin/messages" class="p-2 text-slate-500 hover:bg-slate-100 rounded-full transition-colors relative">
 <i data-lucide="bell" class="w-5 h-5"></i>
 <% if (typeof unreadMessages !== 'undefined' && unreadMessages > 0) { %>
 <span class="absolute top-2 right-2 w-2 h-2 bg-red-500 rounded-full border-2 border-white"></span>
 <% } %>
 </a>
 <div class="h-8 w-px bg-slate-200 mx-1"></div>
 <div class="flex items-center gap-2">
 <% if (typeof user !== 'undefined' && user && user.name) { %>
 <div class="w-8 h-8 rounded-full bg-brand-100 border border-slate-200 flex items-center justify-center text-brand-700 font-bold text-sm">
 <%= user.name.charAt(0).toUpperCase() %>
 </div>
 <span class="text-sm font-semibold hidden lg:block"><%= user.name %></span>
 <% } %>
 </div>
 </div>
 </header>
 <div class="p-6 lg:p-8 flex-1 overflow-y-auto">

 <div class="page-header">
 <h1> Edit User: <%= editUser.name %></h1>
 <a href="/admin/users/<%= editUser.id %>" class="btn btn-secondary">← Back to Profile</a>
 </div>

 <% if (error) { %>
 <div class="alert alert-error"><%= error %></div>
 <% } %>

 <div class="card" style="max-width: 640px; margin-bottom: 2rem;">
 <form method="POST" action="/admin/users/<%= editUser.id %>/edit" style="display:flex; flex-direction:column; gap:1.25rem;">
 <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">

 <div class="form-group">
 <label for="name">Full Name</label>
 <input type="text" id="name" name="name" value="<%= editUser.name %>" required autofocus>
 </div>

 <div class="form-group">
 <label for="phone">Phone Number (Login ID)</label>
 <input type="text" id="phone" name="phone" value="<%= editUser.phone %>" required>
 </div>

 <div class="form-group">
 <label for="houseNumber">Nomor Rumah</label>
 <input type="text" id="houseNumber" name="houseNumber" value="<%= editUser.houseNumber || '' %>" placeholder="Contoh: Blok C No. 42">
 </div>

  <div style="background:#f8fafc; border:1px solid var(--gray-200); border-radius:12px; padding:1.25rem; display:flex; flex-direction:column; gap:1.25rem; margin-top: 0.5rem;">
    <h3 style="font-size:0.95rem; color:var(--gray-800); margin:0; display:flex; items-center; gap:0.5rem; font-weight: 700;">
      👤 Data Diri Warga
    </h3>
    
    <div style="display:grid; grid-template-columns: 1fr 1fr 1fr; gap:1rem;">
      <div class="form-group" style="margin-bottom:0;">
        <label for="birthDate">Tanggal Lahir Warga</label>
        <input type="date" id="birthDate" name="birthDate" value="<%= editUser.birthDate || '' %>" style="width:100%; padding:0.625rem; border:1px solid var(--gray-300); border-radius:6px; font-family:inherit; font-size:0.875rem;">
      </div>
      <div class="form-group" style="margin-bottom:0;">
        <label for="nik">NIK Warga (Optional)</label>
        <input type="text" id="nik" name="nik" value="<%= editUser.nik || '' %>" placeholder="16 digit NIK" style="width:100%; padding:0.625rem; border:1px solid var(--gray-300); border-radius:6px; font-family:inherit; font-size:0.875rem;">
      </div>
      <div class="form-group" style="margin-bottom:0;">
        <label for="kkNumber">Nomor KK (Optional)</label>
        <input type="text" id="kkNumber" name="kkNumber" value="<%= editUser.kkNumber || '' %>" placeholder="16 digit No. KK" style="width:100%; padding:0.625rem; border:1px solid var(--gray-300); border-radius:6px; font-family:inherit; font-size:0.875rem;">
      </div>
    </div>
  </div>

  <div style="background:#f8fafc; border:1px solid var(--gray-200); border-radius:12px; padding:1.25rem; display:flex; flex-direction:column; gap:1.25rem; margin-top: 0.5rem;">
    <h3 style="font-size:0.95rem; color:var(--gray-800); margin:0; display:flex; items-center; gap:0.5rem; font-weight: 700;">
      👩‍❤️‍👨 Data Pasangan (Suami / Istri)
    </h3>
    
    <div class="form-group" style="margin-bottom:0;">
      <label for="spouseName">Nama Pasangan</label>
      <input type="text" id="spouseName" name="spouseName" value="<%= editUser.spouseName || '' %>" placeholder="Nama lengkap pasangan" style="width:100%; padding:0.625rem; border:1px solid var(--gray-300); border-radius:6px; font-family:inherit; font-size:0.875rem;">
    </div>

    <div style="display:grid; grid-template-columns: 1fr 1fr; gap:1rem;">
      <div class="form-group" style="margin-bottom:0;">
        <label for="spousePhone">Nomor Telepon Pasangan</label>
        <input type="text" id="spousePhone" name="spousePhone" value="<%= editUser.spousePhone || '' %>" placeholder="Contoh: 0812..." style="width:100%; padding:0.625rem; border:1px solid var(--gray-300); border-radius:6px; font-family:inherit; font-size:0.875rem;">
      </div>
      <div class="form-group" style="margin-bottom:0;">
        <label for="spouseBirthDate">Tanggal Lahir Pasangan</label>
        <input type="date" id="spouseBirthDate" name="spouseBirthDate" value="<%= editUser.spouseBirthDate || '' %>" style="width:100%; padding:0.625rem; border:1px solid var(--gray-300); border-radius:6px; font-family:inherit; font-size:0.875rem;">
      </div>
    </div>

    <div class="form-group" style="margin-bottom:0;">
      <label for="spouseNik">NIK Pasangan (Optional)</label>
      <input type="text" id="spouseNik" name="spouseNik" value="<%= editUser.spouseNik || '' %>" placeholder="16 digit NIK pasangan" style="width:100%; padding:0.625rem; border:1px solid var(--gray-300); border-radius:6px; font-family:inherit; font-size:0.875rem;">
    </div>
  </div>

  <div style="background:#f8fafc; border:1px solid var(--gray-200); border-radius:12px; padding:1.25rem; display:flex; flex-direction:column; gap:1.25rem; margin-top: 0.5rem;">
    <div style="display:flex; justify-content:space-between; align-items:center;">
      <h3 style="font-size:0.95rem; color:var(--gray-800); margin:0; display:flex; align-items:center; gap:0.5rem; font-weight: 700;">
        👶 Data Anak
      </h3>
      <button type="button" id="add-child-btn" style="background:var(--primary); color:white; border:none; padding:0.4rem 0.8rem; border-radius:6px; font-size:0.75rem; font-weight:600; cursor:pointer; display:flex; align-items:center; gap:0.25rem; transition:all 0.2s;">
        ➕ Tambah Anak
      </button>
    </div>
    
    <div id="children-container" style="display:flex; flex-direction:column; gap:1rem;">
      <!-- Dynamic children input cards will be mounted here -->
    </div>
  </div>

 <div class="form-group">
 <label for="status">Account Status</label>
 <select id="status" name="status" required>
 <option value="created" <%= editUser.status === 'created' ? 'selected' : '' %>>Created (Pending Activation)</option>
 <option value="active" <%= editUser.status === 'active' ? 'selected' : '' %>>Active</option>
 <option value="inactive" <%= editUser.status === 'inactive' ? 'selected' : '' %>>Inactive</option>
 <option value="blocked" <%= editUser.status === 'blocked' ? 'selected' : '' %>>Blocked</option>
 </select>
 </div>

 <div class="form-group">
 <label for="roleId">Assigned Role</label>
 <select id="roleId" name="roleId" required>
 <% 
 const currentRoleId = editUser.roles.length > 0 ? editUser.roles[0].roleId : '';
 %>
 <option value="">-- Select a role --</option>
 <% roles.forEach(role => { %>
 <option value="<%= role.id %>" <%= role.id === currentRoleId ? 'selected' : '' %>><%= role.name %></option>
 <% }); %>
 </select>
 <small style="color:var(--gray-500); display:block; margin-top:0.25rem;">Changing the role will replace any existing roles.</small>
 </div>

 <div class="form-actions" style="margin-top:0.5rem;">
 <button type="submit" class="btn btn-primary">Save Changes</button>
 <a href="/admin/users/<%= editUser.id %>" class="btn btn-secondary">Cancel</a>
 </div>
 </form>
 </div>

 </div>
 </main>
</div>
<script>
  document.addEventListener("DOMContentLoaded", function() {
    const childrenData = <%- JSON.stringify(editUser.children || []) %>;
    const container = document.getElementById("children-container");
    const addBtn = document.getElementById("add-child-btn");

    function createChildRow(child = { name: '', birthDate: '', nik: '' }) {
      const row = document.createElement("div");
      row.className = "child-row";
      row.style.cssText = "background:white; border:1px solid var(--gray-200); border-radius:8px; padding:1rem; position:relative; display:flex; flex-direction:column; gap:0.75rem;";
      
      row.innerHTML = `
        <button type="button" class="remove-child-btn" style="position:absolute; top:0.75rem; right:0.75rem; background:#fee2e2; color:#ef4444; border:none; padding:0.25rem 0.5rem; border-radius:4px; font-size:0.7rem; font-weight:600; cursor:pointer;">
          ✕ Hapus
        </button>
        <div class="form-group" style="margin-bottom:0;">
          <label style="font-size:0.75rem; font-weight:600; color:var(--gray-600); margin-bottom:0.25rem; display:block;">Nama Anak</label>
          <input type="text" name="childName" value="${child.name || ''}" placeholder="Nama lengkap anak" required style="width:100%; padding:0.5rem; border:1px solid var(--gray-300); border-radius:6px; font-family:inherit; font-size:0.875rem;">
        </div>
        <div style="display:grid; grid-template-columns: 1fr 1fr; gap:0.75rem;">
          <div class="form-group" style="margin-bottom:0;">
            <label style="font-size:0.75rem; font-weight:600; color:var(--gray-600); margin-bottom:0.25rem; display:block;">Tanggal Lahir</label>
            <input type="date" name="childBirthDate" value="${child.birthDate || ''}" style="width:100%; padding:0.5rem; border:1px solid var(--gray-300); border-radius:6px; font-family:inherit; font-size:0.875rem;">
          </div>
          <div class="form-group" style="margin-bottom:0;">
            <label style="font-size:0.75rem; font-weight:600; color:var(--gray-600); margin-bottom:0.25rem; display:block;">NIK (Optional)</label>
            <input type="text" name="childNik" value="${child.nik || ''}" placeholder="16 digit NIK anak" style="width:100%; padding:0.5rem; border:1px solid var(--gray-300); border-radius:6px; font-family:inherit; font-size:0.875rem;">
          </div>
        </div>
      `;

      row.querySelector(".remove-child-btn").addEventListener("click", function() {
        row.remove();
        updateEmptyState();
      });

      container.appendChild(row);
      updateEmptyState();
    }

    function updateEmptyState() {
      const existingRows = container.querySelectorAll(".child-row");
      const emptyStateId = "children-empty-state";
      let emptyState = document.getElementById(emptyStateId);
      
      if (existingRows.length === 0) {
        if (!emptyState) {
          emptyState = document.createElement("p");
          emptyState.id = emptyStateId;
          emptyState.style.cssText = "color:var(--gray-500); font-size:0.875rem; font-style:italic; margin:0; text-align:center; padding:1rem 0;";
          emptyState.textContent = "Belum ada data anak. Klik 'Tambah Anak' di atas untuk menambah.";
          container.appendChild(emptyState);
        }
      } else {
        if (emptyState) {
          emptyState.remove();
        }
      }
    }

    // Populate existing children
    if (childrenData && childrenData.length > 0) {
      childrenData.forEach(child => createChildRow(child));
    } else {
      updateEmptyState();
    }

    addBtn.addEventListener("click", function() {
      createChildRow();
    });
  });
</script>
</body>
</html>
