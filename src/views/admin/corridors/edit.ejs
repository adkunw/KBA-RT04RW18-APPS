<%- include('../_sidebar.ejs', { currentPage: 'corridors' }) %>

<!-- MAIN CONTENT -->
<main class="admin-main flex flex-col">
  <header class="h-20 bg-white border-b border-slate-200 flex items-center justify-between px-6 flex-shrink-0 sticky top-0 z-40">
    <div class="flex items-center gap-4">
      <h2 class="font-display font-bold text-xl">Manajemen Koridor</h2>
    </div>
    <div class="flex items-center gap-4">
      <div class="flex items-center gap-2">
        <% if (typeof user !== 'undefined' && user && user.name) { %>
          <div class="w-8 h-8 rounded-full bg-brand-100 border border-slate-200 flex items-center justify-center text-brand-700 font-bold text-sm">
            <%= user.name.charAt(0).toUpperCase() %>
          </div>
          <span class="text-sm font-semibold hidden lg:block"><%= user.name %></span>
        <% } %>
      </div>
    </div>
  </header>

  <div class="p-6 lg:p-8 flex-1 overflow-y-auto bg-slate-50">
    <% if (typeof error_msg !== 'undefined' && error_msg.length > 0) { %>
      <div class="mb-6 p-4 rounded-2xl bg-red-50 border border-red-100 text-red-700 text-sm font-medium flex gap-3 items-start">
        <i data-lucide="alert-circle" class="w-5 h-5 flex-shrink-0 mt-0.5 text-red-500"></i>
        <span><%= error_msg %></span>
      </div>
    <% } %>

    <div class="mb-6 flex items-center justify-between">
  <div>
    <h1 class="text-2xl font-bold text-gray-900">Edit Koridor</h1>
    <p class="text-sm text-gray-500">Ubah detail data koridor</p>
  </div>
  <a href="/admin/corridors" class="text-sm font-medium text-gray-500 hover:text-gray-900">
    &larr; Kembali ke Daftar
  </a>
</div>

<div class="max-w-2xl rounded-xl border border-gray-200 bg-white p-6 shadow-sm">
  <form action="/admin/corridors/<%= corridor.id %>/edit" method="POST" class="space-y-6">
    <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">

    <div>
      <label for="name" class="mb-1 block text-sm font-medium text-gray-700">
        Nama Koridor <span class="text-red-500">*</span>
      </label>
      <input type="text" id="name" name="name" value="<%= corridor.name %>" required placeholder="Contoh: G Bawah"
        class="block w-full rounded-lg border border-gray-300 px-4 py-2.5 text-gray-900 focus:border-brand-500 focus:ring-brand-500 sm:text-sm">
      <p class="mt-1 text-xs text-gray-500">Nama harus unik dan merepresentasikan wilayah spesifik.</p>
    </div>

    <div>
      <label for="description" class="mb-1 block text-sm font-medium text-gray-700">
        Deskripsi (Opsional)
      </label>
      <textarea id="description" name="description" rows="3" placeholder="Informasi detail mengenai koridor ini..."
        class="block w-full rounded-lg border border-gray-300 px-4 py-2.5 text-gray-900 focus:border-brand-500 focus:ring-brand-500 sm:text-sm"><%= corridor.description || '' %></textarea>
    </div>

    <div class="flex justify-end pt-4">
      <button type="submit" class="inline-flex items-center justify-center rounded-lg bg-brand-600 px-6 py-2.5 text-sm font-medium text-white transition-colors hover:bg-brand-700 focus:outline-none focus:ring-2 focus:ring-brand-500 focus:ring-offset-2">
        <i data-lucide="save" class="mr-2 h-4 w-4"></i>
        Simpan Perubahan
      </button>
    </div>
  </form>
</div>
  </div>
</main>
</div>
</body>
</html>
