<%- include('../_sidebar.ejs', { currentPage: 'finance' }) %>

<!-- MAIN CONTENT -->
<main class="admin-main flex flex-col">
  
  <!-- TOP HEADER -->
  <header class="h-20 bg-white border-b border-slate-200 flex items-center justify-between px-6 flex-shrink-0 sticky top-0 z-40">
    <div class="flex items-center gap-4">
      <h2 class="font-display font-bold text-xl">Keuangan & Iuran</h2>
    </div>

    <!-- Right Side Actions & Avatar -->
    <div class="flex items-center gap-4">
      <a href="/admin/messages" class="p-2 text-slate-500 hover:bg-slate-100 rounded-full transition-colors relative">
        <i data-lucide="bell" class="w-5 h-5"></i>
        <% if (typeof unreadMessages !== 'undefined' && unreadMessages > 0) { %>
          <span class="absolute top-2 right-2 w-2.5 h-2.5 bg-red-500 rounded-full border border-white"></span>
        <% } %>
      </a>
      <div class="h-8 w-px bg-slate-200 mx-1"></div>
      <div class="flex items-center gap-2">
        <% if (typeof user !== 'undefined' && user && user.name) { %>
          <div class="w-8 h-8 rounded-full bg-brand-100 border border-slate-200 flex items-center justify-center text-brand-700 font-bold text-sm">
            <%= user.name.charAt(0).toUpperCase() %>
          </div>
          <span class="text-sm font-semibold hidden lg:block"><%= user.name %></span>
        <% } %>
      </div>
    </div>
  </header>

  <!-- INNER CONTENT -->
  <div class="p-6 lg:p-8 flex-1 overflow-y-auto space-y-6">
    
    <!-- PAGE HEADER -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
      <div>
        <h1 class="text-2xl font-bold tracking-tight text-slate-900 font-display">
          Pengelolaan Keuangan 
          <% if (hasGlobalFinance) { %>
            <select onchange="window.location.href='?corridorId=' + this.value" class="ml-2 inline-block rounded-lg border-slate-300 text-lg font-bold py-1 pl-3 pr-8 focus:ring-brand-500 focus:border-brand-500">
              <option value="">RT</option>
              <% corridors.forEach(c => { %>
                <option value="<%= c.id %>" <%= filterCorridorId === c.id ? 'selected' : '' %>>Koridor <%= c.name %></option>
              <% }) %>
            </select>
          <% } else { %>
            Koridor
          <% } %>
        </h1>
        <p class="text-sm text-slate-500 mt-1">Pantau rekap kas warga, kelola periode iuran bulanan, catat pemasukan lain, dan pengeluaran <%= hasGlobalFinance && !filterCorridorId ? 'RT' : 'Koridor' %>.</p>
      </div>
      <div class="flex flex-wrap gap-3">
        <button type="button" onclick="openIncomeModal()" class="btn bg-emerald-600 text-white hover:bg-emerald-700 flex items-center gap-2 py-2.5 px-4 rounded-xl font-bold shadow-sm transition-all duration-200">
          <i data-lucide="plus-circle" class="w-4 h-4 text-white"></i> Catat Pemasukan Lain
        </button>
        <button type="button" onclick="openExpenseModal()" class="btn bg-slate-900 text-white hover:bg-slate-800 flex items-center gap-2 py-2.5 px-4 rounded-xl font-bold shadow-sm transition-all duration-200">
          <i data-lucide="minus-circle" class="w-4 h-4 text-rose-450"></i> Catat Pengeluaran Baru
        </button>
      </div>
    </div>

    <!-- FLASH MESSAGES -->
    <% if (typeof error !== 'undefined' && error) { %>
      <div class="p-4 rounded-2xl bg-red-50 border border-red-100 text-red-700 text-sm font-medium flex gap-3 items-start animate-in fade-in slide-in-from-top-4 duration-200">
        <i data-lucide="alert-circle" class="w-5 h-5 flex-shrink-0 mt-0.5 text-red-500"></i>
        <span><%= error %></span>
      </div>
    <% } %>
    <% if (typeof success !== 'undefined' && success) { %>
      <div class="p-4 rounded-2xl bg-emerald-50 border border-emerald-100 text-emerald-700 text-sm font-medium flex gap-3 items-start animate-in fade-in slide-in-from-top-4 duration-200">
        <i data-lucide="check-circle" class="w-5 h-5 flex-shrink-0 mt-0.5 text-emerald-500"></i>
        <span><%= success %></span>
      </div>
    <% } %>

    <!-- 📊 FINANCIAL SUMMARY CARDS -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <!-- CARD 1: INCOME -->
      <div class="bg-gradient-to-br from-emerald-500 to-teal-600 rounded-3xl p-6 text-white shadow-lg border border-emerald-400/20 relative overflow-hidden group">
        <div class="absolute -right-4 -bottom-4 opacity-10 group-hover:scale-110 transition-transform duration-300">
          <i data-lucide="arrow-down-left" class="w-32 h-32"></i>
        </div>
        <div class="flex items-center justify-between mb-4">
          <span class="text-emerald-100 text-xs font-bold uppercase tracking-wider">Total Pemasukan</span>
          <div class="w-10 h-10 rounded-xl bg-white/10 backdrop-blur-sm flex items-center justify-center">
            <i data-lucide="arrow-down-left" class="w-5 h-5 text-emerald-200"></i>
          </div>
        </div>
        <h2 class="text-3xl font-extrabold tracking-tight">Rp <%= summary.totalIncome.toLocaleString('id-ID') %></h2>
        <p class="text-emerald-100 text-[11px] mt-2 font-medium">Akumulasi iuran bulanan + pemasukan lain disetujui</p>
      </div>

      <!-- CARD 2: EXPENSES -->
      <div class="bg-gradient-to-br from-rose-500 to-red-650 rounded-3xl p-6 text-white shadow-lg border border-rose-400/20 relative overflow-hidden group">
        <div class="absolute -right-4 -bottom-4 opacity-10 group-hover:scale-110 transition-transform duration-300">
          <i data-lucide="arrow-up-right" class="w-32 h-32"></i>
        </div>
        <div class="flex items-center justify-between mb-4">
          <span class="text-rose-100 text-xs font-bold uppercase tracking-wider">Total Pengeluaran</span>
          <div class="w-10 h-10 rounded-xl bg-white/10 backdrop-blur-sm flex items-center justify-center">
            <i data-lucide="arrow-up-right" class="w-5 h-5 text-rose-200"></i>
          </div>
        </div>
        <h2 class="text-3xl font-extrabold tracking-tight">Rp <%= summary.totalExpense.toLocaleString('id-ID') %></h2>
        <p class="text-rose-100 text-[11px] mt-2 font-medium">Total dana kas dikeluarkan & dicatat</p>
      </div>

      <!-- CARD 3: BALANCE -->
      <div class="bg-gradient-to-br from-indigo-600 to-blue-600 rounded-3xl p-6 text-white shadow-lg border border-indigo-400/20 relative overflow-hidden group">
        <div class="absolute -right-4 -bottom-4 opacity-10 group-hover:scale-110 transition-transform duration-300">
          <i data-lucide="wallet" class="w-32 h-32"></i>
        </div>
        <div class="flex items-center justify-between mb-4">
          <span class="text-indigo-100 text-xs font-bold uppercase tracking-wider">Saldo Kas RT</span>
          <div class="w-10 h-10 rounded-xl bg-white/10 backdrop-blur-sm flex items-center justify-center">
            <i data-lucide="wallet" class="w-5 h-5 text-indigo-200"></i>
          </div>
        </div>
        <h2 class="text-3xl font-extrabold tracking-tight">Rp <%= summary.balance.toLocaleString('id-ID') %></h2>
        <p class="text-indigo-100 text-[11px] mt-2 font-medium">Sisa saldo keuangan aktif saat ini</p>
      </div>
    </div>

    <!-- 🔍 SEARCH MUTATION BAR -->
    <div class="bg-white rounded-3xl p-5 border border-slate-200 shadow-sm flex flex-col xl:flex-row items-center justify-between gap-4">
      <div class="flex items-center gap-3 w-full xl:max-w-md">
        <div class="relative w-full">
          <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none">
            <i data-lucide="search" class="h-4 w-4 text-slate-400"></i>
          </span>
          <input type="text" id="mutationSearch" onkeyup="filterMutations()" placeholder="Cari rincian pengeluaran, pemasukan, penerima, atau sumber..." class="block w-full pl-10 pr-4 py-2.5 border border-slate-300 rounded-xl text-sm focus:ring-2 focus:ring-brand-500 focus:border-brand-500 bg-slate-50/50 hover:bg-slate-50 transition-colors">
        </div>
      </div>

      <!-- Live Date Range Filter -->
      <div class="flex flex-wrap items-center gap-3 w-full xl:w-auto">
        <div class="flex items-center gap-2 text-xs font-semibold text-slate-600">
          <i data-lucide="calendar-range" class="w-4 h-4 text-brand-600"></i>
          <span>Filter Tanggal:</span>
        </div>
        <div class="flex items-center gap-2">
          <input type="date" id="filterStartDate" onchange="filterMutations()" class="p-2 border border-slate-300 rounded-xl text-xs focus:ring-2 focus:ring-brand-500 focus:border-brand-500 bg-slate-50/50">
          <span class="text-xs text-slate-400 font-bold">s/d</span>
          <input type="date" id="filterEndDate" onchange="filterMutations()" class="p-2 border border-slate-300 rounded-xl text-xs focus:ring-2 focus:ring-brand-500 focus:border-brand-500 bg-slate-50/50">
        </div>
        <button type="button" onclick="resetLiveFilters()" class="px-3 py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold text-xs rounded-xl border border-slate-200 transition-colors flex items-center gap-1">
          <i data-lucide="rotate-ccw" class="w-3.5 h-3.5"></i> Reset
        </button>
      </div>
    </div>

    <!-- 📅 EKSPOR LAPORAN KEUANGAN -->
    <div class="bg-white rounded-3xl p-6 border border-slate-200 shadow-sm space-y-5">
      <div class="flex items-center justify-between border-b border-slate-100 pb-3">
        <h3 class="font-bold text-base text-slate-900 flex items-center gap-2 font-display">
          <i data-lucide="download-cloud" class="w-5 h-5 text-indigo-600"></i> Ekspor Laporan Keuangan <%= hasGlobalFinance ? 'RT' : 'Koridor' %>
        </h3>
        <span class="bg-indigo-50 text-indigo-700 text-xs font-bold px-3 py-1 rounded-full border border-indigo-100">Format Excel/CSV</span>
      </div>
      <form action="/admin/finance/export" method="GET" class="grid grid-cols-1 md:grid-cols-3 gap-4 items-end">
        <% if (filterCorridorId) { %>
          <input type="hidden" name="corridorId" value="<%= filterCorridorId %>">
        <% } %>
        <div class="space-y-1.5">
          <label class="block text-xs font-semibold text-slate-700">Tanggal Mulai</label>
          <input type="date" name="startDate" id="exportStartDate" required class="block w-full p-2.5 border border-slate-300 rounded-xl text-sm focus:ring-2 focus:ring-brand-500 focus:border-brand-500 bg-slate-50/50">
        </div>
        <div class="space-y-1.5">
          <label class="block text-xs font-semibold text-slate-700">Tanggal Akhir</label>
          <input type="date" name="endDate" id="exportEndDate" required class="block w-full p-2.5 border border-slate-300 rounded-xl text-sm focus:ring-2 focus:ring-brand-500 focus:border-brand-500 bg-slate-50/50">
        </div>
        <button type="submit" class="w-full btn bg-indigo-600 hover:bg-indigo-700 text-white font-bold py-2.5 px-4 rounded-xl flex items-center justify-center gap-2 shadow-sm transition-all duration-200 h-[42px] leading-none">
          <i data-lucide="download-cloud" class="w-4.5 h-4.5"></i> Unduh Laporan (CSV)
        </button>
      </form>
    </div>

    <!-- WORKSPACE -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 items-start">
      
      <!-- LEFT SECTION: PERIODS, INCOMES, & EXPENSES (2/3 width) -->
      <div class="lg:col-span-2 space-y-8">
        
        <!-- INCOMES TABLE (PEMASUKAN LAIN) -->
        <div class="bg-white rounded-3xl border border-slate-200 overflow-hidden shadow-sm">
          <div class="p-6 border-b border-slate-100 flex items-center justify-between">
            <h2 class="font-bold text-lg text-slate-900 flex items-center gap-2 font-display">
              <i data-lucide="arrow-down-left" class="w-5 h-5 text-emerald-500"></i> Rincian Pemasukan Lain <%= hasGlobalFinance ? 'RT' : 'Koridor' %>
            </h2>
            <span class="bg-emerald-50 text-emerald-700 text-xs font-bold px-3 py-1 rounded-full border border-emerald-100"><%= incomes.length %> Data</span>
          </div>

          <% if (incomes.length === 0) { %>
            <div class="text-center py-12 text-slate-500">
              <div class="w-16 h-16 bg-slate-100 rounded-full flex items-center justify-center mx-auto mb-4">
                <i data-lucide="arrow-down-left" class="w-8 h-8 text-slate-400"></i>
              </div>
              <h3 class="text-base font-bold text-slate-900 mb-1">Belum ada pemasukan lain dicatat</h3>
              <p class="text-sm text-slate-500 px-4">Klik tombol "Catat Pemasukan Lain" di atas untuk menambahkan pemasukan.</p>
            </div>
          <% } else { %>
            <div class="overflow-x-auto">
              <table class="w-full text-left border-collapse">
                <thead>
                  <tr class="bg-slate-50 border-b border-slate-200">
                    <th class="px-6 py-4 text-xs font-bold text-slate-500 uppercase tracking-wider">Tanggal</th>
                    <th class="px-6 py-4 text-xs font-bold text-slate-500 uppercase tracking-wider">Kategori</th>
                    <th class="px-6 py-4 text-xs font-bold text-slate-500 uppercase tracking-wider">Keterangan / Sumber</th>
                    <th class="px-6 py-4 text-xs font-bold text-slate-500 uppercase tracking-wider">Koridor</th>
                    <th class="px-6 py-4 text-xs font-bold text-slate-500 uppercase tracking-wider">Dicatat Oleh</th>
                    <th class="px-6 py-4 text-xs font-bold text-slate-500 uppercase tracking-wider text-right">Nominal</th>
                  </tr>
                </thead>
                <tbody id="incomesTableBody" class="divide-y divide-slate-100">
                  <% incomes.forEach(inc => { %>
                    <tr data-date="<%= new Date(inc.date).toISOString().split('T')[0] %>" class="hover:bg-slate-50/50 transition-colors">
                      <td class="px-6 py-4 text-sm text-slate-900 font-semibold">
                        <%= new Date(inc.date).toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric' }) %>
                      </td>
                      <td class="px-6 py-4">
                        <% 
                          let catClass = 'bg-slate-50 text-slate-700 border-slate-200';
                          if(inc.category === 'Donasi') catClass = 'bg-emerald-50 text-emerald-700 border-emerald-100';
                          if(inc.category === 'Sponsorship') catClass = 'bg-blue-50 text-blue-700 border-blue-100';
                          if(inc.category === 'Dana Hibah') catClass = 'bg-purple-50 text-purple-700 border-purple-100';
                          if(inc.category === 'Kas Mandiri') catClass = 'bg-amber-50 text-amber-700 border-amber-100';
                        %>
                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-bold border <%= catClass %>">
                          <%= inc.category %>
                        </span>
                      </td>
                      <td class="px-6 py-4">
                        <p class="font-semibold text-slate-900 text-sm"><%= inc.description %></p>
                        <div class="flex items-center gap-3 mt-0.5 flex-wrap">
                          <span class="text-xs text-slate-500">Sumber: <strong class="text-slate-700"><%= inc.source %></strong></span>
                          <% if (inc.proofFilePath) { %>
                            <a href="<%= inc.proofFilePath %>" target="_blank" class="inline-flex items-center gap-1 text-[10px] font-bold text-emerald-600 bg-emerald-50 border border-emerald-100 px-2 py-0.5 rounded-lg hover:bg-emerald-100 transition-colors">
                              <i data-lucide="file-text" class="w-3 h-3"></i> Bukti Transaksi
                            </a>
                          <% } %>
                        </div>
                      </td>
                      <td class="px-6 py-4">
                        <% if (inc.corridor) { %>
                          <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold bg-brand-50 text-brand-700 border border-brand-100">
                            <%= inc.corridor.name %>
                          </span>
                        <% } else { %>
                          <span class="text-xs text-slate-400 font-medium">Kas RT</span>
                        <% } %>
                      </td>
                      <td class="px-6 py-4 text-xs text-slate-500 font-medium">
                        <%= inc.createdBy ? inc.createdBy.name : 'Sistem' %>
                      </td>
                      <td class="px-6 py-4 text-right font-extrabold text-emerald-600 text-sm">
                        + Rp <%= inc.amount.toLocaleString('id-ID') %>
                      </td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
          <% } %>
        </div>

        <!-- EXPENSES TABLE (PENGELUARAN) -->
        <div class="bg-white rounded-3xl border border-slate-200 overflow-hidden shadow-sm">
          <div class="p-6 border-b border-slate-100 flex items-center justify-between">
            <h2 class="font-bold text-lg text-slate-900 flex items-center gap-2 font-display">
              <i data-lucide="arrow-up-right" class="w-5 h-5 text-rose-500"></i> Rincian Pengeluaran <%= hasGlobalFinance ? 'RT' : 'Koridor' %>
            </h2>
            <span class="bg-rose-50 text-rose-700 text-xs font-bold px-3 py-1 rounded-full border border-rose-100"><%= expenses.length %> Data</span>
          </div>

          <% if (expenses.length === 0) { %>
            <div class="text-center py-12 text-slate-500">
              <div class="w-16 h-16 bg-slate-100 rounded-full flex items-center justify-center mx-auto mb-4">
                <i data-lucide="receipt" class="w-8 h-8 text-slate-400"></i>
              </div>
              <h3 class="text-base font-bold text-slate-900 mb-1">Belum ada pengeluaran dicatat</h3>
              <p class="text-sm text-slate-500 px-4">Klik tombol "Catat Pengeluaran Baru" di atas untuk menambahkan pengeluaran.</p>
            </div>
          <% } else { %>
            <div class="overflow-x-auto">
              <table class="w-full text-left border-collapse">
                <thead>
                  <tr class="bg-slate-50 border-b border-slate-200">
                    <th class="px-6 py-4 text-xs font-bold text-slate-500 uppercase tracking-wider">Tanggal</th>
                    <th class="px-6 py-4 text-xs font-bold text-slate-500 uppercase tracking-wider">Kategori</th>
                    <th class="px-6 py-4 text-xs font-bold text-slate-500 uppercase tracking-wider">Keterangan / Penerima</th>
                    <th class="px-6 py-4 text-xs font-bold text-slate-500 uppercase tracking-wider">Koridor</th>
                    <th class="px-6 py-4 text-xs font-bold text-slate-500 uppercase tracking-wider">Dicatat Oleh</th>
                    <th class="px-6 py-4 text-xs font-bold text-slate-500 uppercase tracking-wider text-right">Nominal</th>
                  </tr>
                </thead>
                <tbody id="expensesTableBody" class="divide-y divide-slate-100">
                  <% expenses.forEach(exp => { %>
                    <tr data-date="<%= new Date(exp.date).toISOString().split('T')[0] %>" class="hover:bg-slate-50/50 transition-colors">
                      <td class="px-6 py-4 text-sm text-slate-900 font-semibold">
                        <%= new Date(exp.date).toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric' }) %>
                      </td>
                      <td class="px-6 py-4">
                        <% 
                          let catClass = 'bg-slate-50 text-slate-700 border-slate-200';
                          if(exp.category === 'Keamanan') catClass = 'bg-blue-50 text-blue-700 border-blue-100';
                          if(exp.category === 'Kebersihan') catClass = 'bg-emerald-50 text-emerald-700 border-emerald-100';
                          if(exp.category === 'Sosial') catClass = 'bg-amber-50 text-amber-700 border-amber-100';
                          if(exp.category === 'Sarana & Prasarana') catClass = 'bg-purple-50 text-purple-700 border-purple-100';
                          if(exp.category === 'Operasional RT') catClass = 'bg-indigo-50 text-indigo-700 border-indigo-100';
                        %>
                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-bold border <%= catClass %>">
                          <%= exp.category %>
                        </span>
                      </td>
                      <td class="px-6 py-4">
                        <p class="font-semibold text-slate-900 text-sm"><%= exp.description %></p>
                        <div class="flex items-center gap-3 mt-0.5 flex-wrap">
                          <span class="text-xs text-slate-500">Penerima: <strong class="text-slate-700"><%= exp.recipient %></strong></span>
                          <% if (exp.proofFilePath) { %>
                            <a href="<%= exp.proofFilePath %>" target="_blank" class="inline-flex items-center gap-1 text-[10px] font-bold text-rose-600 bg-rose-50 border border-rose-100 px-2 py-0.5 rounded-lg hover:bg-rose-100 transition-colors">
                              <i data-lucide="file-text" class="w-3 h-3"></i> Bukti Transaksi
                            </a>
                          <% } %>
                        </div>
                      </td>
                      <td class="px-6 py-4">
                        <% if (exp.corridor) { %>
                          <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold bg-brand-50 text-brand-700 border border-brand-100">
                            <%= exp.corridor.name %>
                          </span>
                        <% } else { %>
                          <span class="text-xs text-slate-400 font-medium">Kas RT</span>
                        <% } %>
                      </td>
                      <td class="px-6 py-4 text-xs text-slate-500 font-medium">
                        <%= exp.createdBy ? exp.createdBy.name : 'Sistem' %>
                      </td>
                      <td class="px-6 py-4 text-right font-extrabold text-rose-600 text-sm">
                        - Rp <%= exp.amount.toLocaleString('id-ID') %>
                      </td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
          <% } %>
        </div>

        <!-- LIST OF FINANCE PERIODS -->
        <div class="bg-white rounded-3xl border border-slate-200 overflow-hidden shadow-sm">
          <div class="p-6 border-b border-slate-100 flex items-center justify-between">
            <h2 class="font-bold text-lg text-slate-900 flex items-center gap-2 font-display">
              <i data-lucide="calendar" class="w-5 h-5 text-brand-600"></i> Daftar Periode Tagihan Iuran
            </h2>
          </div>

          <% if (periods.length === 0) { %>
            <div class="text-center py-12 text-slate-500">
              <div class="w-16 h-16 bg-slate-100 rounded-full flex items-center justify-center mx-auto mb-4">
                <i data-lucide="info" class="w-8 h-8 text-slate-400"></i>
              </div>
              <h3 class="text-base font-bold text-slate-900 mb-1">Belum ada periode tagihan</h3>
              <p class="text-sm text-slate-500 px-4">Gunakan form di samping kanan untuk membuat periode iuran baru.</p>
            </div>
          <% } else { %>
            <div class="overflow-x-auto">
              <table class="w-full text-left border-collapse">
                <thead>
                  <tr class="bg-slate-50 border-b border-slate-200">
                    <th class="px-6 py-4 text-xs font-bold text-slate-500 uppercase tracking-wider">Nama Periode</th>
                    <th class="px-6 py-4 text-xs font-bold text-slate-500 uppercase tracking-wider">Bulan / Tahun</th>
                    <th class="px-6 py-4 text-xs font-bold text-slate-500 uppercase tracking-wider">Nominal Iuran</th>
                    <th class="px-6 py-4 text-xs font-bold text-slate-500 uppercase tracking-wider">Status</th>
                    <th class="px-6 py-4 text-xs font-bold text-slate-500 uppercase tracking-wider text-right">Aksi</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                  <% periods.forEach(period => { %>
                    <tr class="hover:bg-slate-50/50 transition-colors">
                      <td class="px-6 py-4 font-semibold text-slate-900">
                        <%= period.name %>
                      </td>
                      <td class="px-6 py-4 text-sm text-slate-600">
                        Bulan <%= period.month %> / <%= period.year %>
                      </td>
                      <td class="px-6 py-4 font-medium text-slate-900">
                        Rp <%= period.fixedDuesAmount.toLocaleString('id-ID') %>
                      </td>
                      <td class="px-6 py-4">
                        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold <%= period.isActive ? 'bg-emerald-50 text-emerald-700 border border-emerald-100' : 'bg-slate-100 text-slate-700 border border-slate-200' %>">
                          <span class="w-1.5 h-1.5 rounded-full <%= period.isActive ? 'bg-emerald-500' : 'bg-slate-400' %>"></span>
                          <%= period.isActive ? 'Aktif' : 'Ditutup' %>
                        </span>
                      </td>
                      <td class="px-6 py-4 text-right">
                        <div class="flex items-center justify-end gap-2">
                          <a href="/admin/finance/period/<%= period.id %>" class="inline-flex items-center gap-1 bg-slate-900 hover:bg-slate-800 text-white font-bold text-xs py-1.5 px-3 rounded-lg transition-colors">
                            Detail
                          </a>
                          <form action="/admin/finance/periods/<%= period.id %>/toggle" method="POST" class="m-0">
                            <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
                            <button type="submit" class="inline-flex items-center gap-1 px-3 py-1.5 rounded-lg border text-xs font-bold shadow-sm transition-colors <%= period.isActive ? 'bg-white text-rose-600 border-rose-200 hover:bg-rose-50' : 'bg-white text-emerald-600 border-emerald-200 hover:bg-emerald-50' %>">
                              <%= period.isActive ? 'Tutup Tagihan' : 'Buka Tagihan' %>
                            </button>
                          </form>
                        </div>
                      </td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
          <% } %>
        </div>
      </div>

      <!-- RIGHT SECTION: FORMS & TRANSACTIONS (1/3 width) -->
      <div class="space-y-8">
        
        <!-- FORM: CREATE PERIOD -->
        <div class="bg-white rounded-3xl p-6 border border-slate-200 shadow-sm space-y-5">
          <h2 class="font-bold text-base text-slate-900 flex items-center gap-2 pb-2 border-b border-slate-100 font-display">
            <i data-lucide="plus-circle" class="w-5 h-5 text-brand-600"></i> Buat Periode Tagihan Baru
          </h2>

          <form action="/admin/finance/periods" method="POST" class="space-y-4">
            <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">

            <div class="space-y-1.5">
              <label class="block text-xs font-semibold text-slate-700">Nama Periode</label>
              <input type="text" name="name" required placeholder="Contoh: Juni 2026" class="block w-full p-2.5 border border-slate-300 rounded-xl text-sm focus:ring-2 focus:ring-brand-500 focus:border-brand-500">
            </div>

            <div class="grid grid-cols-2 gap-4">
              <div class="space-y-1.5">
                <label class="block text-xs font-semibold text-slate-700">Bulan (1-12)</label>
                <input type="number" name="month" required min="1" max="12" placeholder="6" class="block w-full p-2.5 border border-slate-300 rounded-xl text-sm focus:ring-2 focus:ring-brand-500 focus:border-brand-500">
              </div>
              <div class="space-y-1.5">
                <label class="block text-xs font-semibold text-slate-700">Tahun</label>
                <input type="number" name="year" required min="2020" max="2050" value="<%= new Date().getFullYear() %>" class="block w-full p-2.5 border border-slate-300 rounded-xl text-sm focus:ring-2 focus:ring-brand-500 focus:border-brand-500">
              </div>
            </div>

            <div class="space-y-1.5">
              <label class="block text-xs font-semibold text-slate-700">Iuran Tetap Bulanan (Rp)</label>
              <input type="number" name="fixedDuesAmount" required min="0" value="50000" class="block w-full p-2.5 border border-slate-300 rounded-xl text-sm focus:ring-2 focus:ring-brand-500 focus:border-brand-500">
            </div>

            <button type="submit" class="w-full flex justify-center py-2.5 px-4 border border-transparent rounded-xl shadow-sm text-sm font-bold text-white bg-brand-600 hover:bg-brand-700 transition-colors pt-3">
              + Buat Periode Baru
            </button>
          </form>
        </div>

        <!-- RECENT TRANSACTIONS FEED -->
        <div class="bg-white rounded-3xl p-6 border border-slate-200 shadow-sm space-y-5">
          <h2 class="font-bold text-base text-slate-900 flex items-center gap-2 pb-2 border-b border-slate-100 font-display">
            <i data-lucide="history" class="w-5 h-5 text-indigo-500"></i> Mutasi Kas Terbaru
          </h2>

          <% if (transactions.length === 0) { %>
            <p class="text-center py-6 text-slate-400 text-sm">Belum ada aktivitas mutasi kas.</p>
          <% } else { %>
            <div class="flow-root">
              <ul id="mutasiFeedList" class="-mb-8">
                <% transactions.forEach((tx, txIdx) => { %>
                  <li data-date="<%= new Date(tx.date).toISOString().split('T')[0] %>" class="feed-item">
                    <div class="relative pb-8">
                      <% if (txIdx !== transactions.length - 1) { %>
                        <span class="absolute top-4 left-4 -ml-px h-full w-0.5 bg-slate-200" aria-hidden="true"></span>
                      <% } %>
                      <div class="relative flex space-x-3">
                        <div>
                          <span class="h-8 w-8 rounded-full flex items-center justify-center ring-8 ring-white <%= tx.type === 'income' ? 'bg-emerald-50 text-emerald-600' : 'bg-rose-50 text-rose-600' %>">
                            <i data-lucide="<%= tx.type === 'income' ? 'arrow-down-left' : 'arrow-up-right' %>" class="w-4 h-4"></i>
                          </span>
                        </div>
                        <div class="flex-1 min-w-0 pt-0.5">
                          <div class="flex justify-between items-start gap-2">
                            <div>
                              <p class="text-xs font-semibold text-slate-900 font-display leading-snug"><%= tx.title %></p>
                              <% if (tx.proofFilePath) { %>
                                <a href="<%= tx.proofFilePath %>" target="_blank" class="inline-flex items-center gap-0.5 text-[9px] font-bold text-slate-500 hover:text-brand-600 transition-colors mt-0.5">
                                  <i data-lucide="file-text" class="w-2.5 h-2.5"></i> Lihat Bukti
                                </a>
                              <% } %>
                            </div>
                            <p class="text-xs font-extrabold flex-shrink-0 <%= tx.type === 'income' ? 'text-emerald-600' : 'text-rose-600' %>">
                              <%= tx.type === 'income' ? '+' : '-' %>Rp <%= tx.amount.toLocaleString('id-ID') %>
                            </p>
                          </div>
                          <p class="text-[10px] text-slate-500 mt-0.5"><%= tx.subtitle %></p>
                          <p class="text-[9px] text-slate-400 mt-1"><%= new Date(tx.date).toLocaleDateString('id-ID', { day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' }) %></p>
                        </div>
                      </div>
                    </div>
                  </li>
                <% }) %>
              </ul>
            </div>
          <% } %>
        </div>
      </div>
    </div>
  </div>
</main>

<!-- MODAL: RECORD INCOME -->
<div id="incomeModal" class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-50 hidden flex items-center justify-center p-4">
  <div class="bg-white rounded-3xl max-w-md w-full p-6 shadow-2xl border border-slate-200 animate-in fade-in zoom-in-95 duration-200">
    <div class="flex items-center justify-between mb-4 pb-2 border-b border-slate-100">
      <h3 class="font-display font-bold text-lg text-slate-900 flex items-center gap-2">
        <i data-lucide="arrow-down-left" class="text-emerald-600 w-5 h-5"></i> Catat Pemasukan Lain Baru
      </h3>
      <button type="button" onclick="closeIncomeModal()" class="text-slate-400 hover:text-slate-600 transition-colors">
        <i data-lucide="x" class="w-5 h-5"></i>
      </button>
    </div>
    
    <form action="/admin/finance/incomes" method="POST" enctype="multipart/form-data" class="space-y-4">
      <!-- CSRF Token -->
      <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
      
      <div class="space-y-1.5">
        <label class="block text-xs font-semibold text-slate-700">Nominal Pemasukan (Rp)</label>
        <input type="number" name="amount" required min="1" placeholder="Contoh: 250000" class="block w-full p-2.5 border border-slate-300 rounded-xl text-sm focus:ring-2 focus:ring-brand-500 focus:border-brand-500">
      </div>

      <% if (hasGlobalFinance) { %>
      <div class="space-y-1.5">
        <label class="block text-xs font-semibold text-slate-700">Pilih Koridor (Kosongkan jika Kas RT)</label>
        <select name="corridorId" class="block w-full p-2.5 border border-slate-300 rounded-xl text-sm bg-white focus:ring-2 focus:ring-brand-500 focus:border-brand-500">
          <option value="">-- Kas Umum RT --</option>
          <% if (typeof corridors !== 'undefined') { %>
            <% corridors.forEach(corridor => { %>
              <option value="<%= corridor.id %>"><%= corridor.name %></option>
            <% }); %>
          <% } %>
        </select>
      </div>
      <% } %>

      <div class="space-y-1.5">
        <label class="block text-xs font-semibold text-slate-700">Kategori</label>
        <select name="category" required class="block w-full p-2.5 border border-slate-300 rounded-xl text-sm bg-white focus:ring-2 focus:ring-brand-500 focus:border-brand-500">
          <option value="">-- Pilih Kategori --</option>
          <option value="Donasi">🤝 Donasi / Sumbangan Warga</option>
          <option value="Sponsorship">🏢 Sponsorship / Kerja Sama</option>
          <option value="Dana Hibah">🏛️ Dana Hibah Pemerintah / LSM</option>
          <option value="Kas Mandiri">💰 Kas Mandiri RT</option>
          <option value="Lain-lain">📦 Lain-lain</option>
        </select>
      </div>

      <div class="space-y-1.5">
        <label class="block text-xs font-semibold text-slate-700">Sumber Dana</label>
        <input type="text" name="source" required placeholder="Contoh: PT. Djarum / Bpk. Heru" class="block w-full p-2.5 border border-slate-300 rounded-xl text-sm focus:ring-2 focus:ring-brand-500 focus:border-brand-500">
      </div>

      <div class="space-y-1.5">
        <label class="block text-xs font-semibold text-slate-700">Tanggal Pemasukan</label>
        <input type="date" name="date" required value="<%= new Date().toISOString().split('T')[0] %>" class="block w-full p-2.5 border border-slate-300 rounded-xl text-sm focus:ring-2 focus:ring-brand-500 focus:border-brand-500">
      </div>

      <div class="space-y-1.5">
        <label class="block text-xs font-semibold text-slate-700">Upload Bukti Transaksi (Opsional)</label>
        <input type="file" name="proofFile" accept="image/*,application/pdf" class="block w-full text-xs text-slate-500 file:mr-4 file:py-2 file:px-4 file:rounded-xl file:border-0 file:text-xs file:font-semibold file:bg-slate-100 file:text-slate-700 hover:file:bg-slate-200 transition-colors border border-slate-300 rounded-xl p-1 bg-slate-50">
      </div>

      <div class="space-y-1.5">
        <label class="block text-xs font-semibold text-slate-700">Rincian / Keterangan</label>
        <textarea name="description" required rows="3" placeholder="Contoh: Sumbangan sukarela pembangunan fasilitas sosial RT" class="block w-full p-2.5 border border-slate-300 rounded-xl text-sm focus:ring-2 focus:ring-brand-500 focus:border-brand-500"></textarea>
      </div>

      <div class="flex gap-3 justify-end pt-4 border-t border-slate-100">
        <button type="button" onclick="closeIncomeModal()" class="btn btn-secondary py-2 px-4 rounded-xl border text-sm font-semibold hover:bg-slate-50 transition-colors">Batal</button>
        <button type="submit" class="btn bg-emerald-600 text-white hover:bg-emerald-700 font-bold py-2 px-5 rounded-xl shadow-sm transition-colors">
          Simpan Transaksi
        </button>
      </div>
    </form>
  </div>
</div>

<!-- MODAL: RECORD EXPENSE -->
<div id="expenseModal" class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-50 hidden flex items-center justify-center p-4">
  <div class="bg-white rounded-3xl max-w-md w-full p-6 shadow-2xl border border-slate-200 animate-in fade-in zoom-in-95 duration-200">
    <div class="flex items-center justify-between mb-4 pb-2 border-b border-slate-100">
      <h3 class="font-display font-bold text-lg text-slate-900 flex items-center gap-2">
        <i data-lucide="receipt" class="text-rose-500 w-5 h-5"></i> Catat Pengeluaran Baru
      </h3>
      <button type="button" onclick="closeExpenseModal()" class="text-slate-400 hover:text-slate-600 transition-colors">
        <i data-lucide="x" class="w-5 h-5"></i>
      </button>
    </div>
    
    <form action="/admin/finance/expenses" method="POST" enctype="multipart/form-data" class="space-y-4">
      <!-- CSRF Token -->
      <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
      
      <div class="space-y-1.5">
        <label class="block text-xs font-semibold text-slate-700">Nominal Pengeluaran (Rp)</label>
        <input type="number" name="amount" required min="1" placeholder="Contoh: 150000" class="block w-full p-2.5 border border-slate-300 rounded-xl text-sm focus:ring-2 focus:ring-brand-500 focus:border-brand-500">
      </div>

      <% if (hasGlobalFinance) { %>
      <div class="space-y-1.5">
        <label class="block text-xs font-semibold text-slate-700">Pilih Koridor (Kosongkan jika Kas RT)</label>
        <select name="corridorId" class="block w-full p-2.5 border border-slate-300 rounded-xl text-sm bg-white focus:ring-2 focus:ring-brand-500 focus:border-brand-500">
          <option value="">-- Kas Umum RT --</option>
          <% if (typeof corridors !== 'undefined') { %>
            <% corridors.forEach(corridor => { %>
              <option value="<%= corridor.id %>"><%= corridor.name %></option>
            <% }); %>
          <% } %>
        </select>
      </div>
      <% } %>

      <div class="space-y-1.5">
        <label class="block text-xs font-semibold text-slate-700">Kategori</label>
        <select name="category" required class="block w-full p-2.5 border border-slate-300 rounded-xl text-sm bg-white focus:ring-2 focus:ring-brand-500 focus:border-brand-500">
          <option value="">-- Pilih Kategori --</option>
          <option value="Kebersihan">🧹 Kebersihan</option>
          <option value="Keamanan">🛡️ Keamanan</option>
          <option value="Sosial">🤝 Sosial (Santunan / Musibah)</option>
          <option value="Sarana & Prasarana">🧱 Sarana & Prasarana</option>
          <option value="Operasional RT">💼 Operasional RT</option>
          <option value="Lain-lain">📦 Lain-lain</option>
        </select>
      </div>

      <div class="space-y-1.5">
        <label class="block text-xs font-semibold text-slate-700">Penerima Dana</label>
        <input type="text" name="recipient" required placeholder="Contoh: Toko Bangunan Jaya / Bpk. Rudi" class="block w-full p-2.5 border border-slate-300 rounded-xl text-sm focus:ring-2 focus:ring-brand-500 focus:border-brand-500">
      </div>

      <div class="space-y-1.5">
        <label class="block text-xs font-semibold text-slate-700">Tanggal Pengeluaran</label>
        <input type="date" name="date" required value="<%= new Date().toISOString().split('T')[0] %>" class="block w-full p-2.5 border border-slate-300 rounded-xl text-sm focus:ring-2 focus:ring-brand-500 focus:border-brand-500">
      </div>

      <div class="space-y-1.5">
        <label class="block text-xs font-semibold text-slate-700">Upload Bukti Transaksi (Opsional)</label>
        <input type="file" name="proofFile" accept="image/*,application/pdf" class="block w-full text-xs text-slate-500 file:mr-4 file:py-2 file:px-4 file:rounded-xl file:border-0 file:text-xs file:font-semibold file:bg-slate-100 file:text-slate-700 hover:file:bg-slate-200 transition-colors border border-slate-300 rounded-xl p-1 bg-slate-50">
      </div>

      <div class="space-y-1.5">
        <label class="block text-xs font-semibold text-slate-700">Rincian / Keterangan</label>
        <textarea name="description" required rows="3" placeholder="Contoh: Pembelian semen dan cat untuk perbaikan pos ronda" class="block w-full p-2.5 border border-slate-300 rounded-xl text-sm focus:ring-2 focus:ring-brand-500 focus:border-brand-500"></textarea>
      </div>

      <div class="flex gap-3 justify-end pt-4 border-t border-slate-100">
        <button type="button" onclick="closeExpenseModal()" class="btn btn-secondary py-2 px-4 rounded-xl border text-sm font-semibold hover:bg-slate-50 transition-colors">Batal</button>
        <button type="submit" class="btn bg-rose-600 text-white hover:bg-rose-700 font-bold py-2 px-5 rounded-xl shadow-sm transition-colors">
          Simpan Transaksi
        </button>
      </div>
    </form>
  </div>
</div>

<script>
  function openIncomeModal() {
    document.getElementById('incomeModal').classList.remove('hidden');
    if (typeof lucide !== 'undefined') {
      lucide.createIcons();
    }
  }
  
  function closeIncomeModal() {
    document.getElementById('incomeModal').classList.add('hidden');
  }

  function openExpenseModal() {
    document.getElementById('expenseModal').classList.remove('hidden');
    if (typeof lucide !== 'undefined') {
      lucide.createIcons();
    }
  }
  
  function closeExpenseModal() {
    document.getElementById('expenseModal').classList.add('hidden');
  }

  function filterMutations() {
    const query = document.getElementById('mutationSearch').value.toLowerCase().trim();
    const startDateVal = document.getElementById('filterStartDate').value;
    const endDateVal = document.getElementById('filterEndDate').value;
    
    const start = startDateVal ? new Date(startDateVal) : null;
    if (start) start.setHours(0, 0, 0, 0);
    
    const end = endDateVal ? new Date(endDateVal) : null;
    if (end) end.setHours(23, 59, 59, 999);

    if (start && end && end < start) {
      alert("Tanggal akhir tidak boleh mendahului tanggal mulai!");
      document.getElementById('filterEndDate').value = '';
      return;
    }

    const filterItem = (el) => {
      // Check text match
      const textMatch = el.textContent.toLowerCase().includes(query);
      
      // Check date match
      const dateStr = el.getAttribute('data-date');
      let dateMatch = true;
      if (dateStr) {
        const itemDate = new Date(dateStr);
        if (start && itemDate < start) dateMatch = false;
        if (end && itemDate > end) dateMatch = false;
      }
      
      if (textMatch && dateMatch) {
        el.style.display = '';
      } else {
        el.style.display = 'none';
      }
    };

    // 1. Filter Incomes Table Rows
    document.querySelectorAll('#incomesTableBody tr').forEach(filterItem);
    
    // 2. Filter Expenses Table Rows
    document.querySelectorAll('#expensesTableBody tr').forEach(filterItem);

    // 3. Filter Mutasi Feed List Items
    document.querySelectorAll('#mutasiFeedList .feed-item').forEach(filterItem);
  }

  function resetLiveFilters() {
    document.getElementById('mutationSearch').value = '';
    document.getElementById('filterStartDate').value = '';
    document.getElementById('filterEndDate').value = '';
    filterMutations();
  }

  // Initialize export dates on load and enforce date order constraints
  document.addEventListener("DOMContentLoaded", function() {
    const today = new Date();
    const firstDay = new Date(today.getFullYear(), today.getMonth(), 1);
    
    const startInput = document.getElementById('exportStartDate');
    const endInput = document.getElementById('exportEndDate');
    
    if (startInput && endInput) {
      startInput.value = firstDay.toISOString().split('T')[0];
      endInput.value = today.toISOString().split('T')[0];
      
      // Enforce CSV Export constraints
      endInput.min = startInput.value;
      startInput.max = endInput.value;
      
      startInput.addEventListener('change', function() {
        if (startInput.value) {
          endInput.min = startInput.value;
        } else {
          endInput.removeAttribute('min');
        }
      });
      
      endInput.addEventListener('change', function() {
        if (endInput.value) {
          startInput.max = endInput.value;
        } else {
          startInput.removeAttribute('max');
        }
      });
    }

    // Enforce Live Date Search constraints
    const liveStart = document.getElementById('filterStartDate');
    const liveEnd = document.getElementById('filterEndDate');
    
    if (liveStart && liveEnd) {
      liveStart.addEventListener('change', function() {
        if (liveStart.value) {
          liveEnd.min = liveStart.value;
        } else {
          liveEnd.removeAttribute('min');
        }
      });
      
      liveEnd.addEventListener('change', function() {
        if (liveEnd.value) {
          liveStart.max = liveEnd.value;
        } else {
          liveStart.removeAttribute('max');
        }
      });
    }
  });
</script>

</body>
</html>
