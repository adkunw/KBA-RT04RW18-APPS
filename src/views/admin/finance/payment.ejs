<%- include('../_sidebar', { currentPage: 'finance' }) %>

  <!-- MAIN CONTENT -->
  <main class="admin-main">
    <div class="admin-topbar">
      <div>
        <h1 class="admin-topbar-title">🔎 Review Pembayaran</h1>
        <p class="admin-topbar-sub">
          <a href="/admin/finance/period/<%= payment.periodId %>" style="color:var(--gray-600);text-decoration:none;">← Kembali ke Detail Periode</a>
        </p>
      </div>
      <span style="font-size:0.875rem;color:var(--gray-600);">👤 <%= user.name %></span>
    </div>

    <!-- FLASH MESSAGES -->
    <% if (error) { %>
      <div class="flash-error">⚠️ <%= error %></div>
    <% } %>
    <% if (success) { %>
      <div class="flash-success">✅ <%= success %></div>
    <% } %>

    <div style="display:grid;grid-template-columns:1fr 360px;gap:1.5rem;align-items:start;">

      <!-- LEFT: DETAIL & PROOF -->
      <div>
        <div class="admin-card" style="margin-bottom:1.25rem;">
          <div style="display:flex;align-items:flex-start;justify-content:space-between;gap:1rem;margin-bottom:1.25rem;flex-wrap:wrap;">
            <div>
              <h2 style="font-size:1.25rem;font-weight:700;color:var(--gray-900);margin:0 0 0.5rem 0;">Pembayaran: <%= payment.user.name %></h2>
              <div style="display:flex;align-items:center;gap:0.75rem;flex-wrap:wrap;">
                <span style="display:inline-block;padding:0.2rem 0.6rem;border-radius:4px;font-size:0.75rem;font-weight:600;background:#eff6ff;color:var(--primary-dark);text-transform:uppercase;letter-spacing:0.05em;">
                  Periode <%= payment.period.name %>
                </span>
                <span style="display:inline-flex;align-items:center;gap:0.3rem;padding:0.25rem 0.875rem;border-radius:20px;font-size:0.8125rem;font-weight:700;<%= payment.status === 'pending' ? 'background:#fef3c7;color:#92400e;' : payment.status === 'approved' ? 'background:#dcfce7;color:#166534;' : 'background:#fee2e2;color:#991b1b;' %>">
                  <%= payment.status === 'pending' ? '⏳ Menunggu Verifikasi' : payment.status === 'approved' ? '✅ Disetujui' : '❌ Ditolak' %>
                </span>
              </div>
            </div>
          </div>

          <!-- PAYMENT BREAKDOWN -->
          <div style="background:#f8fafc;border-radius:8px;padding:1.5rem;margin-bottom:1.5rem;border:1px solid var(--gray-200);">
            <h3 style="font-size:0.875rem;font-weight:700;color:var(--gray-700);text-transform:uppercase;letter-spacing:0.05em;margin-bottom:1rem;border-bottom:1px solid var(--gray-200);padding-bottom:0.5rem;">Rincian Pembayaran</h3>
            
            <table style="width:100%;border-collapse:collapse;">
              <% if (payment.hasFixedDues) { %>
              <tr style="border-bottom:1px solid var(--gray-200);">
                <td style="padding:0.75rem 0;color:var(--gray-700);">✅ Iuran Tetap</td>
                <td style="padding:0.75rem 0;text-align:right;font-weight:600;color:var(--gray-900);">Rp <%= payment.fixedDuesAmount.toLocaleString('id-ID') %></td>
              </tr>
              <% } %>
              
              <% if (payment.hasKas) { %>
              <tr style="border-bottom:1px solid var(--gray-200);">
                <td style="padding:0.75rem 0;color:var(--gray-700);">✅ Kas RT</td>
                <td style="padding:0.75rem 0;text-align:right;font-weight:600;color:var(--gray-900);">Rp <%= payment.kasAmount.toLocaleString('id-ID') %></td>
              </tr>
              <% } %>
              
              <% if (payment.otherAmount > 0) { %>
              <tr style="border-bottom:1px solid var(--gray-200);">
                <td style="padding:0.75rem 0;color:var(--gray-700);">
                  ✅ Lain-lain <br>
                  <span style="font-size:0.75rem;color:var(--gray-500);"><%= payment.otherDescription %></span>
                </td>
                <td style="padding:0.75rem 0;text-align:right;font-weight:600;color:var(--gray-900);">Rp <%= payment.otherAmount.toLocaleString('id-ID') %></td>
              </tr>
              <% } %>
              
              <tr>
                <td style="padding:1rem 0 0 0;font-weight:700;color:var(--gray-900);font-size:1.125rem;">TOTAL</td>
                <td style="padding:1rem 0 0 0;text-align:right;font-weight:700;color:var(--primary-dark);font-size:1.125rem;">Rp <%= payment.totalAmount.toLocaleString('id-ID') %></td>
              </tr>
            </table>
          </div>

          <!-- EXISTING NOTES -->
          <% if (payment.notes) { %>
            <div style="background:#f8fafc;border:1px solid var(--gray-200);border-left:4px solid var(--primary);border-radius:8px;padding:1rem 1.25rem;margin-bottom:1.25rem;">
              <div style="font-size:0.8125rem;font-weight:700;color:var(--gray-700);margin-bottom:0.375rem;">📋 Catatan Review Sebelumnya (<%= payment.reviewer ? payment.reviewer.name : '-' %>)</div>
              <div style="font-size:0.875rem;color:var(--gray-600);"><%= payment.notes %></div>
            </div>
          <% } %>

          <!-- FILE PREVIEW -->
          <h3 style="font-size:0.875rem;font-weight:700;color:var(--gray-700);text-transform:uppercase;letter-spacing:0.05em;margin-bottom:1rem;">Bukti Transfer</h3>
          <div style="background:#f8fafc;border:1px solid var(--gray-200);border-radius:8px;padding:1.5rem;text-align:center;">
            <% const ext = payment.proofFilePath.split('.').pop().toLowerCase(); %>
            <% if (['jpg','jpeg','png'].includes(ext)) { %>
              <img src="<%= payment.proofFilePath %>" alt="Bukti Transfer" style="max-width:100%;max-height:500px;border-radius:6px;box-shadow:0 2px 12px rgba(0,0,0,0.1);">
            <% } else { %>
              <div style="font-size:3rem;margin-bottom:1rem;">📋</div>
              <p style="color:var(--gray-600);font-size:0.875rem;margin-bottom:1rem;">File PDF/Dokumen</p>
              <a href="<%= payment.proofFilePath %>" target="_blank" rel="noopener" style="display:inline-flex;align-items:center;gap:0.5rem;padding:0.75rem 1.5rem;background:var(--primary);color:white;border-radius:6px;text-decoration:none;font-weight:600;font-size:0.9375rem;">
                🔗 Buka Bukti Transfer
              </a>
            <% } %>
          </div>
        </div>
      </div>

      <!-- RIGHT: ACTION PANEL -->
      <div>
        <!-- APPROVE / UPDATE FORM -->
          <div class="admin-card" style="margin-bottom:1.25rem;border-left:4px solid #16a34a;">
            <h3 style="font-size:1rem;font-weight:700;color:#166534;margin:0 0 1rem 0;"><%= payment.status === 'approved' ? '📝 Update Data Persetujuan' : '✅ Setujui Pembayaran' %></h3>
            <form action="/admin/finance/payment/<%= payment.id %>/approve" method="POST">
              <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
              
              <% if (payment.otherAmount > 0) { %>
                <div style="margin-bottom:1rem;background:#f0fdf4;padding:0.75rem;border-radius:6px;border:1px solid #bbf7d0;">
                  <label style="display:block;font-size:0.8125rem;font-weight:700;color:#166534;margin-bottom:0.375rem;">✏️ Edit Nama Bayaran Lain-lain</label>
                  <p style="font-size:0.75rem;color:var(--gray-600);margin:0 0 0.5rem 0;line-height:1.4;">Warga mengisi: "<strong><%= payment.otherDescription %></strong>". Anda bisa menyesuaikannya agar seragam di rekap.</p>
                  <input type="text" name="otherDescription" value="<%= payment.otherDescription || '' %>" style="width:100%;padding:0.625rem 0.75rem;border:1px solid #86efac;border-radius:6px;font-size:0.875rem;font-family:inherit;background:white;" maxlength="255">
                </div>
              <% } %>

              <div style="margin-bottom:1rem;">
                <label style="display:block;font-size:0.8125rem;font-weight:600;color:var(--gray-700);margin-bottom:0.375rem;">Catatan (opsional)</label>
                <textarea name="notes" rows="3" placeholder="Catatan persetujuan..." style="width:100%;padding:0.625rem 0.75rem;border:1px solid var(--gray-300);border-radius:6px;font-size:0.875rem;font-family:inherit;resize:vertical;" maxlength="500"><%= payment.status === 'approved' && payment.notes ? payment.notes : '' %></textarea>
              </div>
              <button type="submit" style="width:100%;padding:0.75rem;background:#16a34a;color:white;border:none;border-radius:6px;font-size:0.9375rem;font-weight:700;cursor:pointer;transition:background 0.2s;" onmouseover="this.style.background='#15803d'" onmouseout="this.style.background='#16a34a'">
                <%= payment.status === 'approved' ? '💾 Simpan Perubahan' : '✅ Setujui Pembayaran' %>
              </button>
            </form>
          </div>

        <!-- REJECT FORM -->
        <% if (payment.status !== 'rejected') { %>
          <div class="admin-card" style="margin-bottom:1.25rem;border-left:4px solid #dc2626;">
            <h3 style="font-size:1rem;font-weight:700;color:#991b1b;margin:0 0 1rem 0;">❌ Tolak Pembayaran</h3>
            <form action="/admin/finance/payment/<%= payment.id %>/reject" method="POST">
              <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
              <div style="margin-bottom:1rem;">
                <label style="display:block;font-size:0.8125rem;font-weight:600;color:var(--gray-700);margin-bottom:0.375rem;">Alasan penolakan (wajib jika ditolak)</label>
                <textarea name="notes" rows="3" required placeholder="Contoh: Bukti transfer tidak jelas / nominal salah..." style="width:100%;padding:0.625rem 0.75rem;border:1px solid var(--gray-300);border-radius:6px;font-size:0.875rem;font-family:inherit;resize:vertical;" maxlength="500"></textarea>
              </div>
              <button type="submit" style="width:100%;padding:0.75rem;background:#dc2626;color:white;border:none;border-radius:6px;font-size:0.9375rem;font-weight:700;cursor:pointer;transition:background 0.2s;" onmouseover="this.style.background='#b91c1c'" onmouseout="this.style.background='#dc2626'">
                ❌ Tolak Pembayaran
              </button>
            </form>
          </div>
        <% } %>

      </div>
    </div>
  </main>
</div>
</body>
</html>
