<%- include('../_sidebar.ejs', { currentPage: 'finance' }) %>

<!-- MAIN CONTENT -->
<main class="admin-main flex flex-col">
  
  <!-- TOP HEADER -->
  <header class="h-20 bg-white border-b border-slate-200 flex items-center justify-between px-6 flex-shrink-0 sticky top-0 z-40">
    <div class="flex items-center gap-4">
      <h2 class="font-display font-bold text-xl">Review Pembayaran Warga</h2>
    </div>

    <!-- Right Side Actions & Avatar -->
    <div class="flex items-center gap-4">
      <a href="/admin/messages" class="p-2 text-slate-500 hover:bg-slate-100 rounded-full transition-colors relative">
        <i data-lucide="bell" class="w-5 h-5"></i>
        <% if (typeof unreadMessages !== 'undefined' && unreadMessages > 0) { %>
          <span class="absolute top-2 right-2 w-2.5 h-2.5 bg-red-500 rounded-full border border-white"></span>
        <% } %>
      </a>
      <div class="h-8 w-px bg-slate-200 mx-1"></div>
      <div class="flex items-center gap-2">
        <% if (typeof user !== 'undefined' && user && user.name) { %>
          <div class="w-8 h-8 rounded-full bg-brand-100 border border-slate-200 flex items-center justify-center text-brand-700 font-bold text-sm">
            <%= user.name.charAt(0).toUpperCase() %>
          </div>
          <span class="text-sm font-semibold hidden lg:block"><%= user.name %></span>
        <% } %>
      </div>
    </div>
  </header>

  <!-- INNER CONTENT -->
  <div class="p-6 lg:p-8 flex-1 overflow-y-auto">
    
    <!-- BREADCRUMB & HEADER -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-8">
      <div>
        <a href="/admin/finance/period/<%= payment.periodId %>" class="text-xs font-semibold text-slate-400 hover:text-brand-600 flex items-center gap-1 mb-1 transition-colors">
          <i data-lucide="arrow-left" class="w-3.5 h-3.5"></i> Kembali ke Detail Periode
        </a>
        <h1 class="text-2xl font-bold tracking-tight text-slate-900">Review Laporan Transfer Iuran</h1>
      </div>
    </div>

    <!-- FLASH MESSAGES -->
    <% if (typeof error !== 'undefined' && error) { %>
      <div class="mb-6 p-4 rounded-2xl bg-red-50 border border-red-100 text-red-700 text-sm font-medium flex gap-3 items-start">
        <i data-lucide="alert-circle" class="w-5 h-5 flex-shrink-0 mt-0.5 text-red-500"></i>
        <span><%= error %></span>
      </div>
    <% } %>
    <% if (typeof success !== 'undefined' && success) { %>
      <div class="mb-6 p-4 rounded-2xl bg-emerald-50 border border-emerald-100 text-emerald-700 text-sm font-medium flex gap-3 items-start">
        <i data-lucide="check-circle" class="w-5 h-5 flex-shrink-0 mt-0.5 text-emerald-500"></i>
        <span><%= success %></span>
      </div>
    <% } %>

    <!-- TWO-COLUMN WORKSPACE -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 items-start">
      
      <!-- LEFT COLUMN: PAYMENT BREAKDOWN & PROOF (2/3 width) -->
      <div class="lg:col-span-2 space-y-6">
        
        <div class="bg-white rounded-3xl p-6 lg:p-8 border border-slate-200 shadow-sm space-y-6">
          
          <!-- Title & General status -->
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-slate-100 pb-6">
            <div>
              <h2 class="text-xl font-bold text-slate-900 leading-tight mb-2">Pembayaran: <%= payment.user.name %></h2>
              <div class="flex items-center gap-2 flex-wrap">
                <span class="inline-block px-2.5 py-1 rounded-lg text-[10px] font-bold bg-brand-50 text-brand-700 border border-brand-100 uppercase tracking-wider">
                  Periode <%= payment.period.name %>
                </span>
                <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold <%= payment.status === 'pending' ? 'bg-amber-50 text-amber-700 border border-amber-100' : payment.status === 'approved' ? 'bg-emerald-50 text-emerald-700 border border-emerald-100' : 'bg-rose-50 text-rose-700 border border-rose-100' %>">
                  <span class="w-1.5 h-1.5 rounded-full <%= payment.status === 'pending' ? 'bg-amber-500' : payment.status === 'approved' ? 'bg-emerald-500' : 'bg-rose-500' %>"></span>
                  <%= payment.status === 'pending' ? 'Menunggu Verifikasi' : payment.status === 'approved' ? 'Disetujui' : 'Ditolak' %>
                </span>
              </div>
            </div>
          </div>

          <!-- Rincian Pembayaran Table -->
          <div class="bg-slate-50 border border-slate-200 rounded-2xl p-6 space-y-4">
            <h3 class="text-xs font-bold text-slate-400 uppercase tracking-wider border-b border-slate-200 pb-2">Rincian Pembayaran Warga</h3>
            
            <table class="w-full text-sm border-collapse">
              <tbody class="divide-y divide-slate-200">
                <% if (payment.hasFixedDues) { %>
                  <tr>
                    <td class="py-3 text-slate-600 font-semibold flex items-center gap-2">
                      <i data-lucide="check-square" class="w-4 h-4 text-brand-500"></i> Iuran Tetap Bulanan
                    </td>
                    <td class="py-3 text-right font-bold text-slate-900">
                      Rp <%= payment.fixedDuesAmount.toLocaleString('id-ID') %>
                    </td>
                  </tr>
                <% } %>
                
                <% if (payment.hasKas) { %>
                  <tr>
                    <td class="py-3 text-slate-600 font-semibold flex items-center gap-2">
                      <i data-lucide="check-square" class="w-4 h-4 text-brand-500"></i> Uang Kas Sukarela
                    </td>
                    <td class="py-3 text-right font-bold text-slate-900">
                      Rp <%= payment.kasAmount.toLocaleString('id-ID') %>
                    </td>
                  </tr>
                <% } %>
                
                <% if (payment.otherAmount > 0) { %>
                  <tr>
                    <td class="py-3 text-slate-600 font-semibold flex flex-col gap-0.5">
                      <span class="flex items-center gap-2 font-semibold"><i data-lucide="check-square" class="w-4 h-4 text-brand-500"></i> Pembayaran Lain-lain</span>
                      <span class="text-xs text-slate-400 pl-6 italic">Catatan: <%= payment.otherDescription %></span>
                    </td>
                    <td class="py-3 text-right font-bold text-slate-900 align-top">
                      Rp <%= payment.otherAmount.toLocaleString('id-ID') %>
                    </td>
                  </tr>
                <% } %>
                
                <tr class="text-base font-bold">
                  <td class="py-4 text-slate-900 pt-4">TOTAL TRANSFER</td>
                  <td class="py-4 text-right text-brand-600 pt-4 text-lg">
                    Rp <%= payment.totalAmount.toLocaleString('id-ID') %>
                  </td>
                </tr>
              </tbody>
            </table>
          </div>

          <!-- Existing Review Notes -->
          <% if (payment.notes) { %>
            <div class="p-4 rounded-2xl bg-amber-50/50 border border-amber-100 border-l-4 border-l-amber-500">
              <div class="text-xs font-bold text-amber-800 mb-1 flex items-center gap-1.5">
                <i data-lucide="message-square" class="w-4 h-4"></i> Catatan Reviewer (<%= payment.reviewer ? payment.reviewer.name : '-' %>)
              </div>
              <p class="text-sm text-slate-600 leading-relaxed"><%= payment.notes %></p>
            </div>
          <% } %>

          <!-- FILE PREVIEW -->
          <div class="space-y-3">
            <h3 class="text-xs font-bold text-slate-400 uppercase tracking-wider">Bukti Transfer Warga</h3>
            <div class="bg-slate-50 border border-slate-200 rounded-2xl p-6 flex flex-col items-center justify-center min-h-[300px]">
              <% const ext = payment.proofFilePath.split('.').pop().toLowerCase(); %>
              <% if (['jpg','jpeg','png'].includes(ext)) { %>
                <img src="<%= payment.proofFilePath %>" alt="Bukti Transfer" class="max-w-full max-h-[500px] rounded-xl shadow-lg border border-slate-200/50">
              <% } else { %>
                <div class="w-16 h-16 bg-red-100 rounded-full flex items-center justify-center mb-3">
                  <i data-lucide="file-text" class="w-8 h-8 text-red-600"></i>
                </div>
                <h4 class="font-semibold text-slate-900 mb-1">Bukti Transfer PDF/Dokumen</h4>
                <p class="text-xs text-slate-500 mb-4">Bukti transfer diunggah dalam format berkas digital PDF</p>
                <a href="<%= payment.proofFilePath %>" target="_blank" rel="noopener" class="inline-flex items-center gap-2 bg-brand-600 hover:bg-brand-700 text-white font-bold py-2.5 px-6 rounded-xl transition-colors shadow-sm text-sm">
                  <i data-lucide="external-link" class="w-4 h-4"></i> Buka Bukti Transfer di Tab Baru
                </a>
              <% } %>
            </div>
          </div>
        </div>
      </div>

      <!-- RIGHT COLUMN: ACTION PANELS (1/3 width) -->
      <div class="space-y-6">
        
        <!-- APPROVE CARD -->
        <div class="bg-white rounded-3xl p-6 border border-slate-200 border-l-4 border-l-emerald-500 shadow-sm space-y-4">
          <h3 class="font-bold text-lg text-emerald-800 flex items-center gap-2">
            <i data-lucide="check-circle" class="w-5 h-5 text-emerald-600"></i> <%= payment.status === 'approved' ? 'Update Data Persetujuan' : 'Setujui Pembayaran' %>
          </h3>
          <p class="text-xs text-slate-500 leading-normal">Dengan menyetujui, kas & iuran ini akan otomatis dicatat masuk ke dalam rekapitulasi keuangan periode tagihan.</p>
          
          <form action="/admin/finance/payment/<%= payment.id %>/approve" method="POST" class="space-y-4">
            <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
            
            <% if (payment.otherAmount > 0) { %>
              <div class="p-3 bg-emerald-50 rounded-xl border border-emerald-100 space-y-1.5">
                <label class="block text-[10px] font-bold text-emerald-800 uppercase tracking-wider flex items-center gap-1"><i data-lucide="edit-3" class="w-3.5 h-3.5"></i> Edit Nama Pembayaran Lain-lain</label>
                <p class="text-[10px] text-slate-500 leading-normal">Warga menginput: "<strong><%= payment.otherDescription %></strong>". Anda bisa mengeditnya agar seragam di rekap.</p>
                <input type="text" name="otherDescription" value="<%= payment.otherDescription || '' %>" class="block w-full p-2 border border-emerald-200 rounded-lg text-xs focus:ring-2 focus:ring-emerald-500 bg-white" placeholder="Edit rincian..." maxlength="255">
              </div>
            <% } %>

            <div class="space-y-1.5">
              <label class="block text-xs font-semibold text-slate-700">Catatan Review (opsional)</label>
              <textarea name="notes" rows="3" placeholder="Contoh: Bukti pembayaran valid. Terima kasih..." class="block w-full p-3 border border-slate-200 rounded-xl text-sm focus:ring-2 focus:ring-brand-500 focus:border-brand-500" maxlength="500"><%= payment.status === 'approved' && payment.notes ? payment.notes : '' %></textarea>
            </div>
            <button type="submit" class="w-full flex justify-center py-2.5 px-4 border border-transparent rounded-xl shadow-sm text-sm font-bold text-white bg-emerald-600 hover:bg-emerald-700 transition-colors">
              <%= payment.status === 'approved' ? 'Simpan Perubahan' : 'Setujui Pembayaran' %>
            </button>
          </form>
        </div>

        <!-- REJECT CARD -->
        <% if (payment.status !== 'rejected') { %>
          <div class="bg-white rounded-3xl p-6 border border-slate-200 border-l-4 border-l-rose-500 shadow-sm space-y-4">
            <h3 class="font-bold text-lg text-rose-800 flex items-center gap-2">
              <i data-lucide="x-circle" class="w-5 h-5 text-rose-600"></i> Tolak Laporan
            </h3>
            <p class="text-xs text-slate-500 leading-normal">Gunakan ini jika nominal bukti transfer salah, bukti buram, atau tidak sah.</p>
            
            <form action="/admin/finance/payment/<%= payment.id %>/reject" method="POST" class="space-y-4">
              <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
              <div class="space-y-1.5">
                <label class="block text-xs font-semibold text-slate-700">Alasan Penolakan (wajib)</label>
                <textarea name="notes" rows="3" required placeholder="Contoh: Lampiran salah, silakan upload ulang bukti transfer ATM yang sah..." class="block w-full p-3 border border-slate-200 rounded-xl text-sm focus:ring-2 focus:ring-brand-500 focus:border-brand-500" maxlength="500"></textarea>
              </div>
              <button type="submit" class="w-full flex justify-center py-2.5 px-4 border border-transparent rounded-xl shadow-sm text-sm font-bold text-white bg-rose-600 hover:bg-rose-700 transition-colors">
                Tolak Pembayaran
              </button>
            </form>
          </div>
        <% } %>
      </div>
    </div>
  </div>
</main>
</div>
</body>
</html>
