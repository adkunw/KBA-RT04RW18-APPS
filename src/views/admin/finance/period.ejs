<%- include('../_sidebar.ejs', { currentPage: 'finance' }) %>

<!-- MAIN CONTENT -->
<main class="admin-main flex flex-col">
  
  <!-- TOP HEADER -->
  <header class="h-20 bg-white border-b border-slate-200 flex items-center justify-between px-6 flex-shrink-0 sticky top-0 z-40">
    <div class="flex items-center gap-4">
      <h2 class="font-display font-bold text-xl">Detail Periode: <%= period.name %></h2>
    </div>

    <!-- Right Side Actions & Avatar -->
    <div class="flex items-center gap-4">
      <a href="/admin/messages" class="p-2 text-slate-500 hover:bg-slate-100 rounded-full transition-colors relative">
        <i data-lucide="bell" class="w-5 h-5"></i>
        <% if (typeof unreadMessages !== 'undefined' && unreadMessages > 0) { %>
          <span class="absolute top-2 right-2 w-2.5 h-2.5 bg-red-500 rounded-full border border-white"></span>
        <% } %>
      </a>
      <div class="h-8 w-px bg-slate-200 mx-1"></div>
      <div class="flex items-center gap-2">
        <% if (typeof user !== 'undefined' && user && user.name) { %>
          <div class="w-8 h-8 rounded-full bg-brand-100 border border-slate-200 flex items-center justify-center text-brand-700 font-bold text-sm">
            <%= user.name.charAt(0).toUpperCase() %>
          </div>
          <span class="text-sm font-semibold hidden lg:block"><%= user.name %></span>
        <% } %>
      </div>
    </div>
  </header>

  <!-- INNER CONTENT -->
  <div class="p-6 lg:p-8 flex-1 overflow-y-auto">
    
    <!-- BREADCRUMB & HEADER -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-8">
      <div>
        <a href="/admin/finance" class="text-xs font-semibold text-slate-400 hover:text-brand-600 flex items-center gap-1 mb-1 transition-colors">
          <i data-lucide="arrow-left" class="w-3.5 h-3.5"></i> Kembali ke Daftar Periode
        </a>
        <h1 class="text-2xl font-bold tracking-tight text-slate-900">Rekap Pembayaran: <%= period.name %></h1>
      </div>
    </div>

    <!-- FLASH MESSAGES -->
    <% if (typeof error !== 'undefined' && error) { %>
      <div class="mb-6 p-4 rounded-2xl bg-red-50 border border-red-100 text-red-700 text-sm font-medium flex gap-3 items-start">
        <i data-lucide="alert-circle" class="w-5 h-5 flex-shrink-0 mt-0.5 text-red-500"></i>
        <span><%= error %></span>
      </div>
    <% } %>
    <% if (typeof success !== 'undefined' && success) { %>
      <div class="mb-6 p-4 rounded-2xl bg-emerald-50 border border-emerald-100 text-emerald-700 text-sm font-medium flex gap-3 items-start">
        <i data-lucide="check-circle" class="w-5 h-5 flex-shrink-0 mt-0.5 text-emerald-500"></i>
        <span><%= success %></span>
      </div>
    <% } %>

    <!-- METRICS GRID (CLICKABLE FILTERS & RECAP TRIGGER) -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
      
      <!-- Total Warga -->
      <a href="?filter=all" class="block group">
        <div class="bg-white p-6 rounded-3xl border transition-all h-full <%= currentFilter === 'all' ? 'border-brand-500 shadow-md bg-brand-50/20' : 'border-slate-200 shadow-sm hover:border-brand-200 hover:shadow-md' %>">
          <div class="flex justify-between items-center mb-3">
            <div class="p-2.5 rounded-xl <%= currentFilter === 'all' ? 'bg-brand-100 text-brand-700' : 'bg-slate-100 text-slate-500' %>">
              <i data-lucide="users" class="w-5 h-5"></i>
            </div>
            <span class="text-[10px] font-bold text-slate-400 uppercase">Filter</span>
          </div>
          <p class="text-3xl font-bold tracking-tight text-slate-900 mb-1"><%= stats.totalUsers %></p>
          <p class="text-xs font-semibold text-slate-500">Total Warga Aktif</p>
        </div>
      </a>

      <!-- Lunas -->
      <a href="?filter=approved" class="block group">
        <div class="bg-white p-6 rounded-3xl border transition-all h-full <%= currentFilter === 'approved' ? 'border-emerald-500 shadow-md bg-emerald-50/20' : 'border-slate-200 shadow-sm hover:border-emerald-200 hover:shadow-md' %>">
          <div class="flex justify-between items-center mb-3">
            <div class="p-2.5 rounded-xl <%= currentFilter === 'approved' ? 'bg-emerald-100 text-emerald-700' : 'bg-slate-100 text-slate-500' %>">
              <i data-lucide="check-circle" class="w-5 h-5"></i>
            </div>
            <span class="text-[10px] font-bold text-slate-400 uppercase">Filter</span>
          </div>
          <p class="text-3xl font-bold tracking-tight text-slate-900 mb-1"><%= stats.paidCount %></p>
          <p class="text-xs font-semibold text-slate-500">Lunas / Terverifikasi</p>
        </div>
      </a>

      <!-- Belum Lunas -->
      <a href="?filter=unpaid" class="block group">
        <div class="bg-white p-6 rounded-3xl border transition-all h-full <%= currentFilter === 'unpaid' ? 'border-rose-500 shadow-md bg-rose-50/20' : 'border-slate-200 shadow-sm hover:border-rose-200 hover:shadow-md' %>">
          <div class="flex justify-between items-center mb-3">
            <div class="p-2.5 rounded-xl <%= currentFilter === 'unpaid' ? 'bg-rose-100 text-rose-700' : 'bg-slate-100 text-slate-500' %>">
              <i data-lucide="alert-triangle" class="w-5 h-5"></i>
            </div>
            <span class="text-[10px] font-bold text-slate-400 uppercase">Filter</span>
          </div>
          <p class="text-3xl font-bold tracking-tight text-slate-900 mb-1"><%= stats.unpaidCount %></p>
          <p class="text-xs font-semibold text-slate-500">Belum Bayar / Ditolak</p>
        </div>
      </a>

      <!-- Total Terkumpul (Trigger Rekap) -->
      <div onclick="document.getElementById('recapModal').style.display='flex'" class="bg-white p-6 rounded-3xl border border-slate-200 shadow-sm hover:border-brand-500 hover:shadow-md transition-all cursor-pointer flex flex-col justify-between">
        <div class="flex justify-between items-center mb-3">
          <div class="p-2.5 bg-amber-50 rounded-xl text-amber-600">
            <i data-lucide="wallet" class="w-5 h-5"></i>
          </div>
          <span class="text-[10px] font-bold text-slate-400 uppercase flex items-center gap-1"><i data-lucide="expand" class="w-3 h-3"></i> Rekap</span>
        </div>
        <div>
          <p class="text-xl font-bold tracking-tight text-slate-900 mb-1">Rp <%= stats.totalCollected.toLocaleString('id-ID') %></p>
          <p class="text-xs font-semibold text-slate-500">Kas & Iuran Terkumpul</p>
        </div>
      </div>
    </div>

    <!-- RECAP MODAL -->
    <div id="recapModal" class="hidden fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-[9999] items-center justify-center p-4">
      <div class="bg-white rounded-3xl w-full max-w-md overflow-hidden shadow-2xl border border-slate-100 animate-in fade-in zoom-in duration-200 flex flex-col">
        <!-- Modal Header -->
        <div class="flex justify-between items-center px-6 py-5 border-b border-slate-100">
          <h3 class="font-bold text-lg text-slate-900 flex items-center gap-2">
            <i data-lucide="pie-chart" class="w-5 h-5 text-brand-600"></i> Rincian Dana Masuk
          </h3>
          <button onclick="document.getElementById('recapModal').style.display='none'" class="p-1.5 text-slate-400 hover:bg-slate-100 rounded-full transition-colors">
            <i data-lucide="x" class="w-5 h-5"></i>
          </button>
        </div>
        
        <!-- Modal Content -->
        <div class="p-6 space-y-4">
          <div class="bg-slate-50 rounded-2xl p-4 border border-slate-150 space-y-3">
            <div class="flex justify-between items-center text-sm">
              <span class="text-slate-500 font-semibold">Iuran Tetap Bulanan</span>
              <span class="font-bold text-slate-800">Rp <%= stats.breakdown.fixedDues.toLocaleString('id-ID') %></span>
            </div>
            <div class="flex justify-between items-center text-sm border-t border-slate-200 pt-3">
              <span class="text-slate-500 font-semibold">Kas RT</span>
              <span class="font-bold text-slate-800">Rp <%= stats.breakdown.kas.toLocaleString('id-ID') %></span>
            </div>
            <% Object.entries(stats.breakdown.others).forEach(([desc, amount]) => { %>
              <div class="flex justify-between items-center text-sm border-t border-slate-200 pt-3">
                <span class="text-slate-500 font-semibold"><%= desc %></span>
                <span class="font-bold text-slate-800">Rp <%= amount.toLocaleString('id-ID') %></span>
              </div>
            <% }) %>
          </div>

          <div class="flex justify-between items-center px-2 py-1">
            <span class="font-bold text-slate-900">GRAND TOTAL</span>
            <span class="font-extrabold text-brand-600 text-lg">Rp <%= stats.totalCollected.toLocaleString('id-ID') %></span>
          </div>
        </div>

        <!-- Modal Footer -->
        <div class="px-6 py-4 bg-slate-50 border-t border-slate-100 flex justify-end">
          <button onclick="document.getElementById('recapModal').style.display='none'" class="px-5 py-2.5 bg-white border border-slate-200 text-slate-700 font-bold rounded-xl text-sm hover:bg-slate-100 shadow-sm transition-all">
            Tutup Rekap
          </button>
        </div>
      </div>
    </div>

    <!-- PAYMENTS TABLE -->
    <div class="bg-white border border-slate-200 rounded-3xl overflow-hidden shadow-sm">
      <div class="p-6 border-b border-slate-100 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
          <h2 class="font-bold text-lg text-slate-900">Laporan Pembayaran Warga</h2>
          <p class="text-xs text-slate-400 mt-1">Daftar laporan konfirmasi iuran bulanan warga RT 04 RW 18.</p>
        </div>
        <div class="bg-slate-100 px-3.5 py-1.5 rounded-xl border border-slate-200 text-xs font-semibold text-slate-700 self-start sm:self-center">
          Filter: <span class="font-bold text-brand-600"><%= currentFilter === 'all' ? 'Semua Warga' : currentFilter === 'approved' ? 'Lunas' : currentFilter === 'unpaid' ? 'Belum Lunas' : 'Menunggu' %></span>
        </div>
      </div>

      <% if (residents.length === 0) { %>
        <div class="text-center py-12 text-slate-500">
          <div class="w-16 h-16 bg-slate-100 rounded-full flex items-center justify-center mx-auto mb-4">
            <i data-lucide="search" class="w-8 h-8 text-slate-400"></i>
          </div>
          <h3 class="text-base font-bold text-slate-900 mb-1">Data Kosong</h3>
          <p class="text-sm text-slate-500 px-4">Tidak ada data warga yang sesuai dengan filter saat ini.</p>
        </div>
      <% } else { %>
        <div class="overflow-x-auto">
          <table class="w-full text-left border-collapse">
            <thead>
              <tr class="bg-slate-50 border-b border-slate-200">
                <th class="px-6 py-4 text-xs font-bold text-slate-500 uppercase tracking-wider">Nama Warga</th>
                <th class="px-6 py-4 text-xs font-bold text-slate-500 uppercase tracking-wider">Tanggal Lapor</th>
                <th class="px-6 py-4 text-xs font-bold text-slate-500 uppercase tracking-wider">Nominal Bayar</th>
                <th class="px-6 py-4 text-xs font-bold text-slate-500 uppercase tracking-wider">Status</th>
                <th class="px-6 py-4 text-xs font-bold text-slate-500 uppercase tracking-wider">Reviewer</th>
                <th class="px-6 py-4 text-xs font-bold text-slate-500 uppercase tracking-wider text-right">Aksi</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
              <% residents.forEach(item => { %>
                <% const { user, payment, paymentStatus } = item; %>
                <tr class="hover:bg-slate-50/50 transition-colors">
                  <td class="px-6 py-4">
                    <div class="font-semibold text-slate-900"><%= user.name %></div>
                    <div class="text-xs text-slate-400 flex items-center gap-1 mt-0.5">
                      <i data-lucide="phone" class="w-3.5 h-3.5 flex-shrink-0"></i> <%= user.phone || '-' %>
                    </div>
                  </td>
                  <td class="px-6 py-4 text-sm text-slate-600">
                    <%= payment ? new Date(payment.createdAt).toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric' }) : '-' %>
                  </td>
                  <td class="px-6 py-4 font-semibold text-slate-900">
                    <%= payment ? 'Rp ' + payment.totalAmount.toLocaleString('id-ID') : '-' %>
                  </td>
                  <td class="px-6 py-4">
                    <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold <%= paymentStatus === 'pending' ? 'bg-amber-50 text-amber-700 border border-amber-100' : paymentStatus === 'approved' ? 'bg-emerald-50 text-emerald-700 border border-emerald-100' : paymentStatus === 'rejected' ? 'bg-rose-50 text-rose-700 border border-rose-100' : 'bg-slate-100 text-slate-700 border border-slate-200' %>">
                      <span class="w-1.5 h-1.5 rounded-full <%= paymentStatus === 'pending' ? 'bg-amber-500' : paymentStatus === 'approved' ? 'bg-emerald-500' : paymentStatus === 'rejected' ? 'bg-rose-500' : 'bg-slate-400' %>"></span>
                      <%= paymentStatus === 'pending' ? 'Menunggu Review' : paymentStatus === 'approved' ? 'Lunas' : paymentStatus === 'rejected' ? 'Ditolak' : 'Belum Bayar' %>
                    </span>
                  </td>
                  <td class="px-6 py-4 text-sm text-slate-500">
                    <%= payment && payment.reviewer ? payment.reviewer.name : '-' %>
                  </td>
                  <td class="px-6 py-4 text-right">
                    <% if (payment) { %>
                      <a href="/admin/finance/payment/<%= payment.id %>" class="inline-flex items-center gap-1 bg-slate-900 hover:bg-slate-800 text-white font-bold text-xs py-1.5 px-3 rounded-lg transition-colors">
                        Review
                      </a>
                    <% } else { %>
                      <span class="text-xs text-slate-400 italic">Belum Melapor</span>
                    <% } %>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>
  </div>
</main>
</div>
</body>
</html>
