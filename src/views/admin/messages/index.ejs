<%- include('../_sidebar.ejs', { currentPage: 'messages' }) %>

 <main class="admin-main flex flex-col">
 <!-- TOP HEADER -->
 <header class="h-20 bg-white border-b border-slate-200 flex items-center justify-between px-6 flex-shrink-0 sticky top-0 z-40">
 <div class="flex items-center gap-4">
 <h2 class="font-display font-bold text-xl"><%= typeof title !== 'undefined' ? title : 'Admin Panel' %></h2>
 </div>

 <div class="flex items-center gap-4">
 <a href="/admin/messages" class="p-2 text-slate-500 hover:bg-slate-100 rounded-full transition-colors relative">
 <i data-lucide="bell" class="w-5 h-5"></i>
 <% if (typeof unreadMessages !== 'undefined' && unreadMessages > 0) { %>
 <span class="absolute top-2 right-2 w-2 h-2 bg-red-500 rounded-full border-2 border-white"></span>
 <% } %>
 </a>
 <div class="h-8 w-px bg-slate-200 mx-1"></div>
 <div class="flex items-center gap-2">
 <% if (typeof user !== 'undefined' && user && user.name) { %>
 <div class="w-8 h-8 rounded-full bg-brand-100 border border-slate-200 flex items-center justify-center text-brand-700 font-bold text-sm">
 <%= user.name.charAt(0).toUpperCase() %>
 </div>
 <span class="text-sm font-semibold hidden lg:block"><%= user.name %></span>
 <% } %>
 </div>
 </div>
 </header>
 <div class="p-6 lg:p-8 flex-1 overflow-y-auto">

 <!-- PAGE HEADER -->
 <div class="page-header">
 <h1> Messages</h1>
 <a href="/admin/messages/create" class="btn btn-primary">+ Compose</a>
 </div>

 <% if (error) { %>
 <div class="alert alert-error"><%= error %></div>
 <% } %>
 <% if (success) { %>
 <div class="alert" style="background:#DCFCE7;border-left-color:var(--success);color:#166534;"><%= success %></div>
 <% } %>

  <!-- FILTER TABS & SEARCH CONTAINER -->
  <div class="bg-white rounded-3xl p-5 border border-slate-200 shadow-sm space-y-4 mb-6">
    <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4">
      <!-- Search Input -->
      <div class="relative flex-1">
        <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
          <i data-lucide="search" class="w-4 h-4"></i>
        </span>
        <input type="text" id="messageSearchInput" oninput="applyFilters()" placeholder="Cari judul pesan, isi, atau pengirim..." class="pl-10 pr-4 py-2 w-full text-sm border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent transition-all">
      </div>
      
      <!-- Date Filters -->
      <div class="flex items-center gap-2 flex-wrap sm:flex-nowrap">
        <div class="relative">
          <input type="date" id="messageStartDate" onchange="applyFilters()" class="text-xs border border-slate-200 rounded-xl px-3 py-2 focus:outline-none focus:ring-2 focus:ring-brand-500">
        </div>
        <span class="text-slate-400 text-xs font-semibold">s/d</span>
        <div class="relative">
          <input type="date" id="messageEndDate" onchange="applyFilters()" class="text-xs border border-slate-200 rounded-xl px-3 py-2 focus:outline-none focus:ring-2 focus:ring-brand-500">
        </div>
        <button type="button" onclick="clearFilters()" class="text-xs font-bold text-slate-500 hover:text-brand-650 bg-slate-50 hover:bg-slate-100 border border-slate-200 px-3 py-2 rounded-xl transition-all">
          Reset
        </button>
      </div>
    </div>

    <!-- Filter Buttons (Type) -->
    <div style="display:flex;gap:0.5rem;flex-wrap:wrap;border-top:1px solid var(--gray-200);padding-top:1rem;">
      <a href="/admin/messages" class="btn btn-sm <%= !filterType ? 'btn-primary' : 'btn-secondary' %>">All</a>
      <a href="/admin/messages?type=announcement" class="btn btn-sm <%= filterType === 'announcement' ? 'btn-primary' : 'btn-secondary' %>"> Announcements</a>
      <a href="/admin/messages?type=broadcast" class="btn btn-sm <%= filterType === 'broadcast' ? 'btn-primary' : 'btn-secondary' %>"> Broadcast</a>
      <a href="/admin/messages?type=personal" class="btn btn-sm <%= filterType === 'personal' ? 'btn-primary' : 'btn-secondary' %>"> Personal</a>
    </div>
  </div>

  <% if (messages.length === 0) { %>
    <div class="card empty-state">
      <p>No messages found<% if (filterType) { %> for this filter<% } %>.</p>
      <a href="/admin/messages/create" class="btn btn-primary">Compose first message</a>
    </div>
  <% } else { %>
    <!-- Table Wrapper -->
    <div class="table-wrapper">
      <table>
        <thead>
          <tr>
            <th>Title</th>
            <th style="text-align:center">Type</th>
            <th>Sent by</th>
            <th style="text-align:center">Recipients</th>
            <th>Date Time</th>
            <th style="text-align:center">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% messages.forEach(msg => { %>
            <tr data-date="<%= msg.createdAt.toISOString() %>">
              <td style="font-weight:500;color:var(--gray-900);max-width:285px;">
                <%= msg.title %>
              </td>
              <td style="text-align:center;">
                <% if (msg.type === 'announcement') { %>
                  <span class="badge" style="background:#DBEAFE;color:var(--primary);"> Announcement</span>
                <% } else if (msg.type === 'broadcast') { %>
                  <span class="badge" style="background:#F3E8FF;color:#7C3AED;"> Broadcast</span>
                <% } else { %>
                  <span class="badge badge-created"> Personal</span>
                <% } %>
              </td>
              <td style="color:var(--gray-600);font-size:0.875rem;"><%= msg.sender.name %></td>
              <td style="text-align:center;color:var(--gray-600);font-size:0.875rem;">
                <% if (msg.type === 'announcement') { %>
                  <span style="color:var(--gray-600);font-style:italic;">Public</span>
                <% } else { %>
                  <span style="font-weight:600;color:var(--primary);"><%= msg._count.recipients %></span>
                <% } %>
              </td>
              <td style="color:var(--gray-600);font-size:0.875rem;">
                <div class="flex flex-col gap-0.5" style="display:flex;flex-direction:column;gap:0.125rem;">
                  <span class="font-medium text-slate-800" style="font-weight:500;color:var(--gray-900);"><%= new Date(msg.createdAt).toLocaleDateString('id-ID', { day:'2-digit', month:'short', year:'numeric' }) %></span>
                  <span style="font-size:10px;color:var(--gray-600);display:inline-flex;align-items:center;gap:0.25rem;">
                    <i data-lucide="clock" style="width:12px;height:12px;opacity:0.7;"></i>
                    <%= new Date(msg.createdAt).toLocaleTimeString('id-ID', { hour: '2-digit', minute: '2-digit' }) %> WIB
                  </span>
                </div>
              </td>
              <td style="text-align:center;">
                <a href="/admin/messages/<%= msg.id %>" class="btn btn-secondary btn-sm">View</a>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>

    <!-- Client-side Filter Empty State -->
    <div id="filteredEmptyState" class="card empty-state hidden py-12 text-center bg-white rounded-3xl border border-slate-200 shadow-sm space-y-3" style="display:none;flex-direction:column;align-items:center;justify-content:center;padding:3rem;text-align:center;background:#fff;border-radius:12px;border:1px solid var(--gray-200);margin-bottom:1.5rem;">
      <h3 class="font-bold text-sm text-slate-850" style="margin-top:0;font-size:1rem;color:var(--gray-800);">Tidak ada pesan cocok</h3>
      <p class="text-xs text-slate-550 max-w-xs mx-auto" style="color:var(--gray-600);font-size:0.875rem;margin-bottom:1rem;">Sesuaikan filter pencarian atau rentang tanggal Anda untuk mencari pesan lain.</p>
      <button type="button" onclick="clearFilters()" class="btn btn-secondary btn-sm" style="font-size:0.75rem;padding:0.4rem 1rem;">Reset Filter</button>
    </div>
  <% } %>

  <div style="margin-top:2rem;">
    <a href="/admin" class="btn btn-secondary">← Back to Dashboard</a>
  </div>

  </div>
  </main>
</div>

<!-- CLIENT SIDE REAL-TIME FILTER ENGINE -->
<script>
  function applyFilters() {
    const query = document.getElementById('messageSearchInput').value.toLowerCase().trim();
    const startDateVal = document.getElementById('messageStartDate').value;
    const endDateVal = document.getElementById('messageEndDate').value;
    
    const rows = document.querySelectorAll('tbody tr');
    let visibleCount = 0;
    
    rows.forEach(row => {
      // 1. Search Query Match (Title, Sent By)
      const title = row.querySelector('td:nth-child(1)').innerText.toLowerCase();
      const type = row.querySelector('td:nth-child(2)').innerText.toLowerCase();
      const sender = row.querySelector('td:nth-child(3)').innerText.toLowerCase();
      
      const queryMatch = !query || 
                         title.includes(query) || 
                         type.includes(query) || 
                         sender.includes(query);
      
      // 2. Date Range Match
      const dateText = row.getAttribute('data-date'); // ISO String
      const rowDate = dateText ? new Date(dateText) : null;
      
      let dateMatch = true;
      if (rowDate) {
        // Zero out times for date-only comparison
        const compareDate = new Date(rowDate.getFullYear(), rowDate.getMonth(), rowDate.getDate());
        
        if (startDateVal) {
          const start = new Date(startDateVal);
          const compareStart = new Date(start.getFullYear(), start.getMonth(), start.getDate());
          if (compareDate < compareStart) dateMatch = false;
        }
        if (endDateVal) {
          const end = new Date(endDateVal);
          const compareEnd = new Date(end.getFullYear(), end.getMonth(), end.getDate());
          if (compareDate > compareEnd) dateMatch = false;
        }
      }
      
      if (queryMatch && dateMatch) {
        row.style.display = '';
        visibleCount++;
      } else {
        row.style.display = 'none';
      }
    });
    
    // Toggle Empty State
    const emptyState = document.getElementById('filteredEmptyState');
    const tableWrapper = document.querySelector('.table-wrapper');
    
    if (visibleCount === 0) {
      if (tableWrapper) tableWrapper.style.display = 'none';
      if (emptyState) {
        emptyState.style.display = 'flex';
      }
    } else {
      if (tableWrapper) tableWrapper.style.display = '';
      if (emptyState) {
        emptyState.style.display = 'none';
      }
    }
  }

  function clearFilters() {
    document.getElementById('messageSearchInput').value = '';
    document.getElementById('messageStartDate').value = '';
    document.getElementById('messageEndDate').value = '';
    applyFilters();
  }
</script>

</body>
</html>
