<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : 'Pesan & Pengumuman' %> - RT Management System</title>
  <link rel="shortcut icon" href="/images/Logo%20aplikasi%20KBA%200418.png" type="image/x-icon">
  
  <!-- Fonts -->
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  
  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            brand: {
              50: '#eff6ff', 100: '#dbeafe', 200: '#bfdbfe',
              300: '#93c5fd', 400: '#60a5fa', 500: '#3b82f6',
              600: '#2563eb', 700: '#1d4ed8', 800: '#1e40af', 900: '#1e3a8a',
            }
          },
          fontFamily: {
            sans: ['Inter', 'sans-serif'],
            display: ['Inter', 'sans-serif'],
          }
        }
      }
    }
  </script>
  
  <!-- Lucide Icons -->
  <script src="https://unpkg.com/lucide@latest"></script>
  <link rel="stylesheet" href="/css/admin.css">
  <style>
    body { background: #F8FAFC; }
    .portal-nav {
      background: #2563EB;
      padding: 0.875rem 2rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
      position: sticky;
      top: 0;
      z-index: 50;
    }
    .portal-nav a { color: rgba(255,255,255,0.9); text-decoration: none; font-size: 0.875rem; }
    .portal-nav a:hover { color: white; }
    .portal-nav .brand { font-weight: 700; color: white; font-size: 1rem; }
    .portal-content { max-width: 840px; margin: 0 auto; padding: 2rem 1rem; }
  </style>
</head>
<body>

<nav class="portal-nav">
  <a href="/portal" class="brand">RT Management</a>
  <div style="display:flex;align-items:center;gap:1.5rem;">
    <a href="/portal">Portal</a>
    <% if (typeof hasAdminAccess !== 'undefined' && hasAdminAccess) { %>
      <a href="/admin">Admin Panel</a>
    <% } %>
    <a href="/auth/logout">Logout</a>
  </div>
</nav>

<div class="portal-content">

  <!-- HEADER -->
  <div class="flex items-center justify-between mb-6 flex-wrap gap-4">
    <div>
      <h1 class="text-2xl font-bold text-slate-900">
        <%= user.language === 'en' ? 'Community Messages' : 'Pusat Informasi & Pesan' %>
      </h1>
      <p class="text-sm text-slate-500 mt-1">
        <%= user.language === 'en' ? 'Stay connected with notifications, announcements, and direct messages' : 'Pantau pengumuman resmi dan pesan masuk langsung dari pengurus RT' %>
      </p>
    </div>
    <a href="/portal" class="inline-flex items-center gap-2 text-sm font-medium text-slate-600 bg-white hover:bg-slate-50 border border-slate-200 px-4 py-2 rounded-xl transition-colors shadow-sm">
      <i data-lucide="arrow-left" class="w-4 h-4"></i>
      <span><%= user.language === 'en' ? 'Back to Portal' : 'Kembali ke Portal' %></span>
    </a>
  </div>

  <% if (error) { %>
    <div class="alert alert-error mb-6"><%= error %></div>
  <% } %>
  <% if (success) { %>
    <div class="alert alert-success mb-6"><%= success %></div>
  <% } %>

  <!-- TABS NAVIGATION -->
  <div class="flex border-b border-slate-200 mb-6 gap-2">
    <!-- Tab 1: Inbox -->
    <a href="/portal/messages?tab=inbox" 
       class="inline-flex items-center gap-2 px-5 py-3 font-semibold text-sm border-b-2 transition-colors <%= activeTab === 'inbox' ? 'border-brand-600 text-brand-600' : 'border-transparent text-slate-500 hover:text-slate-800' %>">
      <i data-lucide="inbox" class="w-4 h-4"></i>
      <span><%= user.language === 'en' ? 'Inbox' : 'Pesan Masuk' %></span>
      <% if (typeof inboxData !== 'undefined' && inboxData.totalCount > 0) { %>
        <span class="bg-slate-100 text-slate-600 text-[10px] font-bold px-2 py-0.5 rounded-full border border-slate-200">
          <%= inboxData.totalCount %>
        </span>
      <% } %>
      <% if (typeof unreadCount !== 'undefined' && unreadCount > 0) { %>
        <span class="bg-red-500 text-white text-[10px] font-bold px-2 py-0.5 rounded-full">
          <%= unreadCount %> <%= user.language === 'en' ? 'NEW' : 'BARU' %>
        </span>
      <% } %>
    </a>

    <!-- Tab 2: Announcements -->
    <a href="/portal/messages?tab=announcements" 
       class="inline-flex items-center gap-2 px-5 py-3 font-semibold text-sm border-b-2 transition-colors <%= activeTab === 'announcements' ? 'border-brand-600 text-brand-600' : 'border-transparent text-slate-500 hover:text-slate-800' %>">
      <i data-lucide="megaphone" class="w-4 h-4"></i>
      <span><%= user.language === 'en' ? 'Announcements' : 'Arsip Pengumuman' %></span>
      <% if (typeof announcementsData !== 'undefined' && announcementsData.totalCount > 0) { %>
        <span class="bg-slate-100 text-slate-600 text-[10px] font-bold px-2 py-0.5 rounded-full border border-slate-200">
          <%= announcementsData.totalCount %>
        </span>
      <% } %>
    </a>
  </div>

  <!-- TAB 1 CONTENT: INBOX -->
  <% if (activeTab === 'inbox') { %>

    <!-- Search Bar for Inbox -->
    <div class="mb-6 bg-white p-4 rounded-2xl border border-slate-200 shadow-sm">
      <form method="GET" action="/portal/messages" class="flex gap-2">
        <input type="hidden" name="tab" value="inbox">
        <div class="relative flex-1">
          <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
            <i data-lucide="search" class="w-4 h-4"></i>
          </span>
          <input type="text" name="search" value="<%= typeof search !== 'undefined' ? search : '' %>" 
                 placeholder="Cari judul, isi pesan, atau pengirim..." 
                 class="w-full pl-10 pr-4 py-2 text-sm border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent">
        </div>
        <button type="submit" class="px-4 py-2 bg-brand-600 hover:bg-brand-700 text-white text-sm font-semibold rounded-xl transition-colors">
          Cari
        </button>
        <% if (typeof search !== 'undefined' && search) { %>
          <a href="/portal/messages?tab=inbox" class="px-3 py-2 bg-slate-100 hover:bg-slate-200 text-slate-600 text-sm font-semibold rounded-xl transition-colors">
            Reset
          </a>
        <% } %>
      </form>
    </div>

    <% if (!inboxData || inboxData.messages.length === 0) { %>
      <div class="bg-white rounded-3xl border border-slate-200 p-12 text-center shadow-sm">
        <div class="w-16 h-16 bg-slate-50 rounded-full flex items-center justify-center mx-auto mb-4 text-slate-300">
          <i data-lucide="mail-open" class="w-8 h-8"></i>
        </div>
        <h3 class="text-base font-bold text-slate-800 mb-1">
          <%= user.language === 'en' ? 'No Messages Found' : 'Tidak Ada Pesan Masuk' %>
        </h3>
        <p class="text-sm text-slate-500">
          <%= typeof search !== 'undefined' && search ? 'Tidak ada pesan yang cocok dengan kata kunci pencarian Anda.' : 'Kotak masuk Anda masih kosong saat ini.' %>
        </p>
      </div>
    <% } else { %>
      <div class="space-y-3">
        <% inboxData.messages.forEach(item => { %>
          <a href="/portal/messages/<%= item.message.id %>" class="block group">
            <div class="bg-white p-5 rounded-2xl border transition-all shadow-sm hover:shadow-md <%= item.readAt ? 'border-slate-200 bg-white' : 'border-brand-300 bg-brand-50/20' %>">
              <div class="flex items-start justify-between gap-4">
                <div class="flex-1 min-w-0">
                  <div class="flex items-center gap-2 mb-1 flex-wrap">
                    <% if (!item.readAt) { %>
                      <span class="w-2 h-2 bg-brand-600 rounded-full flex-shrink-0"></span>
                    <% } %>
                    <h3 class="font-bold text-base text-slate-900 group-hover:text-brand-600 transition-colors">
                      <%= item.message.title %>
                    </h3>
                    <% if (item.message.type === 'broadcast') { %>
                      <span class="px-2 py-0.5 bg-purple-50 text-purple-700 border border-purple-200 text-[10px] font-bold rounded-full">
                        Broadcast <%= item.message.corridor ? '(' + item.message.corridor.name + ')' : '' %>
                      </span>
                    <% } else { %>
                      <span class="px-2 py-0.5 bg-emerald-50 text-emerald-700 border border-emerald-200 text-[10px] font-bold rounded-full">
                        Personal
                      </span>
                    <% } %>
                  </div>

                  <p class="text-sm text-slate-600 line-clamp-1 mb-2">
                    <%= item.message.content %>
                  </p>

                  <div class="flex items-center gap-3 text-xs text-slate-400">
                    <span>Dari: <strong class="text-slate-600"><%= item.message.sender.name %></strong></span>
                    <span>•</span>
                    <span><%= new Date(item.createdAt).toLocaleDateString('id-ID', { day:'2-digit', month:'short', year:'numeric', hour:'2-digit', minute:'2-digit' }) %></span>
                  </div>
                </div>

                <div class="flex-shrink-0">
                  <% if (!item.readAt) { %>
                    <span class="px-2 py-1 bg-brand-600 text-white text-[10px] font-bold rounded-lg shadow-sm">
                      BARU
                    </span>
                  <% } else { %>
                    <span class="text-xs text-slate-400 font-medium">Sudah dibaca</span>
                  <% } %>
                </div>
              </div>
            </div>
          </a>
        <% }); %>
      </div>

      <!-- PAGINATION FOR INBOX -->
      <% if (inboxData.totalPages > 1) { %>
        <div class="flex items-center justify-between mt-8 border-t border-slate-200 pt-6">
          <p class="text-xs text-slate-500">
            Menampilkan halaman <strong class="text-slate-700"><%= inboxData.currentPage %></strong> dari <strong class="text-slate-700"><%= inboxData.totalPages %></strong> (Total <%= inboxData.totalCount %> Pesan)
          </p>
          <div class="flex items-center gap-2">
            <% if (inboxData.currentPage > 1) { %>
              <a href="/portal/messages?tab=inbox&page=<%= inboxData.currentPage - 1 %><%= search ? '&search=' + encodeURIComponent(search) : '' %>" 
                 class="px-3.5 py-1.5 text-xs font-semibold text-slate-600 bg-white border border-slate-200 hover:bg-slate-50 rounded-xl transition-colors shadow-sm">
                ← Sebelumnya
              </a>
            <% } %>

            <% for (let p = 1; p <= inboxData.totalPages; p++) { %>
              <a href="/portal/messages?tab=inbox&page=<%= p %><%= search ? '&search=' + encodeURIComponent(search) : '' %>"
                 class="px-3 py-1.5 text-xs font-bold rounded-xl transition-colors <%= p === inboxData.currentPage ? 'bg-brand-600 text-white shadow-sm' : 'bg-white border border-slate-200 text-slate-600 hover:bg-slate-50' %>">
                <%= p %>
              </a>
            <% } %>

            <% if (inboxData.currentPage < inboxData.totalPages) { %>
              <a href="/portal/messages?tab=inbox&page=<%= inboxData.currentPage + 1 %><%= search ? '&search=' + encodeURIComponent(search) : '' %>" 
                 class="px-3.5 py-1.5 text-xs font-semibold text-slate-600 bg-white border border-slate-200 hover:bg-slate-50 rounded-xl transition-colors shadow-sm">
                Selanjutnya →
              </a>
            <% } %>
          </div>
        </div>
      <% } %>

    <% } %>
  <% } %>

  <!-- TAB 2 CONTENT: ANNOUNCEMENTS ARCHIVE -->
  <% if (activeTab === 'announcements') { %>
    
    <!-- Search Bar for Announcements -->
    <div class="mb-6 bg-white p-4 rounded-2xl border border-slate-200 shadow-sm">
      <form method="GET" action="/portal/messages" class="flex gap-2">
        <input type="hidden" name="tab" value="announcements">
        <div class="relative flex-1">
          <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
            <i data-lucide="search" class="w-4 h-4"></i>
          </span>
          <input type="text" name="search" value="<%= typeof search !== 'undefined' ? search : '' %>" 
                 placeholder="Cari judul atau isi pengumuman..." 
                 class="w-full pl-10 pr-4 py-2 text-sm border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent">
        </div>
        <button type="submit" class="px-4 py-2 bg-brand-600 hover:bg-brand-700 text-white text-sm font-semibold rounded-xl transition-colors">
          Cari
        </button>
        <% if (typeof search !== 'undefined' && search) { %>
          <a href="/portal/messages?tab=announcements" class="px-3 py-2 bg-slate-100 hover:bg-slate-200 text-slate-600 text-sm font-semibold rounded-xl transition-colors">
            Reset
          </a>
        <% } %>
      </form>
    </div>

    <% if (!announcementsData || announcementsData.announcements.length === 0) { %>
      <div class="bg-white rounded-3xl border border-slate-200 p-12 text-center shadow-sm">
        <div class="w-16 h-16 bg-slate-50 rounded-full flex items-center justify-center mx-auto mb-4 text-slate-300">
          <i data-lucide="megaphone" class="w-8 h-8"></i>
        </div>
        <h3 class="text-base font-bold text-slate-800 mb-1">
          <%= user.language === 'en' ? 'No Announcements Found' : 'Tidak Ada Pengumuman' %>
        </h3>
        <p class="text-sm text-slate-500">
          <%= user.language === 'en' ? 'There are no announcements matching your query.' : 'Belum ada pengumuman yang sesuai dengan pencarian Anda.' %>
        </p>
      </div>
    <% } else { %>
      <div class="space-y-4">
        <% announcementsData.announcements.forEach(ann => { %>
          <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm hover:border-brand-200 transition-colors">
            <div class="flex items-start justify-between gap-4 mb-2">
              <div class="flex items-center gap-2 flex-wrap">
                <h3 class="font-bold text-lg text-slate-900"><%= ann.title %></h3>
                <% if (ann.corridor) { %>
                  <span class="px-2 py-0.5 bg-blue-50 text-blue-700 border border-blue-200 text-[10px] font-bold rounded-full">
                    📍 Koridor <%= ann.corridor.name %>
                  </span>
                <% } else { %>
                  <span class="px-2 py-0.5 bg-slate-100 text-slate-600 border border-slate-200 text-[10px] font-bold rounded-full">
                    🌐 Seluruh RT
                  </span>
                <% } %>
              </div>
              <span class="text-xs text-slate-400 font-medium whitespace-nowrap hidden sm:block">
                <%= new Date(ann.createdAt).toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric' }) %>
              </span>
            </div>

            <!-- Preview truncated -->
            <p class="text-sm text-slate-600 leading-relaxed mb-3 line-clamp-2">
              <%= ann.content %>
            </p>

            <div class="mb-4">
              <button type="button" onclick="openAnnouncementModal('<%= ann.id %>')" class="inline-flex items-center gap-1.5 text-xs font-bold text-brand-600 hover:text-brand-700 transition-colors">
                <span><%= user.language === 'en' ? 'Read More' : 'Lihat Selengkapnya' %></span>
                <i data-lucide="arrow-right" class="w-3.5 h-3.5"></i>
              </button>
            </div>

            <div class="flex items-center gap-2 text-xs text-slate-400 border-t border-slate-100 pt-3">
              <i data-lucide="user" class="w-3.5 h-3.5 text-slate-400"></i>
              <span>Oleh: <strong class="text-slate-600"><%= ann.sender.name %></strong></span>
              <span class="sm:hidden ml-auto">
                <%= new Date(ann.createdAt).toLocaleDateString('id-ID', { day: 'numeric', month: 'short' }) %>
              </span>
            </div>

            <!-- Data payload for popup modal -->
            <div id="ann-data-<%= ann.id %>" style="display:none;"
                 data-title="<%= ann.title %>"
                 data-sender="<%= ann.sender.name %>"
                 data-date="<%= new Date(ann.createdAt).toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric', hour: '2-digit', minute: '2-digit' }) %>"
                 data-corridor="<%= ann.corridor ? '📍 Koridor ' + ann.corridor.name : '🌐 Seluruh RT (Global)' %>"
                 data-content="<%- encodeURIComponent(ann.content) %>"></div>
          </div>
        <% }); %>
      </div>

      <!-- PAGINATION FOR ANNOUNCEMENTS -->
      <% if (announcementsData.totalPages > 1) { %>
        <div class="flex items-center justify-between mt-8 border-t border-slate-200 pt-6">
          <p class="text-xs text-slate-500">
            Menampilkan halaman <strong class="text-slate-700"><%= announcementsData.currentPage %></strong> dari <strong class="text-slate-700"><%= announcementsData.totalPages %></strong> (Total <%= announcementsData.totalCount %> Pengumuman)
          </p>
          <div class="flex items-center gap-2">
            <% if (announcementsData.currentPage > 1) { %>
              <a href="/portal/messages?tab=announcements&page=<%= announcementsData.currentPage - 1 %><%= search ? '&search=' + encodeURIComponent(search) : '' %>" 
                 class="px-3.5 py-1.5 text-xs font-semibold text-slate-600 bg-white border border-slate-200 hover:bg-slate-50 rounded-xl transition-colors shadow-sm">
                ← Sebelumnya
              </a>
            <% } %>

            <% for (let p = 1; p <= announcementsData.totalPages; p++) { %>
              <a href="/portal/messages?tab=announcements&page=<%= p %><%= search ? '&search=' + encodeURIComponent(search) : '' %>"
                 class="px-3 py-1.5 text-xs font-bold rounded-xl transition-colors <%= p === announcementsData.currentPage ? 'bg-brand-600 text-white shadow-sm' : 'bg-white border border-slate-200 text-slate-600 hover:bg-slate-50' %>">
                <%= p %>
              </a>
            <% } %>

            <% if (announcementsData.currentPage < announcementsData.totalPages) { %>
              <a href="/portal/messages?tab=announcements&page=<%= announcementsData.currentPage + 1 %><%= search ? '&search=' + encodeURIComponent(search) : '' %>" 
                 class="px-3.5 py-1.5 text-xs font-semibold text-slate-600 bg-white border border-slate-200 hover:bg-slate-50 rounded-xl transition-colors shadow-sm">
                Selanjutnya →
              </a>
            <% } %>
          </div>
        </div>
      <% } %>

    <% } %>

  <% } %>

</div>

<!-- ANNOUNCEMENT DETAIL MODAL POPUP -->
<div id="announcementModal" class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-900/60 backdrop-blur-sm hidden transition-opacity duration-200">
  <div class="relative w-full max-w-xl bg-white rounded-3xl shadow-2xl border border-slate-100 overflow-hidden transform transition-all">
    <!-- Modal Header -->
    <div class="p-6 border-b border-slate-100 flex items-start justify-between gap-4 bg-slate-50/50">
      <div>
        <div class="flex items-center gap-2 mb-1.5 flex-wrap">
          <span class="px-2.5 py-0.5 bg-brand-50 text-brand-700 border border-brand-200 text-[10px] font-bold rounded-full uppercase tracking-wider">
            Pengumuman
          </span>
          <span id="modalAnnCorridor" class="hidden px-2.5 py-0.5 bg-blue-50 text-blue-700 border border-blue-200 text-[10px] font-bold rounded-full"></span>
        </div>
        <h3 id="modalAnnTitle" class="font-bold text-xl text-slate-900 leading-snug"></h3>
        <p class="text-xs text-slate-500 mt-1 flex items-center gap-2 flex-wrap">
          <span>Oleh: <strong id="modalAnnSender" class="text-slate-700"></strong></span>
          <span>•</span>
          <span id="modalAnnDate" class="text-slate-500"></span>
        </p>
      </div>
      <button type="button" onclick="closeAnnouncementModal()" class="w-8 h-8 rounded-full bg-white border border-slate-200 hover:bg-slate-100 flex items-center justify-center text-slate-500 hover:text-slate-800 transition-colors flex-shrink-0">
        <i data-lucide="x" class="w-4 h-4"></i>
      </button>
    </div>

    <!-- Modal Body -->
    <div class="p-6 max-h-[60vh] overflow-y-auto">
      <div id="modalAnnContent" class="text-slate-700 text-sm leading-relaxed whitespace-pre-wrap font-sans"></div>
    </div>

    <!-- Modal Footer -->
    <div class="p-4 bg-slate-50 border-t border-slate-100 flex justify-end">
      <button type="button" onclick="closeAnnouncementModal()" class="px-5 py-2 text-xs font-bold text-slate-700 bg-white border border-slate-200 hover:bg-slate-100 rounded-xl transition-colors shadow-sm">
        Tutup
      </button>
    </div>
  </div>
</div>

<script>
if (typeof lucide !== 'undefined') {
  lucide.createIcons();
}

function openAnnouncementModal(id) {
  const dataEl = document.getElementById('ann-data-' + id);
  if (!dataEl) return;

  const title = dataEl.getAttribute('data-title');
  const sender = dataEl.getAttribute('data-sender');
  const date = dataEl.getAttribute('data-date');
  const corridor = dataEl.getAttribute('data-corridor');
  const content = decodeURIComponent(dataEl.getAttribute('data-content') || '');

  document.getElementById('modalAnnTitle').textContent = title;
  document.getElementById('modalAnnSender').textContent = sender;
  document.getElementById('modalAnnDate').textContent = date;
  document.getElementById('modalAnnContent').textContent = content;

  const corridorEl = document.getElementById('modalAnnCorridor');
  if (corridor) {
    corridorEl.textContent = corridor;
    corridorEl.classList.remove('hidden');
  } else {
    corridorEl.classList.add('hidden');
  }

  const modal = document.getElementById('announcementModal');
  modal.classList.remove('hidden');
  document.body.style.overflow = 'hidden';
}

function closeAnnouncementModal() {
  const modal = document.getElementById('announcementModal');
  modal.classList.add('hidden');
  document.body.style.overflow = 'auto';
}

window.addEventListener('click', function(e) {
  const modal = document.getElementById('announcementModal');
  if (e.target === modal) {
    closeAnnouncementModal();
  }
});

window.addEventListener('keydown', function(e) {
  if (e.key === 'Escape') {
    closeAnnouncementModal();
  }
});
</script>
</body>
</html>
