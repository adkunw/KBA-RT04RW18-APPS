<!DOCTYPE html>
<html lang="id">
<head>
 <meta charset="UTF-8">
 <meta name="viewport" content="width=device-width, initial-scale=1.0">
 <title>Portal - RT Management System</title>
 
 <!-- Fonts -->
 <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
 
 <!-- Tailwind CSS -->
 <script src="https://cdn.tailwindcss.com"></script>
 <script>
 tailwind.config = {
 theme: {
 extend: {
 colors: {
 brand: {
 50: '#eff6ff', 100: '#dbeafe', 200: '#bfdbfe',
 300: '#93c5fd', 400: '#60a5fa', 500: '#3b82f6',
 600: '#2563eb', 700: '#1d4ed8', 800: '#1e40af', 900: '#1e3a8a',
 }
 },
 fontFamily: {
 sans: ['Inter', 'sans-serif'],
 display: ['Inter', 'sans-serif'],
 }
 }
 }
 }
 </script>
 
 <!-- Lucide Icons -->
 <script src="https://unpkg.com/lucide@latest"></script>

 <style>
 .glass {
 background: rgba(255, 255, 255, 0.9);
 backdrop-filter: blur(10px);
 }
 .card-hover {
 transition: all 0.2s ease;
 }
 .card-hover:hover {
 transform: translateY(-2px);
 box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.1), 0 8px 10px -6px rgba(0, 0, 0, 0.1);
 }
 </style>
</head>
<body class="min-h-screen font-sans bg-slate-50 text-slate-900 pb-20">

 <!-- Header -->
 <header class="sticky top-0 z-40 w-full glass border-b border-slate-200">
 <div class="max-w-7xl mx-auto px-4 h-16 flex items-center justify-between">
 <div class="flex items-center gap-3">
 <div class="w-10 h-10 bg-brand-600 rounded-xl flex items-center justify-center text-white shadow-lg shadow-brand-500/20">
 <span class="font-display font-bold text-lg">RT</span>
 </div>
 <span class="font-display font-bold text-xl tracking-tight hidden sm:block">RT Connect</span>
 </div>
 
 <div class="flex items-center gap-4">
 <% if (typeof hasAdminAccess !== 'undefined' && hasAdminAccess) { %>
 <a href="/admin" class="text-sm font-semibold text-brand-600 hover:text-brand-800 transition-colors hidden sm:block">Admin Panel</a>
 <% } %>
 
 <form action="/portal/settings/language" method="POST" class="m-0">
 <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
 <select name="language" onchange="this.form.submit()" class="bg-slate-100 text-slate-700 border-none rounded-lg py-1 px-2 text-sm font-medium focus:ring-2 focus:ring-brand-500 outline-none cursor-pointer">
 <option value="id" <%= user.language === 'id' ? 'selected' : '' %>> ID</option>
 <option value="en" <%= user.language === 'en' ? 'selected' : '' %>> EN</option>
 </select>
 </form>

 <a href="/portal/messages" class="p-2 text-slate-500 hover:bg-slate-100 rounded-full transition-colors relative block">
 <i data-lucide="bell" class="w-5 h-5"></i>
 <% if (typeof unreadCount !== 'undefined' && unreadCount > 0) { %>
 <span class="absolute top-1 right-1 w-2.5 h-2.5 bg-red-500 rounded-full border-2 border-white"></span>
 <% } %>
 </a>
 <div class="h-8 w-px bg-slate-200 mx-1 hidden sm:block"></div>
 
 <div class="flex items-center gap-3 pl-1">
 <div class="text-right hidden sm:block">
 <p class="text-sm font-semibold leading-none"><%= user.name %></p>
 <p class="text-xs text-slate-500 mt-1 capitalize"><%= (user.roles && user.roles[0]) ? user.roles[0].replace('_', ' ') : 'Warga' %></p>
 </div>
 <div class="w-10 h-10 rounded-full bg-brand-100 border-2 border-white shadow-sm flex items-center justify-center text-brand-700 font-bold">
 <%= user.name.charAt(0).toUpperCase() %>
 </div>
 </div>

 <a href="/auth/logout" class="ml-2 text-slate-400 hover:text-red-500 transition-colors" title="Logout">
 <i data-lucide="log-out" class="w-5 h-5"></i>
 </a>
 </div>
 </div>
 </header>

 <main class="max-w-7xl mx-auto px-4 pt-8">
 <!-- Welcome Banner -->
 <div class="relative overflow-hidden rounded-3xl bg-brand-600 p-8 sm:p-12 text-white shadow-2xl shadow-brand-500/20 mb-10 transform transition-all duration-500 ease-out translate-y-0 opacity-100">
 <div class="relative z-10 max-w-2xl">
 <h1 class="font-display text-3xl sm:text-4xl font-bold mb-4">
 <%= user.language === 'en' ? 'Welcome' : 'Selamat Datang' %>, <%= user.name %>! 
 </h1>
 <p class="text-brand-100 text-lg leading-relaxed">
 <%= user.language === 'en' ? 'Stay connected, stay informed. Make sure you are always up-to-date with the latest news and announcements from RT 04 / RW 18 Kota Baru Arjasari.' : 'Jalin silaturahmi, kawal informasi. Pastikan Anda selalu tahu kabar dan pengumuman terbaru dari RT 04 / RW 18 Kota Baru Arjasari.' %>
 </p>
 </div>
 <!-- Abstract blobs for modern feel -->
 <div class="absolute top-0 right-0 w-64 h-64 bg-white/10 rounded-full -mr-20 -mt-20 blur-3xl"></div>
 <div class="absolute bottom-0 left-0 w-32 h-32 bg-brand-400/20 rounded-full -ml-10 -mb-10 blur-2xl"></div>
 </div>

 <!-- Feature Grid - Bento Style -->
 <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 mb-12">
 <!-- Profile -->
 <a href="/portal/profile" class="block">
 <div class="card-hover p-6 bg-white rounded-3xl border border-slate-200 shadow-sm flex flex-col gap-4 h-full group">
 <div class="w-14 h-14 bg-blue-50 rounded-2xl flex items-center justify-center">
 <i data-lucide="user" class="text-blue-500 w-7 h-7"></i>
 </div>
 <div>
 <h3 class="font-bold text-lg mb-1"><%= user.language === 'en' ? 'My Profile' : 'Profil Saya' %></h3>
 <p class="text-sm text-slate-500 leading-snug"><%= user.language === 'en' ? 'View and edit information' : 'Lihat dan ubah informasi' %></p>
 </div>
 <div class="mt-auto pt-4 flex items-center text-brand-600 text-sm font-bold gap-1 cursor-pointer">
 <%= user.language === 'en' ? 'Open Details' : 'Buka Detail' %> <i data-lucide="chevron-right" class="w-4 h-4 group-hover:translate-x-1 transition-transform"></i>
 </div>
 </div>
 </a>

 <!-- Messages -->
 <a href="/portal/messages" class="block">
 <div class="card-hover p-6 bg-white rounded-3xl border border-slate-200 shadow-sm flex flex-col gap-4 h-full relative group">
 <% if (typeof unreadCount !== 'undefined' && unreadCount > 0) { %>
 <div class="absolute top-4 right-4 bg-red-500 text-white text-[10px] font-bold px-2 py-0.5 rounded-full">
 <%= unreadCount %> <%= user.language === 'en' ? 'NEW' : 'BARU' %>
 </div>
 <% } %>
 <div class="w-14 h-14 bg-purple-50 rounded-2xl flex items-center justify-center">
 <i data-lucide="message-square" class="text-purple-500 w-7 h-7"></i>
 </div>
 <div>
 <h3 class="font-bold text-lg mb-1"><%= user.language === 'en' ? 'Messages' : 'Pesan' %></h3>
 <p class="text-sm text-slate-500 leading-snug"><%= user.language === 'en' ? 'Check community messages' : 'Cek pesan terbaru dari pengurus RT' %></p>
 </div>
 <div class="mt-auto pt-4 flex items-center text-brand-600 text-sm font-bold gap-1 cursor-pointer">
 <%= user.language === 'en' ? 'Open Details' : 'Buka Detail' %> <i data-lucide="chevron-right" class="w-4 h-4 group-hover:translate-x-1 transition-transform"></i>
 </div>
 </div>
 </a>

 <!-- Documents -->
 <a href="/portal/documents" class="block">
 <div class="card-hover p-6 bg-white rounded-3xl border border-slate-200 shadow-sm flex flex-col gap-4 h-full group">
 <div class="w-14 h-14 bg-emerald-50 rounded-2xl flex items-center justify-center">
 <i data-lucide="file-text" class="text-emerald-500 w-7 h-7"></i>
 </div>
 <div>
 <h3 class="font-bold text-lg mb-1"><%= user.language === 'en' ? 'Documents' : 'Dokumen' %></h3>
 <p class="text-sm text-slate-500 leading-snug"><%= user.language === 'en' ? 'Upload & check document status' : 'Upload & cek status dokumen anda' %></p>
 </div>
 <div class="mt-auto pt-4 flex items-center text-brand-600 text-sm font-bold gap-1 cursor-pointer">
 <%= user.language === 'en' ? 'Open Details' : 'Buka Detail' %> <i data-lucide="chevron-right" class="w-4 h-4 group-hover:translate-x-1 transition-transform"></i>
 </div>
 </div>
 </a>

 <!-- Finance -->
 <a href="/portal/finance" class="block">
 <div class="card-hover p-6 bg-white rounded-3xl border border-slate-200 shadow-sm flex flex-col gap-4 h-full group">
 <div class="w-14 h-14 bg-amber-50 rounded-2xl flex items-center justify-center">
 <i data-lucide="wallet" class="text-amber-500 w-7 h-7"></i>
 </div>
 <div>
 <h3 class="font-bold text-lg mb-1"><%= user.language === 'en' ? 'Dues & Treasury' : 'Iuran & Kas' %></h3>
 <p class="text-sm text-slate-500 leading-snug"><%= user.language === 'en' ? 'Report and track dues payment' : 'Lapor dan pantau pembayaran iuran' %></p>
 </div>
 <div class="mt-auto pt-4 flex items-center text-brand-600 text-sm font-bold gap-1 cursor-pointer">
 <%= user.language === 'en' ? 'Open Details' : 'Buka Detail' %> <i data-lucide="chevron-right" class="w-4 h-4 group-hover:translate-x-1 transition-transform"></i>
 </div>
 </div>
 </a>

 <!-- Reports (Lapor RT) -->
 <a href="/portal/reports" class="block sm:col-span-2 lg:col-span-4 max-w-sm mx-auto w-full lg:max-w-none">
 <div class="card-hover p-6 bg-white rounded-3xl border border-slate-200 shadow-sm flex flex-col lg:flex-row lg:items-center gap-4 h-full group">
 <div class="w-14 h-14 bg-rose-50 rounded-2xl flex items-center justify-center flex-shrink-0">
 <i data-lucide="alert-circle" class="text-rose-500 w-7 h-7"></i>
 </div>
 <div class="flex-1">
 <h3 class="font-bold text-lg mb-1"><%= user.language === 'en' ? 'Community Report' : 'Lapor RT' %></h3>
 <p class="text-sm text-slate-500 leading-snug"><%= user.language === 'en' ? 'Submit aspirations or complaints' : 'Sampaikan aspirasi atau keluhan warga' %></p>
 </div>
 <div class="mt-auto lg:mt-0 pt-4 lg:pt-0 flex items-center text-brand-600 text-sm font-bold gap-1 cursor-pointer">
 <%= user.language === 'en' ? 'Open Details' : 'Buka Detail' %> <i data-lucide="chevron-right" class="w-4 h-4 group-hover:translate-x-1 transition-transform"></i>
 </div>
 </div>
 </a>
 </div>

 <!-- Bottom Section Split -->
 <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
 
 <!-- Announcements -->
 <div class="lg:col-span-2">
 <div class="flex items-center justify-between mb-6">
 <h2 class="font-display text-2xl font-bold flex items-center gap-2">
 <i data-lucide="bell" class="text-brand-600 w-6 h-6"></i>
 <%= user.language === 'en' ? 'Latest Announcements' : 'Pengumuman Terbaru' %>
 </h2>
 </div>
 
 <div class="space-y-4">
 <% if (typeof announcements !== 'undefined' && announcements.length > 0) { %>
 <% announcements.forEach((ann, index) => { %>
 <div class="bg-white p-6 rounded-2xl border border-slate-100 shadow-sm hover:border-brand-200 transition-colors group">
 <div class="flex items-start justify-between mb-2">
 <div class="flex items-center gap-3">
 <h4 class="font-bold text-lg group-hover:text-brand-600 transition-colors"><%= ann.title %></h4>
 <% if (index === 0) { %>
 <span class="px-2 py-0.5 bg-emerald-100 text-emerald-600 text-[10px] font-bold rounded-full">
 <%= user.language === 'en' ? 'NEW' : 'BARU' %>
 </span>
 <% } %>
 </div>
 <span class="text-xs text-slate-400 font-medium whitespace-nowrap hidden sm:block">
 <%= new Date(ann.createdAt).toLocaleDateString(user.language === 'en' ? 'en-US' : 'id-ID', { day: 'numeric', month: 'short', year: 'numeric' }) %>
 </span>
 </div>
 <p class="text-sm text-slate-600 leading-relaxed mb-4"><%= ann.content %></p>
 <div class="flex items-center gap-2 text-xs text-slate-500 border-t border-slate-50 pt-3">
 <i data-lucide="user" class="w-3 h-3"></i> <%= ann.sender.name %>
 <span class="sm:hidden ml-auto">
 <%= new Date(ann.createdAt).toLocaleDateString(user.language === 'en' ? 'en-US' : 'id-ID', { day: 'numeric', month: 'short' }) %>
 </span>
 </div>
 </div>
 <% }); %>
 <% } else { %>
 <div class="bg-white rounded-2xl border border-slate-100 p-8 text-center shadow-sm">
 <div class="w-16 h-16 bg-slate-50 rounded-full flex items-center justify-center mx-auto mb-4">
 <i data-lucide="inbox" class="w-8 h-8 text-slate-300"></i>
 </div>
 <p class="text-slate-500 font-medium">
 <%= user.language === 'en' ? 'There are no announcements right now.' : 'Belum ada pengumuman saat ini.' %>
 </p>
 </div>
 <% } %>
 </div>
 </div>

 <!-- Contact / Help -->
 <div>
 <h2 class="font-display text-2xl font-bold mb-6 flex items-center gap-2">
 <i data-lucide="settings" class="text-rose-500 w-6 h-6"></i>
 <%= user.language === 'en' ? 'Help' : 'Bantuan' %>
 </h2>
 <div class="bg-rose-50 rounded-3xl p-6 border border-rose-100">
 <h3 class="font-bold text-rose-900 mb-2">
 <%= user.language === 'en' ? 'Need Help?' : 'Butuh Bantuan?' %>
 </h3>
 <p class="text-rose-700 text-sm mb-6">
 <%= user.language === 'en' ? 'Please contact RT emergency numbers if you encounter any issues.' : 'Silahkan hubungi kontak darurat RT jika anda menemui kendala dalam penggunaan sistem.' %>
 </p>
 
 <div class="space-y-4">
 <div class="flex justify-between items-center text-sm">
 <span class="text-rose-900/60 font-medium flex items-center gap-2">
 <i data-lucide="phone" class="w-4 h-4"></i> <%= user.language === 'en' ? 'Phone' : 'Telepon' %>
 </span>
 <span class="text-rose-900 font-bold"><%= typeof settings !== 'undefined' && settings.emergency_phone ? settings.emergency_phone : '0813-2010-0407' %></span>
 </div>
 <div class="flex justify-between items-center text-sm">
 <span class="text-rose-900/60 font-medium flex items-center gap-2">
 <i data-lucide="mail" class="w-4 h-4"></i> Email
 </span>
 <span class="text-rose-900 font-bold"><%= typeof settings !== 'undefined' && settings.emergency_email ? settings.emergency_email : 'help@rtconnect.id' %></span>
 </div>
 <div class="flex justify-between items-center text-sm border-t border-rose-200/50 pt-4">
 <span class="text-rose-900/60 font-medium flex items-center gap-2">
 <i data-lucide="clock" class="w-4 h-4"></i> <%= user.language === 'en' ? 'Hours' : 'Operasional' %>
 </span>
 </div>
 <div class="text-rose-900 font-bold text-sm text-right">
 <%= typeof settings !== 'undefined' && settings.emergency_hours ? settings.emergency_hours : (user.language === 'en' ? "Mon - Fri, 08:00 - 16:00" : "Senin - Jum'at, 08:00 - 16:00") %>
 </div>
 </div>
 </div>
 </div>
 </div>
 </main>

 <!-- Initialize Lucide Icons -->
 <script>
 lucide.createIcons();
 </script>
</body>
</html>
