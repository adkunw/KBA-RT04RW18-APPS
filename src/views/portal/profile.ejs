<!DOCTYPE html>
<html lang="id">
<head>
 <meta charset="UTF-8">
 <meta name="viewport" content="width=device-width, initial-scale=1.0">
 <title>My Profile - RT Management System</title>
 <link rel="stylesheet" href="/css/admin.css">
 <style>
 body { background: var(--background); }
 .portal-nav {
 background: var(--primary);
 padding: 0.875rem 2rem;
 display: flex;
 align-items: center;
 justify-content: space-between;
 position: sticky;
 top: 0;
 z-index: 50;
 }
 .portal-nav a { color: rgba(255,255,255,0.9); text-decoration: none; font-size: 0.875rem; }
 .portal-nav a:hover { color: white; }
 .portal-nav .brand { font-weight: 700; color: white; font-size: 1rem; }
 .portal-content { max-width: 720px; margin: 0 auto; padding: 2rem 1rem; }
 </style>
</head>
<body>

<nav class="portal-nav">
 <a href="/portal" class="brand">RT Management</a>
 <div style="display:flex;align-items:center;gap:1.5rem;">
 <a href="/portal"> Portal</a>
 <% if (typeof hasAdminAccess !== 'undefined' && hasAdminAccess) { %>
 <a href="/admin"> Admin Panel</a>
 <% } %>
 <a href="/auth/logout">Logout </a>
 </div>
</nav>

<div class="portal-content">

 <div class="page-header">
 <h1> My Profile</h1>
 <a href="/portal" class="btn btn-secondary">← Back to Portal</a>
 </div>

 <% if (error) { %>
 <div class="alert alert-error"><%= error %></div>
 <% } %>
 <% if (success) { %>
 <div class="alert" style="background:#DCFCE7; border-left-color:var(--success); color:#166534;">
 <%= success %>
 </div>
 <% } %>

 <div class="card" style="margin-bottom: 2rem;">
 <h2 style="font-size:1.125rem; margin-bottom:1.5rem; color:var(--gray-900);">Edit Profile Details</h2>
 
 <form action="/portal/profile" method="POST" style="display:flex; flex-direction:column; gap:1.25rem;">
 <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
 
 <div class="form-group">
 <label for="phone">Phone Number (Login ID)</label>
 <input type="text" id="phone" value="<%= profileUser.phone %>" disabled style="background:var(--gray-100); color:var(--gray-600); cursor:not-allowed;">
 <small style="color:var(--gray-500); display:block; margin-top:0.25rem;">Contact admin if you need to change your registered phone number.</small>
 </div>

 <div class="form-group">
 <label for="name">Full Name</label>
 <input type="text" id="name" name="name" value="<%= profileUser.name %>" required>
 </div>

 <div class="form-group">
 <label for="houseNumber">Nomor Rumah</label>
 <input type="text" id="houseNumber" name="houseNumber" value="<%= profileUser.houseNumber || '' %>" placeholder="Contoh: B-12 atau No. 45" required style="width:100%; padding:0.625rem; border:1px solid var(--gray-300); border-radius:6px; font-family:inherit; font-size:0.875rem;">
 </div>

  <div style="background:#f8fafc; border:1px solid var(--gray-200); border-radius:12px; padding:1.25rem; display:flex; flex-direction:column; gap:1.25rem; margin-top: 0.5rem;">
    <h3 style="font-size:0.95rem; color:var(--gray-800); margin:0; display:flex; items-center; gap:0.5rem; font-weight: 700;">
      👤 Data Diri Warga
    </h3>
    
    <div style="display:grid; grid-template-columns: 1fr 1fr 1fr; gap:1rem;">
      <div class="form-group" style="margin-bottom:0;">
        <label for="birthDate">Tanggal Lahir Warga</label>
        <input type="date" id="birthDate" name="birthDate" value="<%= profileUser.birthDate || '' %>" style="width:100%; padding:0.625rem; border:1px solid var(--gray-300); border-radius:6px; font-family:inherit; font-size:0.875rem;">
      </div>
      <div class="form-group" style="margin-bottom:0;">
        <label for="nik">NIK Warga (Optional)</label>
        <input type="text" id="nik" name="nik" value="<%= profileUser.nik || '' %>" placeholder="16 digit NIK" style="width:100%; padding:0.625rem; border:1px solid var(--gray-300); border-radius:6px; font-family:inherit; font-size:0.875rem;">
      </div>
      <div class="form-group" style="margin-bottom:0;">
        <label for="kkNumber">Nomor KK (Optional)</label>
        <input type="text" id="kkNumber" name="kkNumber" value="<%= profileUser.kkNumber || '' %>" placeholder="16 digit No. KK" style="width:100%; padding:0.625rem; border:1px solid var(--gray-300); border-radius:6px; font-family:inherit; font-size:0.875rem;">
      </div>
    </div>
  </div>

  <div style="background:#f8fafc; border:1px solid var(--gray-200); border-radius:12px; padding:1.25rem; display:flex; flex-direction:column; gap:1.25rem; margin-top: 0.5rem;">
    <h3 style="font-size:0.95rem; color:var(--gray-800); margin:0; display:flex; items-center; gap:0.5rem; font-weight: 700;">
      👩‍❤️‍👨 Data Pasangan (Suami / Istri)
    </h3>
    
    <div class="form-group" style="margin-bottom:0;">
      <label for="spouseName">Nama Pasangan</label>
      <input type="text" id="spouseName" name="spouseName" value="<%= profileUser.spouseName || '' %>" placeholder="Nama lengkap pasangan" style="width:100%; padding:0.625rem; border:1px solid var(--gray-300); border-radius:6px; font-family:inherit; font-size:0.875rem;">
    </div>

    <div style="display:grid; grid-template-columns: 1fr 1fr; gap:1rem;">
      <div class="form-group" style="margin-bottom:0;">
        <label for="spousePhone">Nomor Telepon Pasangan</label>
        <input type="text" id="spousePhone" name="spousePhone" value="<%= profileUser.spousePhone || '' %>" placeholder="Contoh: 0812..." style="width:100%; padding:0.625rem; border:1px solid var(--gray-300); border-radius:6px; font-family:inherit; font-size:0.875rem;">
      </div>
      <div class="form-group" style="margin-bottom:0;">
        <label for="spouseBirthDate">Tanggal Lahir Pasangan</label>
        <input type="date" id="spouseBirthDate" name="spouseBirthDate" value="<%= profileUser.spouseBirthDate || '' %>" style="width:100%; padding:0.625rem; border:1px solid var(--gray-300); border-radius:6px; font-family:inherit; font-size:0.875rem;">
      </div>
    </div>

    <div class="form-group" style="margin-bottom:0;">
      <label for="spouseNik">NIK Pasangan (Optional)</label>
      <input type="text" id="spouseNik" name="spouseNik" value="<%= profileUser.spouseNik || '' %>" placeholder="16 digit NIK pasangan" style="width:100%; padding:0.625rem; border:1px solid var(--gray-300); border-radius:6px; font-family:inherit; font-size:0.875rem;">
    </div>
  </div>

  <div style="background:#f8fafc; border:1px solid var(--gray-200); border-radius:12px; padding:1.25rem; display:flex; flex-direction:column; gap:1.25rem; margin-top: 0.5rem;">
    <div style="display:flex; justify-content:space-between; align-items:center;">
      <h3 style="font-size:0.95rem; color:var(--gray-800); margin:0; display:flex; align-items:center; gap:0.5rem; font-weight: 700;">
        👶 Data Anak
      </h3>
      <button type="button" id="add-child-btn" style="background:var(--primary); color:white; border:none; padding:0.4rem 0.8rem; border-radius:6px; font-size:0.75rem; font-weight:600; cursor:pointer; display:flex; align-items:center; gap:0.25rem; transition:all 0.2s;">
        ➕ Tambah Anak
      </button>
    </div>
    
    <div id="children-container" style="display:flex; flex-direction:column; gap:1rem;">
      <!-- Dynamic children input cards will be mounted here -->
    </div>
  </div>

 <hr style="border:0; border-top:1px solid var(--gray-200); margin:0.5rem 0;">

 <h3 style="font-size:1rem; color:var(--gray-800);">Change Password</h3>
 <p style="font-size:0.875rem; color:var(--gray-600); margin-bottom:0.5rem;">Leave blank if you don't want to change your password.</p>

 <div class="form-group">
 <label for="password">New Password</label>
 <input type="password" id="password" name="password" placeholder="At least 6 characters">
 </div>

 <div class="form-actions" style="margin-top:1rem;">
 <button type="submit" class="btn btn-primary" style="width:100%;">Save Changes</button>
 </div>
 </form>
 </div>

</div>

<script>
  document.addEventListener("DOMContentLoaded", function() {
    const childrenData = <%- JSON.stringify(profileUser.children || []) %>;
    const container = document.getElementById("children-container");
    const addBtn = document.getElementById("add-child-btn");

    function createChildRow(child = { name: '', birthDate: '', nik: '' }) {
      const row = document.createElement("div");
      row.className = "child-row";
      row.style.cssText = "background:white; border:1px solid var(--gray-200); border-radius:8px; padding:1rem; position:relative; display:flex; flex-direction:column; gap:0.75rem;";
      
      row.innerHTML = `
        <button type="button" class="remove-child-btn" style="position:absolute; top:0.75rem; right:0.75rem; background:#fee2e2; color:#ef4444; border:none; padding:0.25rem 0.5rem; border-radius:4px; font-size:0.7rem; font-weight:600; cursor:pointer;">
          ✕ Hapus
        </button>
        <div class="form-group" style="margin-bottom:0;">
          <label style="font-size:0.75rem; font-weight:600; color:var(--gray-600); margin-bottom:0.25rem; display:block;">Nama Anak</label>
          <input type="text" name="childName" value="${child.name || ''}" placeholder="Nama lengkap anak" required style="width:100%; padding:0.5rem; border:1px solid var(--gray-300); border-radius:6px; font-family:inherit; font-size:0.875rem;">
        </div>
        <div style="display:grid; grid-template-columns: 1fr 1fr; gap:0.75rem;">
          <div class="form-group" style="margin-bottom:0;">
            <label style="font-size:0.75rem; font-weight:600; color:var(--gray-600); margin-bottom:0.25rem; display:block;">Tanggal Lahir</label>
            <input type="date" name="childBirthDate" value="${child.birthDate || ''}" style="width:100%; padding:0.5rem; border:1px solid var(--gray-300); border-radius:6px; font-family:inherit; font-size:0.875rem;">
          </div>
          <div class="form-group" style="margin-bottom:0;">
            <label style="font-size:0.75rem; font-weight:600; color:var(--gray-600); margin-bottom:0.25rem; display:block;">NIK (Optional)</label>
            <input type="text" name="childNik" value="${child.nik || ''}" placeholder="16 digit NIK anak" style="width:100%; padding:0.5rem; border:1px solid var(--gray-300); border-radius:6px; font-family:inherit; font-size:0.875rem;">
          </div>
        </div>
      `;

      row.querySelector(".remove-child-btn").addEventListener("click", function() {
        row.remove();
        updateEmptyState();
      });

      container.appendChild(row);
      updateEmptyState();
    }

    function updateEmptyState() {
      const existingRows = container.querySelectorAll(".child-row");
      const emptyStateId = "children-empty-state";
      let emptyState = document.getElementById(emptyStateId);
      
      if (existingRows.length === 0) {
        if (!emptyState) {
          emptyState = document.createElement("p");
          emptyState.id = emptyStateId;
          emptyState.style.cssText = "color:var(--gray-500); font-size:0.875rem; font-style:italic; margin:0; text-align:center; padding:1rem 0;";
          emptyState.textContent = "Belum ada data anak. Klik 'Tambah Anak' di atas untuk menambah.";
          container.appendChild(emptyState);
        }
      } else {
        if (emptyState) {
          emptyState.remove();
        }
      }
    }

    // Populate existing children
    if (childrenData && childrenData.length > 0) {
      childrenData.forEach(child => createChildRow(child));
    } else {
      updateEmptyState();
    }

    addBtn.addEventListener("click", function() {
      createChildRow();
    });
  });
</script>
</body>
</html>
