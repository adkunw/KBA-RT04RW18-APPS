<!DOCTYPE html>
<html lang="<%= user.language || 'id' %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= user.language === 'en' ? 'Dues & Treasury' : 'Iuran & Keuangan' %> - RT Management System</title>
  <link rel="shortcut icon" href="/images/Logo%20aplikasi%20KBA%200418.png" type="image/x-icon">
  
  <!-- Fonts -->
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  
  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            brand: {
              50: '#eff6ff', 100: '#dbeafe', 200: '#bfdbfe',
              300: '#93c5fd', 400: '#60a5fa', 500: '#3b82f6',
              600: '#2563eb', 700: '#1d4ed8', 800: '#1e40af', 900: '#1e3a8a',
            }
          },
          fontFamily: {
            sans: ['Inter', 'sans-serif'],
            display: ['Inter', 'sans-serif'],
          }
        }
      }
    }
  </script>
  
  <!-- Lucide Icons -->
  <script src="https://unpkg.com/lucide@latest"></script>

  <style>
    .glass {
      background: rgba(255, 255, 255, 0.9);
      backdrop-filter: blur(10px);
    }
    .tab-active {
      border-bottom: 2px solid var(--primary);
      color: #2563eb;
    }
  </style>
</head>
<body class="min-h-screen font-sans bg-slate-50 text-slate-900 pb-20">

  <!-- Header -->
  <header class="sticky top-0 z-40 w-full glass border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 h-16 flex items-center justify-between">
      <div class="flex items-center gap-3">
        <a href="/portal" class="flex items-center gap-3">
          <img src="/images/Logo%20aplikasi%20KBA%200418.png" alt="Logo KBA 0418" class="w-10 h-10 object-contain rounded-xl shadow-md border border-slate-200/60 bg-white">
          <span class="font-display font-bold text-xl tracking-tight hidden sm:block text-slate-800">RT Connect</span>
        </a>
      </div>
      
      <div class="flex items-center gap-4">
        <% if (hasAdminAccess) { %>
          <a href="/admin" class="inline-flex items-center gap-1.5 text-xs sm:text-sm font-semibold text-brand-600 bg-brand-50 hover:bg-brand-100 px-3 py-1.5 rounded-lg transition-colors border border-brand-100/50">
            <i data-lucide="shield-check" class="w-4 h-4 flex-shrink-0"></i>
            <span>Admin Panel</span>
          </a>
        <% } %>
        
        <form action="/portal/settings/language" method="POST" class="m-0">
          <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
          <select name="language" onchange="this.form.submit()" class="bg-slate-100 text-slate-700 border-none rounded-lg py-1 px-2 text-sm font-medium focus:ring-2 focus:ring-brand-500 outline-none cursor-pointer">
            <option value="id" <%= user.language === 'id' ? 'selected' : '' %>> ID</option>
            <option value="en" <%= user.language === 'en' ? 'selected' : '' %>> EN</option>
          </select>
        </form>

        <a href="/portal/messages" class="p-2 text-slate-500 hover:bg-slate-100 rounded-full transition-colors relative block">
          <i data-lucide="bell" class="w-5 h-5"></i>
          <% if (typeof unreadCount !== 'undefined' && unreadCount > 0) { %>
            <span class="absolute top-1 right-1 w-2.5 h-2.5 bg-red-500 rounded-full border-2 border-white"></span>
          <% } %>
        </a>
        <div class="h-8 w-px bg-slate-200 mx-1 hidden sm:block"></div>
        
        <div class="flex items-center gap-3 pl-1">
          <div class="text-right hidden sm:block">
            <p class="text-sm font-semibold leading-none"><%= user.name %></p>
            <p class="text-xs text-slate-500 mt-1 capitalize"><%= user.corridorName ? user.corridorName : 'Warga' %></p>
          </div>
          <div class="w-10 h-10 rounded-full bg-brand-100 border-2 border-white shadow-sm flex items-center justify-center text-brand-700 font-bold">
            <%= user.name.charAt(0).toUpperCase() %>
          </div>
        </div>

        <a href="/auth/logout" class="ml-2 text-slate-400 hover:text-red-500 transition-colors" title="Logout">
          <i data-lucide="log-out" class="w-5 h-5"></i>
        </a>
      </div>
    </div>
  </header>

  <main class="max-w-7xl mx-auto px-4 pt-8">
    <!-- Page Title -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-8">
      <div>
        <h1 class="text-3xl font-bold tracking-tight text-slate-900 flex items-center gap-2">
          <i data-lucide="wallet" class="text-brand-600 w-8 h-8"></i>
          <%= user.language === 'en' ? 'Transparency & Dues' : 'Transparansi Keuangan & Iuran' %>
        </h1>
        <p class="text-slate-500 mt-1">
          <%= user.language === 'en' ? 'Monitor RT treasury funds and manage your payments transparently.' : 'Pantau pengelolaan kas RT dan kelola iuran Anda dengan transparan.' %>
        </p>
      </div>
      <a href="/portal" class="inline-flex items-center gap-1.5 text-sm font-semibold text-slate-600 hover:text-slate-900 bg-white border border-slate-200 shadow-sm rounded-xl px-4 py-2 hover:bg-slate-50 transition-colors">
        <i data-lucide="arrow-left" class="w-4 h-4"></i>
        <span><%= user.language === 'en' ? 'Back to Portal' : 'Kembali ke Portal' %></span>
      </a>
    </div>

    <!-- Alert Notifications -->
    <% if (error) { %>
      <div class="bg-red-50 border-l-4 border-red-500 text-red-800 p-4 rounded-xl shadow-sm mb-6 flex items-center gap-3">
        <i data-lucide="alert-circle" class="text-red-500 w-5 h-5 flex-shrink-0"></i>
        <p class="text-sm font-medium"><%= error %></p>
      </div>
    <% } %>
    <% if (success) { %>
      <div class="bg-emerald-50 border-l-4 border-emerald-500 text-emerald-800 p-4 rounded-xl shadow-sm mb-6 flex items-center gap-3">
        <i data-lucide="check-circle" class="text-emerald-500 w-5 h-5 flex-shrink-0"></i>
        <p class="text-sm font-medium"><%= success %></p>
      </div>
    <% } %>

    <!-- Main Grid Split -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      
      <!-- LEFT: FINANCIAL TRANSPARENCY (RT & CORRIDOR) -->
      <div class="lg:col-span-2 space-y-6">
        
        <!-- Transparency Dashboard Card -->
        <div class="bg-white rounded-3xl border border-slate-200 shadow-sm overflow-hidden">
          <div class="border-b border-slate-200 bg-slate-50/50 p-4 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
            <div class="flex items-center gap-3 flex-wrap">
              <h2 class="font-bold text-lg text-slate-800 flex items-center gap-2">
                <i data-lucide="pie-chart" class="text-brand-500 w-5 h-5"></i>
                <%= user.language === 'en' ? 'Treasury Transparency Report' : 'Laporan Transparansi Kas' %>
              </h2>
              <span class="text-xs bg-brand-100 text-brand-700 font-bold px-2.5 py-1 rounded-full uppercase">
                <%= user.language === 'en' ? 'REALTIME DATA' : 'DATA REALTIME' %>
              </span>
            </div>
            <% if (canManageFinance) { %>
              <div class="w-full sm:w-auto min-w-[200px]">
                <select onchange="window.location.href='?corridorId=' + this.value" class="bg-white border border-slate-300 text-slate-700 text-sm rounded-lg focus:ring-brand-500 focus:border-brand-500 block w-full p-2.5 shadow-sm font-semibold">
                  <option value=""><%= user.language === 'en' ? '-- Select Corridor --' : '-- Pilih Koridor --' %></option>
                  <% allCorridors.forEach(c => { %>
                    <option value="<%= c.id %>" <%= viewCorridor.id === c.id ? 'selected' : '' %>>Koridor <%= c.name %></option>
                  <% }) %>
                </select>
              </div>
            <% } %>
          </div>

          <!-- Tabs Header -->
          <div class="flex border-b border-slate-200 px-4">
            <button id="tab-rt-btn" onclick="switchTransparencyTab('rt')" class="py-3 px-4 text-sm font-semibold border-b-2 border-brand-600 text-brand-600 transition-colors focus:outline-none">
              🏢 <%= user.language === 'en' ? 'RT General Fund (Kas RT)' : 'Kas Umum RT (Kas RT)' %>
            </button>
            <% if (viewCorridor.id && viewCorridor.name) { %>
              <button id="tab-corridor-btn" onclick="switchTransparencyTab('corridor')" class="py-3 px-4 text-sm font-semibold border-b-2 border-transparent text-slate-500 hover:text-slate-700 transition-colors focus:outline-none">
                📍 <%= user.language === 'en' ? `Corridor Fund (${viewCorridor.name})` : `Kas Koridor (${viewCorridor.name})` %>
              </button>
            <% } %>
          </div>

          <!-- Tabs Content Wrapper -->
          <div class="p-6">
            
            <!-- RT FINANCIAL CONTENT -->
            <div id="tab-rt-content">
              <!-- Summary Grid -->
              <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-8">
                <!-- Income -->
                <div class="bg-emerald-50/60 border border-emerald-100 rounded-2xl p-5 flex flex-col justify-between">
                  <div class="flex justify-between items-center mb-3">
                    <span class="text-xs font-semibold text-emerald-800 uppercase tracking-wider"><%= user.language === 'en' ? 'Total Income' : 'Total Pemasukan' %></span>
                    <div class="w-8 h-8 rounded-lg bg-emerald-100 text-emerald-700 flex items-center justify-center">
                      <i data-lucide="trending-up" class="w-4 h-4"></i>
                    </div>
                  </div>
                  <h3 class="text-2xl font-extrabold text-emerald-950">Rp <%= rtSummary.totalIncome.toLocaleString('id-ID') %></h3>
                </div>
                
                <!-- Expense -->
                <div class="bg-rose-50/60 border border-rose-100 rounded-2xl p-5 flex flex-col justify-between">
                  <div class="flex justify-between items-center mb-3">
                    <span class="text-xs font-semibold text-rose-800 uppercase tracking-wider"><%= user.language === 'en' ? 'Total Expense' : 'Total Pengeluaran' %></span>
                    <div class="w-8 h-8 rounded-lg bg-rose-100 text-rose-700 flex items-center justify-center">
                      <i data-lucide="trending-down" class="w-4 h-4"></i>
                    </div>
                  </div>
                  <h3 class="text-2xl font-extrabold text-rose-950">Rp <%= rtSummary.totalExpense.toLocaleString('id-ID') %></h3>
                </div>

                <!-- Balance -->
                <div class="bg-blue-50/60 border border-blue-100 rounded-2xl p-5 flex flex-col justify-between">
                  <div class="flex justify-between items-center mb-3">
                    <span class="text-xs font-semibold text-blue-800 uppercase tracking-wider"><%= user.language === 'en' ? 'Current Balance' : 'Saldo Kas RT' %></span>
                    <div class="w-8 h-8 rounded-lg bg-blue-100 text-blue-700 flex items-center justify-center">
                      <i data-lucide="wallet" class="w-4 h-4"></i>
                    </div>
                  </div>
                  <h3 class="text-2xl font-extrabold text-blue-950">Rp <%= rtSummary.balance.toLocaleString('id-ID') %></h3>
                </div>
              </div>

              <!-- RT Transactions -->
              <h3 class="font-bold text-sm text-slate-500 uppercase tracking-wider mb-4"><%= user.language === 'en' ? 'Recent General Transactions' : 'Transaksi Terakhir Kas RT' %></h3>
              
              <% if (!rtTransactions || rtTransactions.length === 0) { %>
                <div class="text-center py-8 text-slate-400 font-medium bg-slate-50 rounded-2xl border border-dashed border-slate-200">
                  <%= user.language === 'en' ? 'No recent transactions found' : 'Belum ada transaksi pada kas RT' %>
                </div>
              <% } else { %>
                <div class="space-y-3">
                  <% rtTransactions.forEach(tx => { %>
                    <div class="flex items-center justify-between p-4 bg-slate-50/80 rounded-2xl border border-slate-100 hover:bg-slate-50 transition-colors">
                      <div class="flex items-center gap-3">
                        <div class="w-10 h-10 rounded-full flex items-center justify-center <%= tx.type === 'income' ? 'bg-emerald-100 text-emerald-700' : 'bg-rose-100 text-rose-700' %>">
                          <i data-lucide="<%= tx.type === 'income' ? 'plus-circle' : 'minus-circle' %>" class="w-5 h-5"></i>
                        </div>
                        <div>
                          <p class="font-semibold text-slate-900 text-sm"><%= tx.title %></p>
                          <p class="text-xs text-slate-500 mt-0.5"><%= tx.subtitle %> &bull; <%= new Date(tx.date).toLocaleDateString('id-ID', { day:'numeric', month:'short', year:'numeric' }) %></p>
                        </div>
                      </div>
                      <div class="text-right">
                        <span class="font-bold text-sm <%= tx.type === 'income' ? 'text-emerald-600' : 'text-rose-600' %>">
                          <%= tx.type === 'income' ? '+' : '-' %> Rp <%= tx.amount.toLocaleString('id-ID') %>
                        </span>
                      </div>
                    </div>
                  <% }) %>
                </div>
              <% } %>
            </div>

            <!-- CORRIDOR FINANCIAL CONTENT -->
            <% if (user.corridorId && user.corridorName && corridorSummary) { %>
              <div id="tab-corridor-content" class="hidden">
                <!-- Summary Grid -->
                <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-8">
                  <!-- Income -->
                  <div class="bg-emerald-50/60 border border-emerald-100 rounded-2xl p-5 flex flex-col justify-between">
                    <div class="flex justify-between items-center mb-3">
                      <span class="text-xs font-semibold text-emerald-800 uppercase tracking-wider"><%= user.language === 'en' ? 'Corridor Income' : 'Pemasukan Koridor' %></span>
                      <div class="w-8 h-8 rounded-lg bg-emerald-100 text-emerald-700 flex items-center justify-center">
                        <i data-lucide="trending-up" class="w-4 h-4"></i>
                      </div>
                    </div>
                    <h3 class="text-2xl font-extrabold text-emerald-950">Rp <%= corridorSummary.totalIncome.toLocaleString('id-ID') %></h3>
                  </div>
                  
                  <!-- Expense -->
                  <div class="bg-rose-50/60 border border-rose-100 rounded-2xl p-5 flex flex-col justify-between">
                    <div class="flex justify-between items-center mb-3">
                      <span class="text-xs font-semibold text-rose-800 uppercase tracking-wider"><%= user.language === 'en' ? 'Corridor Expense' : 'Pengeluaran Koridor' %></span>
                      <div class="w-8 h-8 rounded-lg bg-rose-100 text-rose-700 flex items-center justify-center">
                        <i data-lucide="trending-down" class="w-4 h-4"></i>
                      </div>
                    </div>
                    <h3 class="text-2xl font-extrabold text-rose-950">Rp <%= corridorSummary.totalExpense.toLocaleString('id-ID') %></h3>
                  </div>

                  <!-- Balance -->
                  <div class="bg-blue-50/60 border border-blue-100 rounded-2xl p-5 flex flex-col justify-between">
                    <div class="flex justify-between items-center mb-3">
                      <span class="text-xs font-semibold text-blue-800 uppercase tracking-wider"><%= user.language === 'en' ? 'Corridor Balance' : 'Saldo Koridor' %></span>
                      <div class="w-8 h-8 rounded-lg bg-blue-100 text-blue-700 flex items-center justify-center">
                        <i data-lucide="wallet" class="w-4 h-4"></i>
                      </div>
                    </div>
                    <h3 class="text-2xl font-extrabold text-blue-950">Rp <%= corridorSummary.balance.toLocaleString('id-ID') %></h3>
                  </div>
                </div>

                <!-- Corridor Transactions -->
                <h3 class="font-bold text-sm text-slate-500 uppercase tracking-wider mb-4"><%= user.language === 'en' ? 'Recent Corridor Transactions' : 'Transaksi Terakhir Kas Koridor' %></h3>
                
                <% if (!corridorTransactions || corridorTransactions.length === 0) { %>
                  <div class="text-center py-8 text-slate-400 font-medium bg-slate-50 rounded-2xl border border-dashed border-slate-200">
                    <%= user.language === 'en' ? 'No recent transactions for this corridor' : 'Belum ada transaksi pada kas koridor ini' %>
                  </div>
                <% } else { %>
                  <div class="space-y-3">
                    <% corridorTransactions.forEach(tx => { %>
                      <div class="flex items-center justify-between p-4 bg-slate-50/80 rounded-2xl border border-slate-100 hover:bg-slate-50 transition-colors">
                        <div class="flex items-center gap-3">
                          <div class="w-10 h-10 rounded-full flex items-center justify-center <%= tx.type === 'income' ? 'bg-emerald-100 text-emerald-700' : 'bg-rose-100 text-rose-700' %>">
                            <i data-lucide="<%= tx.type === 'income' ? 'plus-circle' : 'minus-circle' %>" class="w-5 h-5"></i>
                          </div>
                          <div>
                            <p class="font-semibold text-slate-900 text-sm"><%= tx.title %></p>
                            <p class="text-xs text-slate-500 mt-0.5"><%= tx.subtitle %> &bull; <%= new Date(tx.date).toLocaleDateString('id-ID', { day:'numeric', month:'short', year:'numeric' }) %></p>
                          </div>
                        </div>
                        <div class="text-right">
                          <span class="font-bold text-sm <%= tx.type === 'income' ? 'text-emerald-600' : 'text-rose-600' %>">
                            <%= tx.type === 'income' ? '+' : '-' %> Rp <%= tx.amount.toLocaleString('id-ID') %>
                          </span>
                        </div>
                      </div>
                    <% }) %>
                  </div>
                <% } %>
              </div>
            <% } %>

          </div>
        </div>

        <!-- MY PAYMENT HISTORY CARD -->
        <div class="bg-white rounded-3xl border border-slate-200 shadow-sm p-6">
          <h2 class="font-bold text-lg text-slate-800 mb-6 flex items-center gap-2">
            <i data-lucide="history" class="text-violet-500 w-5 h-5"></i>
            <%= user.language === 'en' ? 'My Payment History' : 'Riwayat Pembayaran Saya' %>
          </h2>

          <% if (payments.length === 0) { %>
            <div class="text-center py-12 text-slate-400 bg-slate-50 rounded-2xl border border-dashed border-slate-200">
              <i data-lucide="inbox" class="w-12 h-12 text-slate-300 mx-auto mb-3"></i>
              <p class="font-medium"><%= user.language === 'en' ? 'You have no payment records yet' : 'Anda belum memiliki riwayat pembayaran iuran' %></p>
            </div>
          <% } else { %>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
              <% payments.forEach(payment => { %>
                <a href="/portal/finance/<%= payment.id %>" class="flex items-center justify-between p-5 border border-slate-200 hover:border-brand-300 hover:shadow-md hover:shadow-brand-500/5 bg-white rounded-2xl transition-all group">
                  <div class="min-w-0">
                    <p class="font-bold text-slate-800 group-hover:text-brand-600 transition-colors text-base"><%= user.language === 'en' ? 'Period' : 'Periode' %> <%= payment.period.name %></p>
                    <p class="text-xs text-slate-400 mt-1 flex items-center gap-1">
                      <i data-lucide="calendar" class="w-3.5 h-3.5"></i>
                      <%= new Date(payment.createdAt).toLocaleDateString('id-ID', { day:'numeric', month:'short', year:'numeric' }) %>
                    </p>
                  </div>
                  <div class="text-right flex-shrink-0">
                    <p class="font-extrabold text-slate-900">Rp <%= payment.totalAmount.toLocaleString('id-ID') %></p>
                    <span class="inline-flex items-center gap-1 px-2.5 py-0.5 mt-2 rounded-full text-xs font-bold <%= payment.status === 'pending' ? 'bg-amber-50 text-amber-700 border border-amber-200' : payment.status === 'approved' ? 'bg-emerald-50 text-emerald-700 border border-emerald-200' : 'bg-red-50 text-red-700 border border-red-200' %>">
                      <span class="w-1.5 h-1.5 rounded-full <%= payment.status === 'pending' ? 'bg-amber-500' : payment.status === 'approved' ? 'bg-emerald-500' : 'bg-red-500' %>"></span>
                      <%= payment.status === 'pending' ? (user.language === 'en' ? 'Pending' : 'Menunggu') : payment.status === 'approved' ? (user.language === 'en' ? 'Approved' : 'Lunas') : (user.language === 'en' ? 'Rejected' : 'Ditolak') %>
                    </span>
                  </div>
                </a>
              <% }) %>
            </div>
          <% } %>
        </div>

      </div>

      <!-- RIGHT: ACTIVE INVOICES & ACTIONS -->
      <div class="space-y-6">
        
        <!-- Active Dues Billing -->
        <div class="bg-gradient-to-br from-brand-900 to-indigo-950 text-white rounded-3xl p-6 shadow-xl border border-brand-800/40 relative overflow-hidden">
          <div class="absolute -top-10 -right-10 w-40 h-40 bg-white/5 rounded-full blur-2xl"></div>
          <div class="absolute -bottom-10 -left-10 w-32 h-32 bg-brand-500/10 rounded-full blur-xl"></div>
          
          <div class="relative z-10">
            <div class="flex items-center gap-2 mb-6">
              <div class="w-8 h-8 rounded-lg bg-white/10 flex items-center justify-center">
                <i data-lucide="receipt" class="w-4 h-4 text-brand-200"></i>
              </div>
              <h2 class="font-bold text-lg text-brand-100">
                <%= user.language === 'en' ? 'Active Bills' : 'Tagihan Aktif Saya' %>
              </h2>
            </div>

            <% if (activePeriods.length === 0) { %>
              <div class="text-center py-6">
                <i data-lucide="check-circle" class="w-12 h-12 text-emerald-400 mx-auto mb-3"></i>
                <p class="font-semibold text-brand-100 text-sm"><%= user.language === 'en' ? 'All dues fully settled!' : 'Semua iuran telah diselesaikan!' %></p>
                <p class="text-xs text-brand-300 mt-1"><%= user.language === 'en' ? 'No active invoices require action.' : 'Tidak ada tagihan aktif yang perlu dibayar.' %></p>
              </div>
            <% } else { %>
              <div class="space-y-4">
                <% activePeriods.forEach(period => { 
                  const payment = payments.find(p => p.periodId === period.id);
                  const hasPaid = payment && (payment.status === 'approved' || payment.status === 'pending');
                %>
                  <div class="bg-white/5 rounded-2xl p-4 border border-white/10 hover:bg-white/10 transition-colors">
                    <div class="flex items-start justify-between mb-3">
                      <div>
                        <p class="font-bold text-white text-base"><%= period.name %></p>
                        <p class="text-xs text-brand-300 mt-0.5"><%= user.language === 'en' ? 'Fixed Dues' : 'Iuran Bulanan Tetap' %></p>
                      </div>
                      <% if (hasPaid) { %>
                        <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-xs font-bold <%= payment.status === 'approved' ? 'bg-emerald-500/20 text-emerald-300 border border-emerald-500/30' : 'bg-amber-500/20 text-amber-300 border border-amber-500/30' %>">
                          <span class="w-1.5 h-1.5 rounded-full <%= payment.status === 'approved' ? 'bg-emerald-400' : 'bg-amber-400' %>"></span>
                          <%= payment.status === 'approved' ? (user.language === 'en' ? 'Paid' : 'Lunas') : (user.language === 'en' ? 'Verifying' : 'Verifikasi') %>
                        </span>
                      <% } else { %>
                        <span class="text-xs font-bold text-red-300 bg-red-500/20 border border-red-500/30 px-2.5 py-0.5 rounded-full flex items-center gap-1">
                          <span class="w-1.5 h-1.5 rounded-full bg-red-400 animate-ping"></span>
                          <%= user.language === 'en' ? 'Unpaid' : 'Belum Bayar' %>
                        </span>
                      <% } %>
                    </div>
                    
                    <div class="flex justify-between items-end border-t border-white/5 pt-3 mt-3">
                      <div>
                        <span class="text-[10px] uppercase font-bold text-brand-300 tracking-wider"><%= user.language === 'en' ? 'Amount Due' : 'Jumlah Tagihan' %></span>
                        <p class="font-extrabold text-white text-lg mt-0.5">Rp <%= period.fixedDuesAmount.toLocaleString('id-ID') %></p>
                      </div>
                      
                      <% if (!hasPaid) { %>
                        <a href="/portal/finance/pay?periodId=<%= period.id %>" class="inline-flex items-center gap-1 px-4 py-2 bg-brand-500 hover:bg-brand-600 text-white rounded-xl text-xs font-bold shadow-lg hover:shadow-brand-500/30 transition-all">
                          <span><%= user.language === 'en' ? 'Pay Now' : 'Bayar Sekarang' %></span>
                          <i data-lucide="chevron-right" class="w-3.5 h-3.5"></i>
                        </a>
                      <% } else if (payment.status === 'pending') { %>
                        <a href="/portal/finance/<%= payment.id %>" class="inline-flex items-center gap-1 px-4 py-2 bg-white/10 hover:bg-white/20 text-white rounded-xl text-xs font-semibold border border-white/10 transition-all">
                          <span><%= user.language === 'en' ? 'Check Status' : 'Cek Status' %></span>
                        </a>
                      <% } %>
                    </div>
                  </div>
                <% }) %>
              </div>
            <% } %>

          </div>
        </div>

        <!-- Bank Account / Transfer Guide -->
        <div class="bg-white rounded-3xl border border-slate-200 p-6 shadow-sm space-y-4">
          <h3 class="font-bold text-slate-800 text-base flex items-center gap-2 border-b border-slate-100 pb-3">
            <i data-lucide="info" class="text-brand-500 w-5 h-5"></i>
            <%= user.language === 'en' ? 'Payment Instruction' : 'Instruksi Pembayaran' %>
          </h3>
          <p class="text-xs text-slate-500 leading-relaxed">
            <%= user.language === 'en' ? 'Transfer to one of the official RT bank accounts below and upload the proof file using the payment form.' : 'Lakukan transfer ke salah satu rekening bank resmi kas RT di bawah ini, lalu kirimkan bukti transfer melalui form Lapor Bayar.' %>
          </p>

          <% 
            let paymentMethods = [];
            try {
              paymentMethods = JSON.parse(settings.payment_methods || '[]');
            } catch (e) {
              paymentMethods = [];
            }
            if (paymentMethods.length === 0) {
              // fallback to hardcoded if empty
              paymentMethods = [{
                bankName: "BANK MANDIRI",
                accountNumber: "130-00-2401040-7",
                accountHolder: "KAS RT 04 KBA"
              }];
            }
          %>

          <div class="space-y-4">
            <% paymentMethods.forEach((method, idx) => { %>
              <div class="bg-slate-50 rounded-2xl p-4 border border-slate-200 space-y-2.5 relative hover:border-slate-350 transition-colors">
                <div class="flex justify-between items-center">
                  <span class="inline-flex items-center px-2 py-0.5 rounded-md text-[10px] font-bold bg-brand-50 text-brand-700 border border-brand-100 uppercase">
                    <%= method.bankName %>
                  </span>
                </div>
                <div>
                  <span class="text-[10px] text-slate-400 font-bold uppercase tracking-wider"><%= user.language === 'en' ? 'Account Number' : 'Nomor Rekening' %></span>
                  <div class="flex items-center justify-between mt-0.5">
                    <p class="font-mono font-extrabold text-slate-900 text-sm tracking-wider"><%= method.accountNumber %></p>
                    <button onclick="navigator.clipboard.writeText('<%= method.accountNumber.replace(/[^0-9]/g, '') %>').then(() => alert('<%= user.language === 'en' ? 'Account number copied!' : 'Nomor rekening berhasil disalin!' %>'))" class="text-brand-600 hover:text-brand-700 p-1 rounded hover:bg-brand-50 transition-colors" title="Salin">
                      <i data-lucide="copy" class="w-3.5 h-3.5"></i>
                    </button>
                  </div>
                </div>
                <div>
                  <span class="text-[10px] text-slate-400 font-bold uppercase tracking-wider"><%= user.language === 'en' ? 'Account Holder' : 'Atas Nama' %></span>
                  <p class="font-semibold text-slate-800 text-xs mt-0.5"><%= method.accountHolder %></p>
                </div>
              </div>
            <% }) %>
          </div>
        </div>

      </div>

    </div>
  </main>

  <script>
    lucide.createIcons();

    // Tab Switching Logic
    function switchTransparencyTab(tab) {
      const rtBtn = document.getElementById('tab-rt-btn');
      const corridorBtn = document.getElementById('tab-corridor-btn');
      const rtContent = document.getElementById('tab-rt-content');
      const corridorContent = document.getElementById('tab-corridor-content');

      if (tab === 'rt') {
        rtBtn.className = 'py-3 px-4 text-sm font-semibold border-b-2 border-brand-600 text-brand-600 transition-colors focus:outline-none';
        if (corridorBtn) corridorBtn.className = 'py-3 px-4 text-sm font-semibold border-b-2 border-transparent text-slate-500 hover:text-slate-700 transition-colors focus:outline-none';
        
        rtContent.classList.remove('hidden');
        if (corridorContent) corridorContent.classList.add('hidden');
      } else if (tab === 'corridor') {
        rtBtn.className = 'py-3 px-4 text-sm font-semibold border-b-2 border-transparent text-slate-500 hover:text-slate-700 transition-colors focus:outline-none';
        corridorBtn.className = 'py-3 px-4 text-sm font-semibold border-b-2 border-brand-600 text-brand-600 transition-colors focus:outline-none';
        
        rtContent.classList.add('hidden');
        corridorContent.classList.remove('hidden');
      }
    }
  </script>
</body>
</html>
