<!DOCTYPE html>
<html lang="id">
<head>
 <meta charset="UTF-8">
 <meta name="viewport" content="width=device-width, initial-scale=1.0">
 <title>Iuran & Keuangan - RT Management System</title>
 <link rel="stylesheet" href="/css/admin.css">
 <style>
 body { background: var(--background); }
 .portal-nav {
 background: var(--primary);
 padding: 0.875rem 2rem;
 display: flex;
 align-items: center;
 justify-content: space-between;
 position: sticky;
 top: 0;
 z-index: 50;
 margin-bottom: 2rem;
 }
 .portal-nav a { color: rgba(255,255,255,0.9); text-decoration: none; font-size: 0.875rem; }
 .portal-nav a:hover { color: white; }
 .portal-nav .brand { font-weight: 700; color: white; font-size: 1rem; }
 .portal-content { max-width: 1024px; margin: 0 auto; padding: 0 1rem 2rem 1rem; }

 .page-header { margin-bottom: 1.5rem; }
 .page-title { font-size: 1.5rem; font-weight: 700; color: var(--gray-900); margin: 0; }
 
 .btn {
 display: inline-flex; align-items: center; gap: 0.4rem; padding: 0.625rem 1.25rem;
 border-radius: 6px; font-size: 0.875rem; font-weight: 600; text-decoration: none;
 cursor: pointer; border: none; transition: all 0.2s ease;
 }
 .btn-primary { background: var(--primary); color: white; }
 .btn-primary:hover { background: var(--primary-dark); box-shadow: 0 4px 8px rgba(37,99,235,0.25); }

 .card { background: white; border: 1px solid var(--gray-300); border-radius: 8px; padding: 1.5rem; margin-bottom: 1.5rem; }
 .card-title { font-size: 1.125rem; font-weight: 700; margin: 0 0 1rem 0; color: var(--gray-900); }

 .alert { padding: 0.875rem 1rem; border-radius: 6px; border-left: 4px solid; margin-bottom: 1.25rem; font-size: 0.875rem; }
 .alert-error { background: #fee2e2; color: #991b1b; border-left-color: #dc2626; }
 .alert-success { background: #dcfce7; color: #166534; border-left-color: #16a34a; }
 </style>
</head>
<body>

<nav class="portal-nav">
 <a href="/portal" class="brand">RT Management</a>
 <div style="display:flex;align-items:center;gap:1.5rem;">
 <a href="/portal"> Portal</a>
 <a href="/portal/finance" style="color:white;font-weight:600;"> Keuangan</a>
 <% if (hasAdminAccess) { %>
 <a href="/admin"> Admin Panel</a>
 <% } %>
 <a href="/auth/logout">Logout </a>
 </div>
</nav>

<div class="portal-content">
 <% if (error) { %><div class="alert alert-error"> <%= error %></div><% } %>
 <% if (success) { %><div class="alert alert-success"> <%= success %></div><% } %>

 <div class="page-header">
 <h1 class="page-title"> Iuran & Keuangan Saya</h1>
 </div>

 <div style="display:grid; grid-template-columns: 1fr 350px; gap: 1.5rem; align-items: start;">
 
 <!-- LEFT: RIWAYAT PEMBAYARAN -->
 <div>
 <div class="card">
 <h2 class="card-title">Riwayat Pembayaran Saya</h2>
 <% if (payments.length === 0) { %>
 <div style="text-align:center; padding:2rem; color:var(--gray-600);">
 <div style="font-size:2rem; margin-bottom:0.5rem;"></div>
 Belum ada laporan pembayaran
 </div>
 <% } else { %>
 <div style="display:flex; flex-direction:column; gap:0.75rem;">
 <% payments.forEach(payment => { %>
 <a href="/portal/finance/<%= payment.id %>" style="display:flex; align-items:center; justify-content:space-between; padding:1rem; border:1px solid var(--gray-200); border-radius:8px; text-decoration:none; color:inherit; transition:all 0.2s ease;" onmouseover="this.style.borderColor='var(--primary)'; this.style.boxShadow='0 2px 8px rgba(37,99,235,0.1)';" onmouseout="this.style.borderColor='var(--gray-200)'; this.style.boxShadow='none';">
 <div>
 <div style="font-weight:700; color:var(--gray-900); margin-bottom:0.25rem;">Periode <%= payment.period.name %></div>
 <div style="font-size:0.8125rem; color:var(--gray-600);"><%= new Date(payment.createdAt).toLocaleDateString('id-ID', { day:'numeric', month:'short', year:'numeric' }) %></div>
 </div>
 <div style="text-align:right;">
 <div style="font-weight:700; color:var(--primary-dark); margin-bottom:0.25rem;">Rp <%= payment.totalAmount.toLocaleString('id-ID') %></div>
 <span style="display:inline-block; padding:0.2rem 0.6rem; border-radius:20px; font-size:0.7rem; font-weight:700; <%= payment.status === 'pending' ? 'background:#fef3c7;color:#92400e;' : payment.status === 'approved' ? 'background:#dcfce7;color:#166534;' : 'background:#fee2e2;color:#991b1b;' %>">
 <%= payment.status === 'pending' ? ' Menunggu' : payment.status === 'approved' ? ' Lunas' : ' Ditolak' %>
 </span>
 </div>
 </a>
 <% }) %>
 </div>
 <% } %>
 </div>
 </div>

 <!-- RIGHT: PERIODE AKTIF -->
 <div>
 <div class="card" style="background:#f8fafc;">
 <h2 class="card-title">Tagihan Aktif</h2>
 <% if (activePeriods.length === 0) { %>
 <p style="color:var(--gray-600); font-size:0.875rem;">Tidak ada tagihan/periode aktif saat ini.</p>
 <% } else { %>
 <div style="display:flex; flex-direction:column; gap:1rem;">
 <% activePeriods.forEach(period => { %>
 <% 
 // Cek apakah user sudah bayar di periode ini
 const payment = payments.find(p => p.periodId === period.id);
 const hasPaid = payment && (payment.status === 'approved' || payment.status === 'pending');
 %>
 <div style="background:white; border:1px solid <%= hasPaid ? 'var(--gray-200)' : 'var(--primary-light)' %>; border-radius:8px; padding:1rem;">
 <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:0.5rem;">
 <div style="font-weight:700; color:var(--gray-900);"><%= period.name %></div>
 <% if (hasPaid) { %>
 <span style="font-size:0.75rem; font-weight:700; color:<%= payment.status === 'approved' ? '#166534' : '#92400e' %>;">
 <%= payment.status === 'approved' ? ' Lunas' : ' Diproses' %>
 </span>
 <% } else { %>
 <span style="font-size:0.75rem; font-weight:700; color:#dc2626; padding:0.2rem 0.5rem; background:#fee2e2; border-radius:4px;">Belum Bayar</span>
 <% } %>
 </div>
 <div style="font-size:0.8125rem; color:var(--gray-600); margin-bottom:1rem;">Iuran Tetap: Rp <%= period.fixedDuesAmount.toLocaleString('id-ID') %></div>
 
 <% if (!hasPaid) { %>
 <a href="/portal/finance/pay?periodId=<%= period.id %>" class="btn btn-primary" style="width:100%; justify-content:center; padding:0.5rem;"> Bayar Sekarang</a>
 <% } else if (payment.status === 'pending') { %>
 <a href="/portal/finance/<%= payment.id %>" class="btn" style="width:100%; justify-content:center; padding:0.5rem; background:var(--gray-100); color:var(--gray-700);">Lihat Status</a>
 <% } %>
 </div>
 <% }) %>
 </div>
 <% } %>
 </div>
 </div>

 </div>
</div>
</body>
</html>
