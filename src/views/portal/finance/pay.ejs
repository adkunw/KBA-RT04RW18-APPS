<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Lapor Pembayaran - RT Management System</title>
  <link rel="stylesheet" href="/css/admin.css">
  <style>
    body { background: var(--background); }
    .portal-nav {
      background: var(--primary);
      padding: 0.875rem 2rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
      position: sticky;
      top: 0;
      z-index: 50;
      margin-bottom: 2rem;
    }
    .portal-nav a { color: rgba(255,255,255,0.9); text-decoration: none; font-size: 0.875rem; }
    .portal-nav a:hover { color: white; }
    .portal-nav .brand { font-weight: 700; color: white; font-size: 1rem; }
    .portal-content { max-width: 600px; margin: 0 auto; padding: 0 1rem 2rem 1rem; }

    .card { background: white; border: 1px solid var(--gray-300); border-radius: 8px; padding: 1.5rem; }
    .card-title { font-size: 1.25rem; font-weight: 700; margin: 0 0 0.5rem 0; color: var(--gray-900); }
    .card-subtitle { font-size: 0.875rem; color: var(--gray-600); margin-bottom: 1.5rem; }

    .alert { padding: 0.875rem 1rem; border-radius: 6px; border-left: 4px solid; margin-bottom: 1.25rem; font-size: 0.875rem; }
    .alert-error { background: #fee2e2; color: #991b1b; border-left-color: #dc2626; }
    .alert-success { background: #dcfce7; color: #166534; border-left-color: #16a34a; }

    .form-group { margin-bottom: 1.25rem; }
    .form-label { display: block; font-size: 0.875rem; font-weight: 600; color: var(--gray-900); margin-bottom: 0.5rem; }
    
    .checkbox-item { display: flex; align-items: flex-start; gap: 0.75rem; padding: 1rem; border: 1px solid var(--gray-200); border-radius: 8px; margin-bottom: 0.75rem; transition: all 0.2s; }
    .checkbox-item:focus-within { border-color: var(--primary); box-shadow: 0 0 0 3px rgba(37,99,235,0.1); }
    .checkbox-item input[type="checkbox"] { width: 1.25rem; height: 1.25rem; margin-top: 0.1rem; accent-color: var(--primary); }
    
    .input-field { width: 100%; padding: 0.625rem 0.75rem; border: 1px solid var(--gray-300); border-radius: 6px; font-size: 0.875rem; font-family: inherit; margin-top: 0.5rem; }
    .input-field:focus { outline: none; border-color: var(--primary); box-shadow: 0 0 0 3px rgba(37,99,235,0.1); }
    
    .total-box { background: #eff6ff; border: 1px solid #bfdbfe; border-radius: 8px; padding: 1.25rem; text-align: center; margin: 1.5rem 0; }
    .total-label { font-size: 0.875rem; font-weight: 600; color: var(--primary-dark); margin-bottom: 0.25rem; text-transform: uppercase; letter-spacing: 0.05em; }
    .total-amount { font-size: 2rem; font-weight: 800; color: var(--primary); }

    .btn-submit { width: 100%; padding: 0.875rem; background: var(--primary); color: white; border: none; border-radius: 6px; font-size: 1rem; font-weight: 700; cursor: pointer; transition: background 0.2s; }
    .btn-submit:hover { background: var(--primary-dark); }
    .btn-back { display: inline-block; margin-bottom: 1rem; color: var(--gray-600); text-decoration: none; font-size: 0.875rem; font-weight: 500; }
    .btn-back:hover { color: var(--gray-900); }
  </style>
</head>
<body>

<nav class="portal-nav">
  <a href="/portal" class="brand">RT Management</a>
  <div style="display:flex;align-items:center;gap:1.5rem;">
    <a href="/portal">🏠 Portal</a>
    <a href="/portal/finance" style="color:white;font-weight:600;">💰 Keuangan</a>
    <a href="/auth/logout">Logout →</a>
  </div>
</nav>

<div class="portal-content">
  <a href="/portal/finance" class="btn-back">← Kembali ke Dashboard</a>

  <% if (error) { %><div class="alert alert-error">⚠️ <%= error %></div><% } %>
  
  <div class="card">
    <h1 class="card-title">Lapor Pembayaran</h1>
    <p class="card-subtitle">Periode: <strong><%= period.name %></strong></p>

    <form action="/portal/finance/pay" method="POST" enctype="multipart/form-data" id="paymentForm">
      <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
      <input type="hidden" name="periodId" value="<%= period.id %>">
      
      <!-- CHECKLIST IURAN TETAP -->
      <label class="checkbox-item">
        <input type="checkbox" name="hasFixedDues" id="hasFixedDues" checked onchange="calculateTotal()">
        <div style="flex:1;">
          <div style="font-weight:600; color:var(--gray-900);">Iuran Tetap / Wajib</div>
          <div style="font-size:0.8125rem; color:var(--gray-600);">Biaya rutin per bulan yang ditetapkan pengurus.</div>
          <div style="font-weight:700; color:var(--primary); margin-top:0.25rem;">Rp <%= period.fixedDuesAmount.toLocaleString('id-ID') %></div>
        </div>
      </label>

      <!-- CHECKLIST KAS -->
      <label class="checkbox-item" style="flex-direction:column;">
        <div style="display:flex; align-items:flex-start; gap:0.75rem; width:100%;">
          <input type="checkbox" name="hasKas" id="hasKas" onchange="toggleKasInput()">
          <div style="flex:1;">
            <div style="font-weight:600; color:var(--gray-900);">Uang Kas / Sumbangan</div>
            <div style="font-size:0.8125rem; color:var(--gray-600);">Sumbangan sukarela untuk kas RT.</div>
          </div>
        </div>
        <div id="kasInputWrapper" style="width:100%; padding-left:2rem; display:none; margin-top:0.5rem;">
          <label style="font-size:0.75rem; font-weight:600; color:var(--gray-700);">Nominal Kas (Rp)</label>
          <input type="number" name="kasAmount" id="kasAmount" class="input-field" min="0" placeholder="Contoh: 50000" oninput="calculateTotal()">
        </div>
      </label>

      <!-- OTHER / LAIN-LAIN -->
      <div class="checkbox-item" style="flex-direction:column; align-items:stretch;">
        <div style="font-weight:600; color:var(--gray-900); margin-bottom:0.25rem;">Pembayaran Lain-lain (Opsional)</div>
        <div style="font-size:0.8125rem; color:var(--gray-600); margin-bottom:0.75rem;">Isi jika ada pembayaran biaya khusus (misal: denda, acara).</div>
        
        <div style="display:grid; grid-template-columns: 1fr 1fr; gap:0.75rem;">
          <div>
            <label style="font-size:0.75rem; font-weight:600; color:var(--gray-700);">Keterangan Pembayaran</label>
            <input type="text" name="otherDescription" class="input-field" placeholder="Contoh: Denda ronda">
          </div>
          <div>
            <label style="font-size:0.75rem; font-weight:600; color:var(--gray-700);">Nominal (Rp)</label>
            <input type="number" name="otherAmount" id="otherAmount" class="input-field" min="0" placeholder="Contoh: 20000" oninput="calculateTotal()">
          </div>
        </div>
      </div>

      <!-- FILE UPLOAD -->
      <div class="form-group" style="margin-top:1.5rem;">
        <label class="form-label">Bukti Transfer (Wajib)</label>
        <p style="font-size:0.8125rem; color:var(--gray-600); margin-bottom:0.5rem;">Upload foto / struk bukti pembayaran yang valid. Format: JPG, PNG, PDF (Maks 5MB).</p>
        <div style="border:1px dashed var(--primary); background:var(--primary-light); padding:1.5rem; text-align:center; border-radius:8px;">
          <input type="file" name="proofFile" required accept="image/jpeg,image/png,application/pdf" style="max-width:100%;">
        </div>
      </div>

      <!-- TOTAL BOX -->
      <div class="total-box">
        <div class="total-label">Total Yang Harus Dibayarkan</div>
        <div class="total-amount" id="totalAmountDisplay">Rp 0</div>
      </div>

      <button type="submit" class="btn-submit">Kirim Laporan Pembayaran</button>
    </form>
  </div>
</div>

<script>
  const fixedDuesAmount = <%= period.fixedDuesAmount %>;
  
  function toggleKasInput() {
    const hasKas = document.getElementById('hasKas').checked;
    const kasWrapper = document.getElementById('kasInputWrapper');
    const kasInput = document.getElementById('kasAmount');
    
    if (hasKas) {
      kasWrapper.style.display = 'block';
      kasInput.required = true;
    } else {
      kasWrapper.style.display = 'none';
      kasInput.required = false;
      kasInput.value = '';
    }
    calculateTotal();
  }

  function calculateTotal() {
    let total = 0;
    
    if (document.getElementById('hasFixedDues').checked) {
      total += fixedDuesAmount;
    }
    
    if (document.getElementById('hasKas').checked) {
      const kasVal = parseInt(document.getElementById('kasAmount').value) || 0;
      total += kasVal;
    }
    
    const otherVal = parseInt(document.getElementById('otherAmount').value) || 0;
    total += otherVal;
    
    document.getElementById('totalAmountDisplay').innerText = 'Rp ' + total.toLocaleString('id-ID');
  }

  // Initialize total on load
  calculateTotal();
</script>

</body>
</html>
