<!DOCTYPE html>
<html lang="id">
<head>
 <meta charset="UTF-8">
 <meta name="viewport" content="width=device-width, initial-scale=1.0">
 <title>Detail Pembayaran - RT Management System</title>
 <link rel="stylesheet" href="/css/admin.css">
 <style>
 body { background: var(--background); }
 .portal-nav {
 background: var(--primary);
 padding: 0.875rem 2rem;
 display: flex;
 align-items: center;
 justify-content: space-between;
 position: sticky;
 top: 0;
 z-index: 50;
 margin-bottom: 2rem;
 }
 .portal-nav a { color: rgba(255,255,255,0.9); text-decoration: none; font-size: 0.875rem; }
 .portal-nav a:hover { color: white; }
 .portal-nav .brand { font-weight: 700; color: white; font-size: 1rem; }
 .portal-content { max-width: 800px; margin: 0 auto; padding: 0 1rem 2rem 1rem; }
 .btn-back { display: inline-block; margin-bottom: 1rem; color: var(--gray-600); text-decoration: none; font-size: 0.875rem; font-weight: 500; }
 .btn-back:hover { color: var(--gray-900); }
 </style>
</head>
<body>

<nav class="portal-nav">
 <a href="/portal" class="brand">RT Management</a>
 <div style="display:flex;align-items:center;gap:1.5rem;">
 <a href="/portal"> Portal</a>
 <a href="/portal/finance" style="color:white;font-weight:600;"> Keuangan</a>
 <% if (hasAdminAccess) { %>
 <a href="/admin"> Admin Panel</a>
 <% } %>
 <a href="/auth/logout">Logout </a>
 </div>
</nav>

<div class="portal-content">
 <a href="/portal/finance" class="btn-back">← Kembali ke Dashboard Keuangan</a>

 <div class="admin-card">
 <div style="display:flex;align-items:flex-start;justify-content:space-between;gap:1rem;margin-bottom:1.5rem;flex-wrap:wrap;">
 <div>
 <h1 style="font-size:1.5rem;font-weight:700;color:var(--gray-900);margin:0 0 0.5rem 0;">Laporan Pembayaran</h1>
 <div style="font-size:0.875rem;color:var(--gray-600);">Periode: <strong><%= payment.period.name %></strong></div>
 </div>
 <span style="display:inline-flex;align-items:center;gap:0.3rem;padding:0.35rem 1rem;border-radius:20px;font-size:0.875rem;font-weight:700;<%= payment.status === 'pending' ? 'background:#fef3c7;color:#92400e;' : payment.status === 'approved' ? 'background:#dcfce7;color:#166534;' : 'background:#fee2e2;color:#991b1b;' %>">
 <%= payment.status === 'pending' ? ' Sedang Direview' : payment.status === 'approved' ? ' Disetujui / Lunas' : ' Ditolak' %>
 </span>
 </div>

 <!-- METADATA -->
 <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:1rem;padding:1rem;background:#f8fafc;border-radius:8px;margin-bottom:1.5rem;">
 <div>
 <div style="font-size:0.75rem;font-weight:700;color:var(--gray-500);text-transform:uppercase;letter-spacing:0.05em;margin-bottom:0.25rem;">Tanggal Kirim</div>
 <div style="font-size:0.875rem;color:var(--gray-700);font-weight:600;">
 <%= new Date(payment.createdAt).toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' }) %>
 </div>
 </div>
 <div>
 <div style="font-size:0.75rem;font-weight:700;color:var(--gray-500);text-transform:uppercase;letter-spacing:0.05em;margin-bottom:0.25rem;">Total Dibayarkan</div>
 <div style="font-size:1.125rem;color:var(--primary-dark);font-weight:700;">
 Rp <%= payment.totalAmount.toLocaleString('id-ID') %>
 </div>
 </div>
 <% if (payment.reviewedAt) { %>
 <div>
 <div style="font-size:0.75rem;font-weight:700;color:var(--gray-500);text-transform:uppercase;letter-spacing:0.05em;margin-bottom:0.25rem;">Tanggal Review</div>
 <div style="font-size:0.875rem;color:var(--gray-700);">
 <%= new Date(payment.reviewedAt).toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' }) %>
 </div>
 </div>
 <% } %>
 </div>

 <% if (payment.notes) { %>
 <div style="background:#f8fafc;border:1px solid var(--gray-200);border-left:4px solid <%= payment.status === 'rejected' ? 'var(--error)' : 'var(--primary)' %>;border-radius:8px;padding:1rem 1.25rem;margin-bottom:1.5rem;">
 <div style="font-size:0.8125rem;font-weight:700;color:var(--gray-700);margin-bottom:0.375rem;"> Catatan dari Pengurus</div>
 <div style="font-size:0.875rem;color:var(--gray-600);"><%= payment.notes %></div>
 </div>
 <% } %>

 <!-- Rincian -->
 <h3 style="font-size:1rem;font-weight:700;color:var(--gray-900);margin-bottom:1rem;padding-bottom:0.5rem;border-bottom:1px solid var(--gray-200);">Rincian Pembayaran</h3>
 <table style="width:100%;border-collapse:collapse;margin-bottom:2rem;">
 <% if (payment.hasFixedDues) { %>
 <tr style="border-bottom:1px solid var(--gray-100);">
 <td style="padding:0.75rem 0;color:var(--gray-700);">Iuran Tetap / Wajib</td>
 <td style="padding:0.75rem 0;text-align:right;font-weight:600;color:var(--gray-900);">Rp <%= payment.fixedDuesAmount.toLocaleString('id-ID') %></td>
 </tr>
 <% } %>
 
 <% if (payment.hasKas) { %>
 <tr style="border-bottom:1px solid var(--gray-100);">
 <td style="padding:0.75rem 0;color:var(--gray-700);">Uang Kas RT</td>
 <td style="padding:0.75rem 0;text-align:right;font-weight:600;color:var(--gray-900);">Rp <%= payment.kasAmount.toLocaleString('id-ID') %></td>
 </tr>
 <% } %>
 
  <% if (payment.otherAmount > 0) { %>
    <% 
      let otherItems = [];
      let isJson = false;
      if (payment.otherDescription && payment.otherDescription.trim().startsWith('[')) {
        try {
          otherItems = JSON.parse(payment.otherDescription);
          isJson = Array.isArray(otherItems);
        } catch (e) {
          isJson = false;
        }
      }
    %>
    <% if (isJson) { %>
      <% otherItems.forEach(item => { %>
        <tr style="border-bottom:1px solid var(--gray-100);">
          <td style="padding:0.75rem 0;color:var(--gray-700);">Lain-lain: <%= item.desc || 'Tanpa keterangan' %></td>
          <td style="padding:0.75rem 0;text-align:right;font-weight:600;color:var(--gray-900);">Rp <%= item.amount.toLocaleString('id-ID') %></td>
        </tr>
      <% }) %>
    <% } else { %>
      <tr style="border-bottom:1px solid var(--gray-100);">
        <td style="padding:0.75rem 0;color:var(--gray-700);">
        Lain-lain: <%= payment.otherDescription || 'Tanpa keterangan' %>
        </td>
        <td style="padding:0.75rem 0;text-align:right;font-weight:600;color:var(--gray-900);">Rp <%= payment.otherAmount.toLocaleString('id-ID') %></td>
      </tr>
    <% } %>
  <% } %>
 </table>

 <h3 style="font-size:1rem;font-weight:700;color:var(--gray-900);margin-bottom:1rem;">Bukti Transfer yang Dikirim</h3>
 <div style="background:#f8fafc;border:1px solid var(--gray-200);border-radius:8px;padding:1.5rem;text-align:center;">
 <% const ext = payment.proofFilePath.split('.').pop().toLowerCase(); %>
 <% if (['jpg','jpeg','png'].includes(ext)) { %>
 <img src="<%= payment.proofFilePath %>" alt="Bukti Transfer" style="max-width:100%;max-height:400px;border-radius:6px;box-shadow:0 2px 8px rgba(0,0,0,0.1);">
 <% } else { %>
 <div style="font-size:3rem;margin-bottom:1rem;"></div>
 <p style="color:var(--gray-600);font-size:0.875rem;margin-bottom:1rem;">File PDF/Dokumen</p>
 <a href="<%= payment.proofFilePath %>" target="_blank" rel="noopener" style="display:inline-flex;align-items:center;gap:0.5rem;padding:0.75rem 1.5rem;background:var(--primary);color:white;border-radius:6px;text-decoration:none;font-weight:600;font-size:0.9375rem;">
 Buka Bukti Transfer
 </a>
 <% } %>
 </div>
 </div>
</div>

</body>
</html>
