<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Dokumen Saya - RT Management System</title>
  <link rel="stylesheet" href="/css/admin.css">
  <style>
    body { background: var(--background); }
    .portal-nav {
      background: var(--primary);
      padding: 0.875rem 2rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
      position: sticky;
      top: 0;
      z-index: 50;
      margin-bottom: 2rem;
    }
    .portal-nav a { color: rgba(255,255,255,0.9); text-decoration: none; font-size: 0.875rem; }
    .portal-nav a:hover { color: white; }
    .portal-nav .brand { font-weight: 700; color: white; font-size: 1rem; }
    .portal-content { max-width: 1024px; margin: 0 auto; padding: 0 1rem 2rem 1rem; }

    .page-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 1.5rem;
    }
    .page-title {
      font-size: 1.5rem;
      font-weight: 700;
      color: var(--gray-900);
      margin: 0;
    }
    .btn {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      padding: 0.625rem 1.25rem;
      border-radius: 6px;
      font-size: 0.875rem;
      font-weight: 600;
      text-decoration: none;
      cursor: pointer;
      border: none;
      transition: all 0.2s ease;
    }
    .btn-primary { background: var(--primary); color: white; }
    .btn-primary:hover { background: var(--primary-dark); box-shadow: 0 4px 8px rgba(37,99,235,0.25); }

    .status-badge {
      display: inline-flex;
      align-items: center;
      gap: 0.3rem;
      padding: 0.25rem 0.75rem;
      border-radius: 20px;
      font-size: 0.75rem;
      font-weight: 600;
      text-transform: capitalize;
    }
    .status-pending { background: #fef3c7; color: #92400e; }
    .status-approved { background: #dcfce7; color: #166534; }
    .status-rejected { background: #fee2e2; color: #991b1b; }

    .doc-type-badge {
      display: inline-block;
      padding: 0.2rem 0.6rem;
      border-radius: 4px;
      font-size: 0.75rem;
      font-weight: 500;
      background: var(--primary-light);
      color: var(--primary-dark);
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }

    .documents-grid {
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
    }
    .document-card {
      background: white;
      border: 1px solid var(--gray-300);
      border-radius: 8px;
      padding: 1.25rem 1.5rem;
      display: flex;
      align-items: center;
      gap: 1.25rem;
      text-decoration: none;
      color: inherit;
      transition: all 0.2s ease;
    }
    .document-card:hover {
      border-color: var(--primary);
      box-shadow: 0 4px 12px rgba(37,99,235,0.1);
      transform: translateY(-1px);
    }
    .doc-icon {
      width: 44px;
      height: 44px;
      border-radius: 10px;
      background: var(--primary-light);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.25rem;
      flex-shrink: 0;
    }
    .doc-info { flex: 1; min-width: 0; }
    .doc-title {
      font-size: 0.9375rem;
      font-weight: 600;
      color: var(--gray-900);
      margin: 0 0 0.25rem 0;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .doc-meta {
      font-size: 0.8125rem;
      color: var(--gray-600);
      display: flex;
      align-items: center;
      gap: 0.75rem;
      flex-wrap: wrap;
    }
    .empty-state {
      background: white;
      border: 2px dashed var(--gray-300);
      border-radius: 12px;
      padding: 3rem;
      text-align: center;
    }
    .empty-icon { font-size: 3rem; margin-bottom: 1rem; }
    .empty-title { font-size: 1.125rem; font-weight: 600; color: var(--gray-900); margin-bottom: 0.5rem; }
    .empty-desc { color: var(--gray-600); font-size: 0.875rem; margin-bottom: 1.5rem; }

    .alert {
      padding: 0.875rem 1rem;
      border-radius: 6px;
      border-left: 4px solid;
      margin-bottom: 1.25rem;
      font-size: 0.875rem;
    }
    .alert-error { background: #fee2e2; color: #991b1b; border-left-color: #dc2626; }
    .alert-success { background: #dcfce7; color: #166534; border-left-color: #16a34a; }

    .admin-link-bar {
      background: #eff6ff;
      border: 1px solid #bfdbfe;
      border-radius: 8px;
      padding: 0.875rem 1.25rem;
      display: flex;
      align-items: center;
      gap: 0.75rem;
      margin-bottom: 1.5rem;
      font-size: 0.875rem;
      color: var(--primary-dark);
    }
    
    .filter-bar {
      background: white;
      border: 1px solid var(--gray-200);
      border-radius: 10px;
      padding: 1rem 1.25rem;
      margin-bottom: 1.25rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      flex-wrap: wrap;
    }
    .filter-options {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      flex-wrap: wrap;
    }
    .filter-label { font-size: 0.875rem; font-weight: 600; color: var(--gray-700); }
    .filter-btn {
      padding: 0.3rem 0.875rem;
      border-radius: 20px;
      font-size: 0.8125rem;
      font-weight: 600;
      text-decoration: none;
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      background: var(--gray-100);
      color: var(--gray-700);
      transition: all 0.2s ease;
    }
    .filter-btn:hover { background: var(--gray-200); }
    .filter-btn.active-all { background: var(--primary); color: white; }
    .filter-btn.active-approved { background: #dcfce7; color: #166534; }
    .filter-btn.active-pending { background: #fef3c7; color: #92400e; }
    .filter-btn.active-rejected { background: #fee2e2; color: #991b1b; }
    
    .badge-count {
      display: inline-block;
      min-width: 18px;
      height: 18px;
      line-height: 18px;
      border-radius: 9px;
      text-align: center;
      font-size: 0.65rem;
      font-weight: 700;
      background: rgba(0,0,0,0.1);
      color: inherit;
    }
  </style>
</head>
<body>

<nav class="portal-nav">
  <a href="/portal" class="brand">RT Management</a>
  <div style="display:flex;align-items:center;gap:1.5rem;">
    <a href="/portal">Portal</a>
    <a href="/portal/documents" style="color:white;font-weight:600;">Dokumen</a>
    <% if (typeof hasAdminAccess !== 'undefined' && hasAdminAccess) { %>
      <a href="/admin">Admin Panel</a>
    <% } %>
    <a href="/auth/logout">Logout</a>
  </div>
</nav>

<div class="portal-content">
  <% if (error) { %><div class="alert alert-error"> <%= error %></div><% } %>
  <% if (success) { %><div class="alert alert-success"> <%= success %></div><% } %>

  <% if (typeof canManageDocs !== 'undefined' && canManageDocs) { %>
    <div class="admin-link-bar">
      Anda memiliki akses verifikasi dokumen.
      <a href="/admin/documents" style="font-weight:700;margin-left:0.5rem;">Lihat semua dokumen di Admin Panel</a>
    </div>
  <% } %>

  <div class="page-header">
    <h1 class="page-title">Dokumen Saya</h1>
    <a href="/portal/documents/upload" class="btn btn-primary">
      Upload Dokumen
    </a>
  </div>

  <div class="filter-bar">
    <div class="filter-options">
      <span class="filter-label">Filter Status:</span>
      <a href="/portal/documents?status=approved" class="filter-btn <%= filterStatus === 'approved' ? 'active-approved' : '' %>">
        Disetujui <span class="badge-count"><%= stats.approved %></span>
      </a>
      <a href="/portal/documents?status=pending" class="filter-btn <%= filterStatus === 'pending' ? 'active-pending' : '' %>">
        Menunggu <span class="badge-count"><%= stats.pending %></span>
      </a>
      <a href="/portal/documents?status=rejected" class="filter-btn <%= filterStatus === 'rejected' ? 'active-rejected' : '' %>">
        Ditolak <span class="badge-count"><%= stats.rejected %></span>
      </a>
      <a href="/portal/documents?status=all" class="filter-btn <%= filterStatus === 'all' ? 'active-all' : '' %>">
        Semua <span class="badge-count"><%= stats.total %></span>
      </a>
    </div>

    <!-- Search Box for Portal Documents -->
    <div style="position:relative; width: 280px; max-width:100%;">
      <span style="position:absolute; left:12px; top:50%; transform:translateY(-50%); color:#94a3b8; display:flex; align-items:center;">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
      </span>
      <input type="text" id="portalDocSearch" oninput="applyPortalDocSearch()" placeholder="Cari judul atau jenis dokumen..." style="padding: 0.5rem 1rem 0.5rem 2.3rem; border: 1px solid var(--gray-300); border-radius: 8px; font-size: 0.875rem; width: 100%; outline: none; transition: all 0.2s;" onfocus="this.style.borderColor='var(--primary)'" onblur="this.style.borderColor='var(--gray-300)'">
    </div>
  </div>

  <% if (documents.length === 0) { %>
    <div class="empty-state">
      <div class="empty-icon">📂</div>
      <div class="empty-title">Belum ada dokumen</div>
      <div class="empty-desc">
        <%= filterStatus === 'all' ? 'Upload dokumen identitas Anda seperti KTP, Kartu Keluarga, atau dokumen RT lainnya.' : 'Tidak ada dokumen yang sesuai dengan filter ini.' %>
      </div>
      <a href="/portal/documents/upload" class="btn btn-primary">Upload Dokumen Pertama</a>
    </div>
  <% } else { %>
    <div class="documents-grid" id="documentsGridContainer">
      <% documents.forEach(doc => { %>
        <a href="/portal/documents/<%= doc.id %>" class="document-card" 
           data-title="<%= doc.title.toLowerCase() %>" 
           data-type="<%= doc.type.toLowerCase().replace('_', ' ') %>">
          <div class="doc-icon">
            📄
          </div>
          <div class="doc-info">
            <div class="doc-title"><%= doc.title %></div>
            <div class="doc-meta">
              <span class="doc-type-badge"><%= doc.type.replace('_', ' ') %></span>
              <span class="status-badge status-<%= doc.status %>">
                <%= doc.status === 'pending' ? 'Menunggu' : doc.status === 'approved' ? 'Disetujui' : 'Ditolak' %>
              </span>
              <span><%= new Date(doc.createdAt).toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric' }) %></span>
            </div>
          </div>
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="#9ca3af" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
        </a>
      <% }) %>
    </div>
  <% } %>
</div>

<script>
  function applyPortalDocSearch() {
    const query = document.getElementById('portalDocSearch').value.toLowerCase().trim();
    const cards = document.querySelectorAll('.document-card');
    let visibleCount = 0;
    
    cards.forEach(card => {
      const title = card.getAttribute('data-title') || '';
      const type = card.getAttribute('data-type') || '';
      
      const isMatch = !query || title.includes(query) || type.includes(query);
      
      if (isMatch) {
        card.style.setProperty('display', 'flex', 'important');
        visibleCount++;
      } else {
        card.style.setProperty('display', 'none', 'important');
      }
    });
    
    let searchEmpty = document.getElementById('portalSearchEmpty');
    const gridContainer = document.getElementById('documentsGridContainer');
    
    if (visibleCount === 0) {
      if (gridContainer) gridContainer.style.display = 'none';
      if (!searchEmpty) {
        searchEmpty = document.createElement('div');
        searchEmpty.id = 'portalSearchEmpty';
        searchEmpty.className = 'empty-state';
        searchEmpty.innerHTML = `
          <div class="empty-icon">🔍</div>
          <div class="empty-title">Hasil tidak ditemukan</div>
          <div class="empty-desc">Tidak ada dokumen Anda yang cocok dengan pencarian "${query}".</div>
        `;
        document.querySelector('.portal-content').appendChild(searchEmpty);
      } else {
        searchEmpty.style.display = '';
        searchEmpty.querySelector('.empty-desc').textContent = `Tidak ada dokumen Anda yang cocok dengan pencarian "${query}".`;
      }
    } else {
      if (gridContainer) gridContainer.style.display = 'flex';
      if (searchEmpty) searchEmpty.style.display = 'none';
    }
  }
</script>

</body>
</html>
