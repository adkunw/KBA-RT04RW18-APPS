// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Users table - main user data
model User {
  id        String     @id @default(cuid())
  name      String
  phone     String?    @unique
  password  String?
  status    UserStatus @default(created)
  language  String     @default("id")
  lastLogin DateTime?
  houseNumber   String?
  familyDetails String?
  
  birthDate       String?
  nik             String?
  kkNumber        String?
  spouseName      String?
  spousePhone     String?
  spouseBirthDate String?
  spouseNik       String?
  children        Json?
  
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  // Relations
  roles              UserRole[]
  activationTokens   ActivationToken[]
  sentMessages       Message[]
  receivedMessages   MessageRecipient[]
  uploadedDocuments  Document[]         @relation("DocumentUploader")
  reviewedDocuments  Document[]         @relation("DocumentReviewer")
  uploadedPayments   PaymentReport[]    @relation("PaymentUploader")
  reviewedPayments   PaymentReport[]    @relation("PaymentReviewer")
  expensesCreated    FinanceExpense[]   @relation("ExpenseCreator")
  incomesCreated     FinanceIncome[]    @relation("IncomeCreator")

  reports            Report[]
  reportReplies      ReportReply[]

  @@map("users")
}

// User Status Enum
enum UserStatus {
  created
  active
  inactive
  blocked
}

// Roles table - role definitions
model Role {
  id   String @id @default(cuid())
  name String @unique

  // Relations
  users       UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

// Permissions table - permission definitions
model Permission {
  id   String @id @default(cuid())
  name String @unique

  // Relations
  roles RolePermission[]

  @@map("permissions")
}

// User-Role junction table (many-to-many)
model UserRole {
  userId String
  roleId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

// Role-Permission junction table (many-to-many)
model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

// Activation Tokens for user account activation
model ActivationToken {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique
  expiredAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("activation_tokens")
}

// Message type enum
enum MessageType {
  personal      // sent to specific user(s)
  broadcast     // sent to all active warga
  announcement  // public announcement shown in portal home
}

// Messages table
model Message {
  id        String      @id @default(cuid())
  senderId  String
  title     String
  content   String
  type      MessageType @default(personal)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  sender     User               @relation(fields: [senderId], references: [id])
  recipients MessageRecipient[]

  @@map("messages")
}

// Message recipients (for personal & broadcast types)
model MessageRecipient {
  id        String    @id @default(cuid())
  messageId String
  userId    String
  readAt    DateTime?
  createdAt DateTime  @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@map("message_recipients")
}

// Document type enum
enum DocumentType {
  ktp
  kk
  surat_keterangan
  other
}

// Document status enum
enum DocumentStatus {
  pending
  approved
  rejected
}

// Documents table - warga document management
model Document {
  id         String         @id @default(cuid())
  userId     String
  reviewedBy String?
  title      String
  type       DocumentType   @default(other)
  fileName   String
  filePath   String
  status     DocumentStatus @default(pending)
  notes      String?
  reviewedAt DateTime?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  uploader User  @relation("DocumentUploader", fields: [userId], references: [id], onDelete: Cascade)
  reviewer User? @relation("DocumentReviewer", fields: [reviewedBy], references: [id])

  @@map("documents")
}

// ==========================================
// KEUANGAN (FINANCE) MODELS
// ==========================================

model FinancePeriod {
  id              String   @id @default(cuid())
  name            String   // e.g., "Januari 2024"
  month           Int
  year            Int
  fixedDuesAmount Int      // Nominal Iuran Tetap untuk periode ini
  isActive        Boolean  @default(true) // Whether residents can still pay
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  payments        PaymentReport[]
}

model PaymentReport {
  id               String   @id @default(cuid())
  userId           String
  periodId         String
  
  // Rincian Pembayaran
  hasFixedDues     Boolean  @default(false)
  fixedDuesAmount  Int      @default(0)
  
  hasKas           Boolean  @default(false)
  kasAmount        Int      @default(0)
  
  otherDescription String?  // Info untuk pembayaran apa
  otherAmount      Int      @default(0)
  
  totalAmount      Int      // Kalkulasi total
  proofFilePath    String   // Path ke file gambar bukti transfer
  
  status           PaymentStatus @default(pending)
  notes            String?  // Catatan persetujuan / penolakan
  
  reviewedBy       String?
  reviewedAt       DateTime?
  
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user             User          @relation("PaymentUploader", fields: [userId], references: [id])
  reviewer         User?         @relation("PaymentReviewer", fields: [reviewedBy], references: [id])
  period           FinancePeriod @relation(fields: [periodId], references: [id])
}

enum PaymentStatus {
  pending
  approved
  rejected
}

// ==========================================
// LAPOR RT (FORUM) MODELS
// ==========================================

enum ReportStatus {
  open
  in_progress
  resolved
  closed
}

model Report {
  id        String       @id @default(cuid())
  authorId  String
  title     String
  content   String
  mediaPath String?
  status    ReportStatus @default(open)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  author    User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  replies   ReportReply[]

  @@map("reports")
}

model ReportReply {
  id        String   @id @default(cuid())
  reportId  String
  authorId  String
  content   String
  mediaPath String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  report Report @relation(fields: [reportId], references: [id], onDelete: Cascade)
  author User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@map("report_replies")
}

// ==========================================
// SYSTEM SETTINGS MODELS
// ==========================================

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt

  @@map("settings")
}

model FinanceExpense {
  id            String   @id @default(cuid())
  amount        Int      // Nominal Pengeluaran
  description   String   // Rincian / Deskripsi Pengeluaran
  category      String   // Kategori Pengeluaran
  recipient     String   // Penerima dana pengeluaran
  date          DateTime // Tanggal pengeluaran
  proofFilePath String?  // Bukti transaksi pengeluaran (foto/PDF/video)
  createdById   String   // ID pembuat data
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  createdBy     User     @relation("ExpenseCreator", fields: [createdById], references: [id])

  @@map("finance_expenses")
}

model FinanceIncome {
  id            String   @id @default(cuid())
  amount        Int      // Nominal Pemasukan
  description   String   // Rincian / Deskripsi Pemasukan
  category      String   // Kategori Pemasukan (cth: Donasi, Hibah, Kas Mandiri)
  source        String   // Sumber dana pemasukan
  date          DateTime // Tanggal pemasukan
  proofFilePath String?  // Bukti transaksi pemasukan (foto/PDF/video)
  createdById   String   // ID pembuat data
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  createdBy     User     @relation("IncomeCreator", fields: [createdById], references: [id])

  @@map("finance_incomes")
}

model Session {
  sid    String   @id @db.VarChar
  sess   Json
  expire DateTime @db.Timestamp(6)

  @@map("session")
}
